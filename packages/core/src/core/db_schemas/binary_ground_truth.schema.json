{
  "$jsonSchema": {
    "bsonType": "object",
    "required": [
      "subject_unique_id",
      "scraped_text_file_version_id",
      "classification_type",
      "chunk_bounds",
      "chunk_text",
      "metadata",
      "extraction_stats",
      "corrections"
    ],
    "additionalProperties": false,
    "properties": {
      "_id": {
        "bsonType": "objectId"
      },
      "created_at": {
        "bsonType": "date"
      },
      "updated_at": {
        "bsonType": "date"
      },
      "subject_unique_id": {
        "bsonType": "string"
      },
      "scraped_text_file_version_id": {
        "bsonType": "string"
      },
      "classification_type": {
        "enum": [
          "is_manufacturer",
          "is_product_manufacturer",
          "is_contract_manufacturer"
        ],
        "bsonType": "string"
      },
      "chunk_bounds": {
        "bsonType": "string"
      },
      "chunk_text": {
        "bsonType": "string"
      },
      "metadata": {
        "bsonType": "object",
        "required": [
          "created_at",
          "chunk_strat",
          "ontology_version_id",
          "single_stage"
        ],
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "bsonType": "date"
          },
          "chunk_strat": {
            "bsonType": "object",
            "required": ["overlap", "max_chunks", "max_tokens_per_chunk"],
            "additionalProperties": false,
            "properties": {
              "overlap": {
                "bsonType": "double"
              },
              "max_chunks": {
                "bsonType": "int"
              },
              "max_tokens_per_chunk": {
                "bsonType": "int"
              }
            }
          },
          "ontology_version_id": {
            "bsonType": "string"
          },
          "single_stage": {
            "bsonType": "object",
            "required": [
              "llm_model",
              "model_params",
              "prompt_name",
              "prompt_version_id",
              "created_at"
            ],
            "additionalProperties": false,
            "properties": {
              "llm_model": {
                "bsonType": "object",
                "required": ["name", "max_context_tokens"],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "bsonType": "string"
                  },
                  "max_context_tokens": {
                    "bsonType": "int"
                  }
                }
              },
              "model_params": {
                "bsonType": "object",
                "required": [
                  "max_completion_tokens",
                  "response_format",
                  "temperature",
                  "top_p",
                  "presence_penalty",
                  "frequency_penalty"
                ],
                "additionalProperties": false,
                "properties": {
                  "reasoning_effort": {
                    "enum": ["low", "medium", "high", null],
                    "bsonType": ["string", "null"]
                  },
                  "logit_bias": {
                    "bsonType": ["object", "null"],
                    "additionalProperties": {
                      "bsonType": "int"
                    }
                  },
                  "user": {
                    "bsonType": ["string", "null"]
                  },
                  "tools": {
                    "bsonType": ["array", "null"],
                    "items": {
                      "bsonType": "object"
                    }
                  },
                  "tool_choice": {
                    "anyOf": [
                      {
                        "bsonType": "string"
                      },
                      {
                        "bsonType": "object"
                      },
                      {
                        "bsonType": "null"
                      }
                    ]
                  },
                  "parallel_tool_calls": {
                    "bsonType": ["bool", "null"]
                  },
                  "logprobs": {
                    "bsonType": ["bool", "null"]
                  },
                  "top_logprobs": {
                    "bsonType": ["int", "null"]
                  },
                  "max_completion_tokens": {
                    "bsonType": "int"
                  },
                  "stop": {
                    "anyOf": [
                      {
                        "bsonType": "string"
                      },
                      {
                        "bsonType": "array",
                        "items": {
                          "bsonType": "string"
                        }
                      },
                      {
                        "bsonType": "null"
                      }
                    ]
                  },
                  "n": {
                    "bsonType": ["int", "null"]
                  },
                  "response_format": {
                    "bsonType": "object"
                  },
                  "temperature": {
                    "bsonType": "double"
                  },
                  "top_p": {
                    "bsonType": "double"
                  },
                  "presence_penalty": {
                    "bsonType": "double"
                  },
                  "frequency_penalty": {
                    "bsonType": "double"
                  },
                  "seed": {
                    "bsonType": ["int", "null"]
                  }
                }
              },
              "prompt_name": {
                "bsonType": "string"
              },
              "prompt_version_id": {
                "bsonType": "string"
              },
              "created_at": {
                "bsonType": "date"
              }
            }
          }
        }
      },
      "extraction_stats": {
        "bsonType": "object",
        "required": ["result"],
        "additionalProperties": false,
        "properties": {
          "result": {
            "bsonType": "object",
            "required": ["answer", "reason", "confidence"],
            "additionalProperties": false,
            "properties": {
              "answer": {
                "bsonType": "bool"
              },
              "reason": {
                "bsonType": "string"
              },
              "confidence": {
                "bsonType": "int"
              }
            }
          }
        }
      },
      "corrections": {
        "bsonType": "array",
        "items": {
          "bsonType": "object",
          "required": ["created_at", "human_decision"],
          "additionalProperties": false,
          "properties": {
            "created_at": {
              "bsonType": "date"
            },
            "human_decision": {
              "bsonType": "object",
              "required": ["answer", "reason", "author_email", "source"],
              "additionalProperties": false,
              "properties": {
                "answer": {
                  "bsonType": "bool"
                },
                "reason": {
                  "bsonType": "string"
                },
                "author_email": {
                  "bsonType": "string"
                },
                "source": {
                  "enum": ["user_form", "api_survey"],
                  "bsonType": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
