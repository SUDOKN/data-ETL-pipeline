    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://asu.edu/semantics/SUDOKN/A2LAAccreditation -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/A2LAAccreditation">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/LaboratoryAccreditation"/>
        <rdfs:label>A2LA Accreditation</rdfs:label>
        <skos:altLabel>A2LA Accredited</skos:altLabel>
        <skos:definition>An accreditation issued by the American Association for Laboratory
            Accreditation (A2LA) confirming that an organization has demonstrated technical
            competence to perform specified testing, calibration, inspection, certification,
            validation, or related conformity assessment activities in accordance with applicable
            accreditation requirements and standards.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ABSProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ABSProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermoplasticProcessingCapability"/>
        <rdfs:label>ABS</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process
            acrylonitrile butadiene styrene, which is a tough, impact-resistant thermoplastic used
            in housings, prototypes, automotive parts, and consumer products.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AICS336999 -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AICS336999">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/NAICS336"/>
        <rdfs:label xml:lang="en">NAICS 336999</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AS9000Certificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AS9000Certificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AerospaceQualityCertificate"/>
        <rdfs:label>AS 9000</rdfs:label>
        <skos:definition>A quality certificate confirming that an organization has demonstrated
            conformance to AS9000 quality management requirements applicable to the aerospace
            industry.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AS9003Certificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AS9003Certificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AerospaceQualityCertificate"/>
        <rdfs:label xml:lang="en">AS 9003</rdfs:label>
        <skos:definition>A quality certificate confirming that an organization has demonstrated
            conformance to AS9003 quality system requirements for inspection and test activities.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AS9100Certificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AS9100Certificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AerospaceQualityCertificate"/>
        <rdfs:label xml:lang="en">AS 9100</rdfs:label>
        <skos:definition>A quality certificate confirming that an organization has demonstrated
            conformance to the AS9100 quality management system standard for the aerospace industry.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AS9102Certificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AS9102Certificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AerospaceQualityCertificate"/>
        <rdfs:label xml:lang="en">AS 9102</rdfs:label>
        <skos:altLabel>First Article Inspection Certificate</skos:altLabel>
        <skos:definition>A certificate confirming conformance to AS9102 requirements for aerospace
            first article inspection processes and documentation.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AS9120Certificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AS9120Certificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AerospaceQualityCertificate"/>
        <rdfs:label>AS 9120</rdfs:label>
        <skos:definition>A quality certificate confirming that an organization has demonstrated
            conformance to AS9120 quality management requirements for aerospace distributors.</skos:definition>
        <iof-av:directSource>https://as9120store.com/aerospace-standards-explained/what-is-as9120/</iof-av:directSource>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ASMEBPECertificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ASMEBPECertificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ASMEManufacturingCertificate"/>
        <rdfs:label>ASME BPE</rdfs:label>
        <skos:altLabel>ASME Bioprocessing Equipment Certificate</skos:altLabel>
        <skos:definition>an ASME Certificate for organizations that manufacture or install equipment
            and piping systems in accordance with the ASME Bioprocessing Equipment (BPE) Standard.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ASMEManufacturingCertificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ASMEManufacturingCertificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ManufacturingCertificate"/>
        <rdfs:label xml:lang="en">ASME</rdfs:label>
        <skos:definition>A manufacturing certificate issued by ASME confirming that an organization
            has demonstrated conformance to applicable ASME codes, standards, and certification
            requirements and is authorized to perform specified manufacturing, fabrication,
            assembly, installation, repair, or inspection activities related to engineered products,
            systems, or components.</skos:definition>
        <iof-av:directSource xml:lang="en">https://www.asme.org/certification-accreditation</iof-av:directSource>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ASMENuclearCertificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ASMENuclearCertificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ASMEManufacturingCertificate"/>
        <rdfs:label>ASME Nuclear</rdfs:label>
        <skos:definition>a certification verifying that a manufacturer designs, fabricates, and
            installs nuclear facility components and materials in strict compliance with the ASME
            Boiler and Pressure Vessel Code (BPVC) Section III</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ASMEPPStampCertificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ASMEPPStampCertificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ASMEManufacturingCertificate"/>
        <rdfs:label>ASME PP Stamp</rdfs:label>
        <skos:definition>a certification for companies that weld, fit, manufacture, and install
            piping systems and components attached to power boilers and pressure vessels</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ASMERTP1Certificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ASMERTP1Certificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ASMEManufacturingCertificate"/>
        <rdfs:label>ASME RTP1</rdfs:label>
        <skos:definition>A manufacturing certificate issued by ASME confirming that an organization
            has demonstrated conformance to RTP-1 requirements for reinforced thermoset plastic
            corrosion-resistant equipment.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ASMESStampCertificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ASMESStampCertificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ASMEManufacturingCertificate"/>
        <rdfs:label>ASME S Stamp</rdfs:label>
        <skos:altLabel>ASME Power Boiler Certificate</skos:altLabel>
        <skos:altLabel>ASME Section I Certificate</skos:altLabel>
        <skos:definition>A manufacturing certificate issued by ASME confirming that an organization
            has demonstrated conformance to applicable ASME requirements for the design,
            fabrication, assembly, inspection, and testing of power boilers and is authorized to
            apply the ASME S Certification Mark to qualifying boilers manufactured in accordance
            with the ASME Boiler and Pressure Vessel Code, Section I.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ASMEUStampCertificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ASMEUStampCertificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ASMEManufacturingCertificate"/>
        <rdfs:label>ASME U Stamp</rdfs:label>
        <skos:definition>a certification verifying that a manufacturer designs, fabricates,
            inspects, and tests unfired pressure vessels according to the stringent safety
            guidelines of Section VIII, Division 1 of the ASME Boiler and Pressure Vessel Code
            (BPVC)</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AWSWelderCertificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AWSWelderCertificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ProfessionalCertificate"/>
        <rdfs:label>AWS Welder</rdfs:label>
        <skos:definition>A confirmation that a person has demonstrated specified welding knowledge,
            skills, competencies, and qualifications in accordance with requirements established by
            the American Welding Society (AWS), typically through examination, performance testing,
            assessment, or certification activities related to welding processes, procedures, and
            practices.</skos:definition>
        <iof-av:explanatoryNote>An AWS Welder Certificate (American Welding Society) falls under the
            category of professional certification in the field of welding. It certifies that a
            welder has demonstrated the necessary skills and knowledge to perform specific welding
            tasks according to industry standards.</iof-av:explanatoryNote>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AbrasiveCleaningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AbrasiveCleaningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SurfacePreparationCapability"/>
        <rdfs:label>Abrasive Cleaning</rdfs:label>
        <skos:definition>A process where contaminants are removed from a surface using abrasive
            materials under high pressure, without damaging the underlying structure.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AbrasiveFinishingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AbrasiveFinishingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SurfaceFinishingCapability"/>
        <rdfs:label>Abrasive Finishing</rdfs:label>
        <skos:definition>A process that removes material from a workpiece surface using abrasive
            particles to enhance surface finish, dimensional accuracy, and mechanical properties.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AbrassiveMachiningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AbrassiveMachiningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MachiningCapability"/>
        <rdfs:label>Abrasive Machining</rdfs:label>
        <skos:definition>A process where material is removed from a workpiece by a multitude of
            small abrasive particles, typically through grinding, honing, or lapping.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/Accreditation -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/Accreditation">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ConformityAttestation"/>
        <rdfs:label>Accreditation</rdfs:label>
        <skos:definition>A conformity attestation confirming that an organization has demonstrated
            competence, capability, or authorization to perform specified evaluation, testing,
            inspection, certification, manufacturing, or service activities according to established
            requirements</skos:definition>
        <iof-av:explanatoryNote>Accreditation answers the question: &quot;Is this organization
            competent and authorized to perform a specified function?&quot;</iof-av:explanatoryNote>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AcetalProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AcetalProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermoplasticProcessingCapability"/>
        <rdfs:label>Acetal</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process acetal,
            which is an engineering thermoplastic valued for low friction, dimensional stability,
            fatigue resistance, and use in precision mechanical components.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AcetronProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AcetronProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermoplasticProcessingCapability"/>
        <rdfs:label>Acetron</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process Acetron,
            which is an acetal-based engineering plastic used for machinable parts requiring
            dimensional stability, low friction, and wear resistance.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AcrylicProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AcrylicProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermoplasticProcessingCapability"/>
        <rdfs:label>Acrylic</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process acrylic,
            which is a transparent thermoplastic valued for optical clarity, weather resistance,
            stiffness, and use as a lightweight glass substitute.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AdditiveManufacturingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AdditiveManufacturingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ManufacturingProcessCapability"/>
        <rdfs:label>Additive Manufacturing</rdfs:label>
        <skos:altLabel>3D Printing</skos:altLabel>
        <skos:definition>The process that creates three-dimensional objects by building them layer
            by layer from a digital model.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AdhesiveBondingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AdhesiveBondingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/JoiningCapability"/>
        <rdfs:label>Adhesive Bonding</rdfs:label>
        <skos:definition>A process that involves joining two surfaces together using a filler
            material, typically a polymer, to create a strong, durable bond.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AdvancedPackagingIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AdvancedPackagingIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SemiconductorIndustry"/>
        <rdfs:label>Advanced Packaging</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving equipment, materials, substrates, interconnects, and services used
            in heterogeneous integration, chiplet integration, and advanced semiconductor packaging,
            and are intended to realize similar or related primary business functions according to
            their organizational objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AerospaceAccreditation -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AerospaceAccreditation">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Accreditation"/>
        <rdfs:label>Aerospace Accreditation</rdfs:label>
        <skos:definition>An accreditation confirming that an organization has demonstrated
            competence and conformance to requirements applicable to aerospace products, services,
            or manufacturing processes.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AerospaceIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AerospaceIndustry">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/supplychain/SupplyChain/Industry"/>
        <rdfs:label>Aerospace</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving the design, manufacturing, integration, operation, maintenance,
            distribution, or support of products, systems, equipment, or services associated with
            civil aviation, commercial aerospace, defense aerospace, or space exploration, and are
            intended to realize similar or related primary business functions according to their
            organizational objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AerospaceQualityCertificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AerospaceQualityCertificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/QualityCertificate"/>
        <rdfs:label xml:lang="en">Aerospace Quality</rdfs:label>
        <skos:definition>A confirmation that an organization has demonstrated compliance with
            specified quality standards, requirements, or best practices applicable to the aerospace
            industry, typically through auditing, assessment, certification, or external review
            activities related to aerospace products, processes, or services.</skos:definition>
        <iof-av:directSource>https://www.nqa.com/en-us/certification/standards/as-standards</iof-av:directSource>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AgeHardeningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AgeHardeningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThroughHardeningCapability"/>
        <rdfs:label>Age Quench Hardening</rdfs:label>
        <skos:definition>A process where materials are heated, aged, and then rapidly cooled to
            increase hardness, strength, and resistance to wear and tear.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AggregateProductionIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AggregateProductionIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MiningIndustry"/>
        <rdfs:label>Aggregate Production</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving equipment, systems, components, and services used to produce crushed
            stone, sand, gravel, and other construction aggregates, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AgriculturalEquipmentIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AgriculturalEquipmentIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AgricultureIndustry"/>
        <rdfs:label>Agricultural Equipment</rdfs:label>
        <skos:altLabel>Farm Equipment</skos:altLabel>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving machinery, implements, attachments, automation systems, and support
            products used in agricultural operations, and are intended to realize similar or related
            primary business functions according to their organizational objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AgricultureIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AgricultureIndustry">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/supplychain/SupplyChain/Industry"/>
        <rdfs:label>Agriculture</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving the design, manufacturing, integration, operation, maintenance,
            distribution, or support of products, systems, equipment, or services associated with
            agricultural production and food system support, and are intended to realize similar or
            related primary business functions according to their organizational objectives and
            plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AirQuenchHardeningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AirQuenchHardeningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThroughHardeningCapability"/>
        <rdfs:label>Air Quench Hardening</rdfs:label>
        <skos:definition>A process where heated metal parts are rapidly cooled in a controlled air
            environment to increase hardness and mechanical strength.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AlkalineOxideConversionCoatingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AlkalineOxideConversionCoatingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ChemicalConversionCoatingCapability"/>
        <rdfs:label>Alkaline Oxide Conversion Coating</rdfs:label>
        <skos:definition>A process where metal surfaces are treated with alkaline chemical solutions
            to form a protective, corrosion-resistant oxide conversion coating.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AlloyProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AlloyProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MetalProcessingCapability"/>
        <rdfs:label>Alloy</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process alloy
            materials, which are metallic materials composed of two or more elements and engineered
            to achieve specific mechanical, thermal, corrosion, or processing properties.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AlloySteelProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AlloySteelProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SteelProcessingCapability"/>
        <rdfs:label>Alloy Steel</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process alloy steel,
            which is steel containing alloying elements such as chromium, nickel, molybdenum, or
            vanadium to improve strength, toughness, hardness, or corrosion resistance.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AluminaProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AluminaProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/OxideCeramicProcessingCapability"/>
        <rdfs:label>Alumina</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process alumina,
            which is aluminum oxide ceramic valued for hardness, electrical insulation, wear
            resistance, chemical stability, and high-temperature performance.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AluminosilicateGlassProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AluminosilicateGlassProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/GlassProcessingCapability"/>
        <rdfs:label>Aluminosilicate Glass</rdfs:label>
        <skos:altLabel>Aluminum Silicate Glass</skos:altLabel>
        <skos:definition>The capability of a manufacturing system or machine to process
            aluminosilicate glass, which is a glass containing aluminum oxide and silica and is
            valued for strength, thermal resistance, and chemical durability.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AluminumAlloyProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AluminumAlloyProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Non-FerrousAlloyProcessingCapability"/>
        <rdfs:label>Aluminum Alloy</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process aluminum
            alloys, which are lightweight non-ferrous alloys valued for strength-to-weight ratio,
            corrosion resistance, formability, and thermal or electrical conductivity.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AluminumProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AluminumProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Non-FerrousMetalProcessingCapability"/>
        <rdfs:label xml:lang="en">Aluminum</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process aluminum,
            which is a lightweight, corrosion-resistant non-ferrous metal valued for formability,
            machinability, conductivity, and high strength-to-weight ratio when alloyed.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AnnealingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AnnealingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/HeatTreatingCapability"/>
        <rdfs:label>Annealing</rdfs:label>
        <skos:altLabel>In-Process Annealing</skos:altLabel>
        <skos:altLabel>Intermediate Annealing</skos:altLabel>
        <skos:altLabel>Subcritical Annealing</skos:altLabel>
        <skos:definition>A process where a material, typically metal or glass, is heated and then
            cooled slowly to reduce hardness and increase ductility.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AnodizingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AnodizingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ChemicalCoatingCapability"/>
        <rdfs:label>Anodizing</rdfs:label>
        <skos:altLabel>Anodization</skos:altLabel>
        <skos:definition>A process where a protective oxide layer is electrochemically built on the
            surface of certain metals, primarily aluminum, to increase corrosion resistance.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ApparelIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ApparelIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/TextilesAndApparelIndustry"/>
        <rdfs:label>Apparel</rdfs:label>
        <skos:altLabel>Clothing</skos:altLabel>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving clothing, garments, accessories, materials, components, and
            manufacturing services used in wearable consumer products, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AtomicHydrogenWeldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AtomicHydrogenWeldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/GasWeldingCapability"/>
        <owl:disjointWith rdf:resource="http://asu.edu/semantics/SUDOKN/CombustibleGasWeldingCapability"/>
        <rdfs:label>Atomic Hydrogen Welding</rdfs:label>
        <skos:definition>A process where atomic hydrogen is used to generate high temperatures,
            facilitating the fusion of metals in a controlled environment.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AustemperingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AustemperingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThroughHardeningCapability"/>
        <rdfs:label>Austempering</rdfs:label>
        <skos:definition>A process where steel or iron alloys are heat-treated at a constant
            temperature to improve hardness, strength, and toughness.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AutoclaveProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AutoclaveProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CompositeManufacturingCapability"/>
        <rdfs:label>Autoclave Processing</rdfs:label>
        <skos:definition>A composite manufacturing process where a composite layup is cured under
            controlled heat and pressure inside an autoclave.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AutomatedFiberPlacementCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AutomatedFiberPlacementCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CompositeManufacturingCapability"/>
        <rdfs:label>Automated Fiber Placement</rdfs:label>
        <skos:altLabel>AFP</skos:altLabel>
        <skos:definition>A composite manufacturing process where automated equipment places narrow
            fiber tows along controlled paths to build a composite laminate.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AutomatedTapeLayingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AutomatedTapeLayingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CompositeManufacturingCapability"/>
        <rdfs:label>Automated Tape Laying</rdfs:label>
        <skos:altLabel>ATL</skos:altLabel>
        <skos:definition>A composite manufacturing process where automated equipment lays wide
            prepreg tape onto a tool surface to form a composite laminate.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AutomationEquipmentIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AutomationEquipmentIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/IndustrialMachineryAndEquipmentIndustry"/>
        <rdfs:label>Automation Equipment</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving robots, controls, sensors, actuators, machines, and systems used to
            automate industrial or manufacturing operations, and are intended to realize similar or
            related primary business functions according to their organizational objectives and
            plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AutomotiveComponentsIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AutomotiveComponentsIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AutomotiveIndustry"/>
        <rdfs:label>Automotive Components</rdfs:label>
        <skos:altLabel>Auto Parts</skos:altLabel>
        <skos:altLabel>Vehicle Components</skos:altLabel>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving parts, assemblies, materials, systems, and support products supplied
            to vehicle manufacturers and automotive aftermarket organizations, and are intended to
            realize similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AutomotiveIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AutomotiveIndustry">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/supplychain/SupplyChain/Industry"/>
        <rdfs:label>Automotive</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving the design, manufacturing, integration, operation, maintenance,
            distribution, or support of products, systems, equipment, or services associated with
            transportation products and mobility systems, and are intended to realize similar or
            related primary business functions according to their organizational objectives and
            plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/AutonomousVehiclesIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/AutonomousVehiclesIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AutomotiveIndustry"/>
        <rdfs:label>Autonomous Vehicles</rdfs:label>
        <skos:altLabel>Self-Driving Vehicles</skos:altLabel>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving vehicles, sensors, computing systems, controls, and support products
            used to enable automated or driverless transportation, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/BABACertificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/BABACertificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RegulatoryComplianceCertificate"/>
        <rdfs:label xml:lang="en">BABA</rdfs:label>
        <skos:altLabel>Build America Buy America</skos:altLabel>
        <skos:definition>A confirmation that a product, material, or project has satisfied applicable Build America, Buy America (BABA) requirements, typically demonstrating that  specified manufactured products, construction materials, or iron and steel components were produced in the United States in accordance with federal infrastructure funding requirements.</skos:definition>
        <iof-av:directSource xml:lang="en">https://www.rd.usda.gov/build-america-buy-america</iof-av:directSource>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/BabbitProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/BabbitProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/BearingAlloyProcessingCapability"/>
        <rdfs:label>Babbit</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process Babbitt
            metal, which is a soft bearing alloy commonly based on tin or lead and used for
            low-friction bearing surfaces.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/BabbittingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/BabbittingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CoatingCapability"/>
        <rdfs:label>Babbitting</rdfs:label>
        <skos:definition>A process where a layer of Babbitt metal is applied to bearing surfaces to
            reduce friction and wear, enhancing performance and longevity.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/BakeryProductsIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/BakeryProductsIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FoodAndBeverageIndustry"/>
        <rdfs:label>Bakery Products</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving equipment, materials, packaging, systems, and services used to
            produce, process, package, or distribute baked goods, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/BarDrawingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/BarDrawingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/DrawingCapability"/>
        <rdfs:label>Bar Drawing</rdfs:label>
        <skos:definition>A process where a metal bar is drawn through a die, reducing its diameter
            and increasing its length while improving surface finish and dimensional accuracy.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/BarrelFinishingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/BarrelFinishingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/TumblingCapability"/>
        <rdfs:label>Barrel Finishing</rdfs:label>
        <skos:definition>A process where parts are smoothed or polished by tumbling in a barrel with
            abrasive materials, enhancing their surface finish and geometry.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/BeadBlastingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/BeadBlastingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AbrasiveCleaningCapability"/>
        <rdfs:label>Bead Blasting</rdfs:label>
        <skos:definition>A process where small glass, ceramic, or steel beads are propelled at high
            velocity to clean or finish a surface.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/BearingAlloyProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/BearingAlloyProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Non-FerrousAlloyProcessingCapability"/>
        <rdfs:label>Bearing Alloy</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process bearing
            alloys, which are low-friction, wear-resistant alloys used in bearing surfaces and
            sliding contact applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/BeltSandingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/BeltSandingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SurfacePreparationCapability"/>
        <rdfs:label>Belt Sanding</rdfs:label>
        <skos:altLabel>Sanding</skos:altLabel>
        <skos:definition>A process where abrasive belts are used to remove material from surfaces,
            improving finish and achieving precise dimensions.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/BendingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/BendingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SheetMetalProcessingProcessingCapability"/>
        <rdfs:label>Bending</rdfs:label>
        <skos:definition>A process where a machine applies force to a workpiece, causing it to
            deform along an axis, creating an angle in the material.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/BerylliumProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/BerylliumProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Non-FerrousMetalProcessingCapability"/>
        <rdfs:label>Beryllium</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process beryllium,
            which is a lightweight, stiff non-ferrous metal used in aerospace, electronics, and
            nuclear applications and requiring specialized handling due to toxicity concerns.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/BevellingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/BevellingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SawingCapability"/>
        <rdfs:label>Bevelling</rdfs:label>
        <skos:definition>A process where edges of a material are cut at an angle to create a sloped
            surface, enhancing joint strength and aesthetic appeal.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/BeverageProductionIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/BeverageProductionIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FoodAndBeverageIndustry"/>
        <rdfs:label>Beverage Production</rdfs:label>
        <skos:altLabel>Beverage</skos:altLabel>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving equipment, materials, packaging, systems, and services used to
            produce, process, fill, package, or distribute beverage products, and are intended to
            realize similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/BiopharmaceuticalsIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/BiopharmaceuticalsIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PharmaceuticalsAndBiotechnologyIndustry"/>
        <rdfs:label>Biopharmaceuticals</rdfs:label>
        <skos:altLabel>Biologics</skos:altLabel>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving equipment, systems, materials, and services used to develop,
            manufacture, process, or package biologically derived pharmaceutical products, and are
            intended to realize similar or related primary business functions according to their
            organizational objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/BiotechnologyIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/BiotechnologyIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PharmaceuticalsAndBiotechnologyIndustry"/>
        <rdfs:label>Biotechnology</rdfs:label>
        <skos:altLabel>Biotech</skos:altLabel>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving equipment, systems, materials, and services used in biological
            research, bioprocessing, bioengineering, or biotechnology product development, and are
            intended to realize similar or related primary business functions according to their
            organizational objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/BlackOxideCoatingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/BlackOxideCoatingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CoatingCapability"/>
        <rdfs:label>Black Oxide Coating</rdfs:label>
        <skos:altLabel>Black Oxide</skos:altLabel>
        <skos:altLabel>Blackening</skos:altLabel>
        <skos:altLabel>Blacking</skos:altLabel>
        <skos:definition>A process where iron-based materials are treated with a hot alkaline
            solution to form a magnetite layer, enhancing corrosion resistance and reducing light
            reflection.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/BlankingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/BlankingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/StampingCapability"/>
        <rdfs:label>Blanking</rdfs:label>
        <skos:definition>A process where a punch and die cut flat material into precise,
            predetermined shapes, typically used for high-volume production of metal parts.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/BlowMoldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/BlowMoldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MoldingCapability"/>
        <rdfs:label>Blow Molding</rdfs:label>
        <skos:definition>A process where a heated plastic tube is inflated into a mold to form
            hollow parts, such as bottles or containers.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/BlueTempSteelProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/BlueTempSteelProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SteelProcessingCapability"/>
        <rdfs:label>Blue Temp Steel</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process
            blue-tempered steel, which is spring steel heat treated to provide elasticity, hardness,
            and fatigue resistance for spring and shim applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/BoringCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/BoringCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/TurningCapability"/>
        <owl:disjointWith rdf:resource="http://asu.edu/semantics/SUDOKN/CNCTurningCapability"/>
        <rdfs:label>Boring</rdfs:label>
        <skos:definition>A process that involves enlarging a hole or tunnel using a cutting tool
            with a single-point cutting edge to improve concentricity.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/BorosilicateGlassProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/BorosilicateGlassProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/GlassProcessingCapability"/>
        <rdfs:label>Borosilicate Glass</rdfs:label>
        <skos:altLabel>Heat Resistant Glass</skos:altLabel>
        <skos:altLabel>Pyrex</skos:altLabel>
        <skos:definition>The capability of a manufacturing system or machine to process borosilicate
            glass, which is a silica-based glass containing boron oxide and is valued for low
            thermal expansion, thermal shock resistance, and chemical durability.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/BoundMetalDepositionCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/BoundMetalDepositionCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MaterialExtrusionCapability"/>
        <rdfs:label>Bound Metal Deposition</rdfs:label>
        <skos:altLabel>BMD</skos:altLabel>
        <skos:definition>A material extrusion additive manufacturing process where a feedstock
            composed of metal powder bound in a polymer binder is deposited layer by layer and
            subsequently debound and sintered to produce a metal part.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/BrandName -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/BrandName">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/DesignativeName"/>
        <rdfs:label xml:lang="en">brand name</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/BrassProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/BrassProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Non-FerrousMetalProcessingCapability"/>
        <rdfs:label xml:lang="en">Brass</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process brass, which
            is a copper-zinc alloy valued for machinability, corrosion resistance, electrical
            conductivity, and decorative appearance.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/BrazeWeldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/BrazeWeldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermalWeldingCapability"/>
        <rdfs:label>Braze Welding</rdfs:label>
        <skos:altLabel>Welding Brazing</skos:altLabel>
        <skos:definition>A process where a filler metal is heated above melting point and
            distributed between two or more close-fitting parts to join them without melting the
            base materials.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/BrazingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/BrazingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermaJoiningCapability"/>
        <rdfs:label>Brazing</rdfs:label>
        <skos:definition>A process where metals are joined by melting a filler material that has a
            lower melting point than the base materials.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/BritishRetailConsortiumCertificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/BritishRetailConsortiumCertificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/QualityCertificate"/>
        <rdfs:label xml:lang="en">British Retail Consortium</rdfs:label>
        <skos:altLabel>BRCGS Certification</skos:altLabel>
        <skos:definition>A confirmation that an organization has demonstrated conformance to
            quality, safety, operational, and regulatory requirements established by the British
            Retail Consortium Global Standards (BRCGS), typically through auditing, assessment,
            certification, and ongoing compliance activities related to products, processes,
            facilities, or services.</skos:definition>
        <iof-av:directSource xml:lang="en">
            https://safetyculture.com/topics/british-retail-consortium/</iof-av:directSource>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/BroachingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/BroachingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MultipointCuttingCapability"/>
        <rdfs:label>Broaching</rdfs:label>
        <skos:definition>A process that involves removing material through a linear motion of a
            multi-tooth cutting tool called a broach, to produce precise finishes and dimensions.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/BronzeProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/BronzeProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Non-FerrousMetalProcessingCapability"/>
        <rdfs:label xml:lang="en">Bronze</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process bronze,
            which is a copper-based alloy, commonly with tin or other elements, valued for wear
            resistance, corrosion resistance, and bearing performance.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/BuffingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/BuffingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AbrassiveMachiningCapability"/>
        <rdfs:label>Buffing</rdfs:label>
        <skos:definition>A process where a surface is polished to a high shine or smooth finish
            using a buffing wheel and abrasive compounds.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/BuildingNumber -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/BuildingNumber">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/PhysicalLocationIdentifier"/>
        <rdfs:label xml:lang="en">building number</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/BulgeFormingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/BulgeFormingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SheetMetalProcessingProcessingCapability"/>
        <rdfs:label>Bulge Forming</rdfs:label>
        <skos:altLabel>Bulging</skos:altLabel>
        <skos:altLabel>Bulging Process</skos:altLabel>
        <skos:definition>A process where internal pressure is applied to a tube within a die,
            causing the material to expand and conform to the die&apos;s shape.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/BusinessAviationIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/BusinessAviationIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AerospaceIndustry"/>
        <rdfs:label>Business Aviation</rdfs:label>
        <skos:altLabel>General Aviation</skos:altLabel>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving aircraft, aircraft systems, components, maintenance, and services
            used for private, corporate, or executive air transportation, and are intended to
            realize similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/BusinessDescription -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/BusinessDescription">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/InformationContentEntity"/>
        <rdfs:label xml:lang="en">Business Description</rdfs:label>
        <skos:example>XYZ is one of the world&apos;s leading providers of outsourced semiconductor
            packaging and test services making sure that chips are ready to go for smartphones,
            tablets, computers, high-performance gaming systems, automobiles, IoT wearable, and
            network systems. The company&apos;s some 250 customers worldwide include many of the
            largest semiconductor companies around the world. Although Amkor is a public company,
            founder and chairman James Kim and his family control the firm. More than 45% of revenue
            is from US customers. The company traces its roots back to 1935.</skos:example>
        <iof-av:naturalLanguageDefinition>the text that provides a short description for a business</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ButtWeldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ButtWeldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ElectricalResistanceWeldingCapability"/>
        <rdfs:label>Butt Welding</rdfs:label>
        <skos:definition>A process where two materials are joined end-to-end by applying heat and
            pressure, resulting in a continuous, single piece through coalescence and fusion.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CADCAMCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CADCAMCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/EngineeringCapability"/>
        <rdfs:label>CAD/CAM capability</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CADCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CADCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/EngineeringCapability"/>
        <rdfs:label>CAD capability</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CAECapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CAECapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/EngineeringCapability"/>
        <rdfs:label>CAE capability</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CAMCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CAMCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/EngineeringCapability"/>
        <rdfs:label>CAM capability</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CEMarking -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CEMarking">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RegulatoryApproval"/>
        <rdfs:label>CE Marking</rdfs:label>
        <skos:altLabel>CE Mark</skos:altLabel>
        <skos:definition>A conformity attestation indicating that a product conforms to applicable
            European Union health, safety, environmental, and performance requirements.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CEProductCertification -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CEProductCertification">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ProductComplianceCertificate"/>
        <rdfs:label>CE Product Certification</rdfs:label>
        <skos:definition>A product compliance certificate confirming that a product satisfies
            applicable requirements for CE marking within the European Economic Area.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CNCCylindricalGrindingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CNCCylindricalGrindingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CylindricalGrindingCapability"/>
        <rdfs:label>CNC Cylindrical Grinding</rdfs:label>
        <skos:definition>A process where a computer numerically controlled (CNC) machine grinds the
            outer or inner diameter of a cylindrical part to precise dimensions and surface finish.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CNCLaserCuttingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CNCLaserCuttingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/LaserCuttingCapability"/>
        <rdfs:label>CNC Laser Cutting</rdfs:label>
        <skos:definition>A process that utilizes computer-controlled lasers to precisely cut or
            engrave materials, based on a pre-programmed design.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CNCMachiningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CNCMachiningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ConventionalMachiningCapability"/>
        <rdfs:label>CNC Machining</rdfs:label>
        <skos:definition>A process that utilizes computer-controlled machine tools to remove
            material from a workpiece, following a pre-programmed path, to create precise parts.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CNCMillingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CNCMillingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MillingCapability"/>
        <rdfs:label>CNC Milling</rdfs:label>
        <skos:definition>A process that involves the use of computer numerical control (CNC) to
            operate a milling machine for precise material removal.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CNCPunchingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CNCPunchingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PunchingCapability"/>
        <rdfs:label>CNC Punching</rdfs:label>
        <skos:definition>A process where computer-controlled punching machines create holes and
            shapes in sheet metal with high precision and repeatability.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CNCRoutingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CNCRoutingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CNCMachiningCapability"/>
        <rdfs:label>CNC Routing</rdfs:label>
        <skos:definition>A process that utilizes computer numerical control (CNC) to direct a router
            or spindle to cut and shape materials such as wood, plastic, or metal.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CNCTurningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CNCTurningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/TurningCapability"/>
        <rdfs:label>CNC Turning</rdfs:label>
        <skos:altLabel>Large CNC turning</skos:altLabel>
        <skos:definition>A process that involves a computer numerical control (CNC) machine rotating
            a workpiece while a cutting tool shapes the material.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CPVCProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CPVCProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermoplasticProcessingCapability"/>
        <rdfs:label>CPVC</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process chlorinated
            polyvinyl chloride, which is a thermoplastic valued for chemical resistance, heat
            resistance, and use in piping and fluid handling components.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CTFEProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CTFEProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermoplasticProcessingCapability"/>
        <rdfs:label>CTFE</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process
            chlorotrifluoroethylene-based fluoropolymer materials, which are valued for chemical
            resistance, low moisture absorption, and dimensional stability.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CablesProductCategory -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CablesProductCategory">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Connectivity%20%26%20AccessoriesProductCategory"/>
        <rdfs:label xml:lang="en">Cables</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CadmiumPlatingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CadmiumPlatingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ElectroPlatingCapability"/>
        <rdfs:label>Cadmium Plating</rdfs:label>
        <skos:definition>A process where a cadmium layer is electrochemically deposited onto a
            workpiece to provide corrosion resistance, lubricity, and galvanic compatibility.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CarbideMachiningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CarbideMachiningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SpecializedMachiningCapability"/>
        <rdfs:label>Carbide Machining</rdfs:label>
        <skos:definition>A process where solid carbide, carbide-tipped, or carbide insert cutting
            tools are used to machine hard materials in precision manufacturing.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CarbideProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CarbideProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CeramicProcessingCapability"/>
        <rdfs:label>Carbide</rdfs:label>
        <skos:altLabel>Carbide Ceramic</skos:altLabel>
        <skos:definition>The capability of a manufacturing system or machine to process carbide
            materials, which are ceramic compounds composed of carbon and a less electronegative
            element and are commonly valued for exceptional hardness, wear resistance, and cutting
            performance.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CarbonArcBrazingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CarbonArcBrazingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/BrazeWeldingCapability"/>
        <owl:disjointWith rdf:resource="http://asu.edu/semantics/SUDOKN/GasBrazingCapability"/>
        <rdfs:label>Carbon Arc Brazing</rdfs:label>
        <skos:definition>A process where two metal pieces are joined using a carbon electrode to
            produce an electric arc, melting a filler material for bonding.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CarbonArcWeldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CarbonArcWeldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ElectricArcWeldingCapability"/>
        <rdfs:label>Carbon Arc Welding</rdfs:label>
        <skos:definition>A process where intense heat generated from a carbon arc is used to melt
            and fuse metal materials together for joining purposes.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CarbonDioxideMoldCastingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CarbonDioxideMoldCastingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CastingCapability"/>
        <rdfs:label>Carbon Dioxide Mold Casting</rdfs:label>
        <skos:definition>A sand casting process where a mold is hardened by reacting carbon dioxide
            gas with a sodium silicate binder in the sand.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CarbonFiberProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CarbonFiberProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CarbonProcessingCapability"/>
        <rdfs:label>Carbon Fiber</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process carbon
            fiber, which is a high-strength, low-density fibrous carbon material commonly used as
            reinforcement in lightweight composite structures.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CarbonProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CarbonProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CeramicProcessingCapability"/>
        <rdfs:label xml:lang="en">Carbon</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process carbon-based
            materials, which are materials primarily composed of carbon and valued for properties
            such as high strength-to-weight ratio, thermal stability, low density, and electrical or
            thermal conductivity depending on structure.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CarbonSteelProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CarbonSteelProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SteelProcessingCapability"/>
        <rdfs:label>Carbon Steel</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process carbon
            steel, which is steel in which carbon is the principal alloying element and which is
            widely used for structural and general-purpose components.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CarbonitridingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CarbonitridingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/DiffusionHardeningCapability"/>
        <rdfs:label>Carbonitriding</rdfs:label>
        <skos:definition>A process where a ferrous material is heated in a gaseous carbon-nitrogen
            environment to induce surface hardening through diffusion of carbon and nitrogen atoms.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CarburizingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CarburizingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/DiffusionHardeningCapability"/>
        <rdfs:label>Carburizing</rdfs:label>
        <skos:altLabel>Carburising</skos:altLabel>
        <skos:definition>A process where steel or iron surfaces are hardened by heating in a
            carbon-rich environment, allowing carbon absorption and diffusion into the material.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CastAluminumAlloyProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CastAluminumAlloyProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AluminumAlloyProcessingCapability"/>
        <owl:disjointWith rdf:resource="http://asu.edu/semantics/SUDOKN/WroughtAluminumAlloyProcessingCapability"/>
        <rdfs:label>Cast Aluminum Alloy</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process cast
            aluminum alloys, which are aluminum alloys formulated for casting processes and valued
            for low weight, castability, and good mechanical properties.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CastIronProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CastIronProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FerrousAlloyProcessingCapability"/>
        <rdfs:label>Cast Iron</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process cast iron,
            which is an iron-carbon alloy with relatively high carbon content and good castability,
            damping capacity, compressive strength, and wear resistance.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CastSteelProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CastSteelProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SteelProcessingCapability"/>
        <rdfs:label>Cast Steel</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process cast steel,
            which is steel formed by casting and used where castability and steel-like strength,
            toughness, or weldability are required.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CastingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CastingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FormativeManufacturingCapability"/>
        <rdfs:label>Casting</rdfs:label>
        <skos:altLabel>Metal Casting</skos:altLabel>
        <skos:definition>The process is where a liquid material, often molten metal poured or
            injected into a mold.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CellAndGeneTherapyIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CellAndGeneTherapyIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PharmaceuticalsAndBiotechnologyIndustry"/>
        <rdfs:label>Cell and Gene Therapy</rdfs:label>
        <skos:altLabel>CGT</skos:altLabel>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving equipment, systems, materials, and services used to develop,
            manufacture, process, or deliver cell-based or gene-based therapies, and are intended to
            realize similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CementedCarbideProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CementedCarbideProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Metal–CeramicCompositeProcessingCapability"/>
        <rdfs:label>Cemented Carbide</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process cemented
            carbide, which is a metal-ceramic composite typically made from carbide particles bonded
            with a metallic binder and used in cutting tools, dies, and wear components.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CenterlessGrindingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CenterlessGrindingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/GrindingCapability"/>
        <rdfs:label>Centerless Grinding</rdfs:label>
        <skos:definition>A process where material removal is conducted through abrasive cutting,
            without a spindle or fixture, to achieve precision cylindrical surfaces.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CentrifugalCastingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CentrifugalCastingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CastingCapability"/>
        <rdfs:label>Centrifugal Casting</rdfs:label>
        <skos:definition>A metal casting process that uses centrifugal force to distribute molten
            metal uniformly into a rotating mold, resulting in a defect-free part with excellent
            material integrity</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CeramicAdditiveManufacturingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CeramicAdditiveManufacturingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AdditiveManufacturingCapability"/>
        <rdfs:label>Ceramic Additive Manufacturing</rdfs:label>
        <skos:altLabel>Ceramic AM</skos:altLabel>
        <skos:definition>An additive manufacturing process where ceramic materials are selectively
            deposited, bonded, consolidated, or sintered layer by layer to produce ceramic
            components.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CeramicMoldCastingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CeramicMoldCastingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CastingCapability"/>
        <rdfs:label>Ceramic Mold Casting</rdfs:label>
        <skos:definition>A metal casting process that utilizes ceramic materials to create molds for
            precise and complex shapes, often used for tooling, dies, and high-temperature
            applications like aerospace components.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CeramicProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CeramicProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MaterialProcessingCapability"/>
        <rdfs:label xml:lang="en">Ceramic</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process ceramic
            materials, which are inorganic, nonmetallic materials typically characterized by high
            hardness, high temperature resistance, wear resistance, chemical stability, and
            brittleness.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/Certificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/Certificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ConformityAttestation"/>
        <dcterms:source xml:lang="en">https://en.wikipedia.org/wiki/Certificate</dcterms:source>
        <rdfs:label xml:lang="en">Certificate</rdfs:label>
        <skos:definition xml:lang="en">A conformity attestation confirming that a person,
            organization, product, process, facility, or system satisfies specified requirements,
            standards, qualifications, or competencies.</skos:definition>
        <iof-av:adaptedFrom xml:lang="en">http://purl.allotrope.org/ontologies/result#AFR_0000304</iof-av:adaptedFrom>
        <iof-av:explanatoryNote>Certification answers the question: &quot;Does this entity meet the
            specified requirements?&quot;</iof-av:explanatoryNote>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ChemicalCleaningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ChemicalCleaningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AbrasiveCleaningCapability"/>
        <rdfs:label>Chemical Cleaning</rdfs:label>
        <skos:definition>A process where contaminants on a material surface are removed using
            chemical or electrochemical solutions in a controlled manner.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ChemicalCoatingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ChemicalCoatingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CoatingCapability"/>
        <rdfs:label>Chemical Coating</rdfs:label>
        <skos:definition>A process where a substrate is covered with a layer of a chemical solution
            to enhance corrosion resistance, adhesion, and wear resistance.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ChemicalConversionCoatingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ChemicalConversionCoatingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ChemicalCoatingCapability"/>
        <rdfs:label>Chemical Conversion Coating</rdfs:label>
        <skos:altLabel>Chem Filming</skos:altLabel>
        <skos:altLabel>Conversion Coating</skos:altLabel>
        <skos:definition>A process where a metal surface is treated with a chemical solution to form
            a corrosion-resistant, protective outer layer.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ChemicalEngravingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ChemicalEngravingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ChemicalMachiningCapability"/>
        <rdfs:label>Chemical Engraving</rdfs:label>
        <skos:definition>A process where controlled chemical corrosion is used to etch or engrave
            designs onto a metal surface.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ChemicalEtchingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ChemicalEtchingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/EtchingCapability"/>
        <rdfs:label>Chemical Etching</rdfs:label>
        <skos:definition>A process where material is removed from a substrate using chemical
            reactions to create precise patterns or features on the surface.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ChemicalMachiningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ChemicalMachiningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MachiningCapability"/>
        <rdfs:label>Chemical Machining</rdfs:label>
        <skos:altLabel>Chemical Milling</skos:altLabel>
        <skos:definition>A process where material removal occurs through controlled chemical
            erosion, typically by etching with acidic or alkaline solutions.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ChemicalMechanicalPolishingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ChemicalMechanicalPolishingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PlanarizationCapability"/>
        <rdfs:label>Chemical Mechanical Polishing</rdfs:label>
        <skos:definition>A process where a combination of chemical reactions and mechanical forces
            are used to smooth and planarize a material&apos;s surface.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ChemicalPolishingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ChemicalPolishingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PolishingCapability"/>
        <rdfs:label>Chemical Polishing</rdfs:label>
        <skos:definition>A process that utilizes chemical reactions to smooth and polish the surface
            of a metal, enhancing its appearance and corrosion resistance.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ChemicalProcessingProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ChemicalProcessingProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ManufacturingProcessCapability"/>
        <rdfs:label>Chemical Processing</rdfs:label>
        <skos:definition>A process where raw materials undergo chemical reactions to transform into
            finished products, involving techniques like oxidation, reduction, and hydrolysis.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ChemicalVaporDepositionCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ChemicalVaporDepositionCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/VaporizedMetalCoatingCapability"/>
        <rdfs:label>Chemical Vapor Deposition</rdfs:label>
        <skos:definition>A process where a solid material is deposited from a vapor by a chemical
            reaction occurring on or near a heated surface.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ChemicalsProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ChemicalsProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MaterialProcessingCapability"/>
        <rdfs:label xml:lang="en">Chemicals</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process chemical
            substances, which are materials composed of chemical compounds or mixtures used as
            feedstocks, reagents, coatings, additives, intermediates, or finished products in
            manufacturing processes.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ChipsetsProductCategory -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ChipsetsProductCategory">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Computer%20ComponentsProductCategory"/>
        <rdfs:label xml:lang="en">Chipsets</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ChromateConversionCoatingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ChromateConversionCoatingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ChemicalConversionCoatingCapability"/>
        <rdfs:label>Chromate Conversion Coating</rdfs:label>
        <skos:definition>A process where a chromate solution is applied to a metal surface to form a
            protective, corrosion-resistant layer.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ChromePlatingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ChromePlatingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ElectroPlatingCapability"/>
        <rdfs:label>Chrome Plating</rdfs:label>
        <skos:definition>A process where a thin layer of chromium is electroplated onto a metal or
            plastic object to enhance durability, corrosion resistance, and aesthetic appeal.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ChromiumCarbideProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ChromiumCarbideProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CarbideProcessingCapability"/>
        <rdfs:label>Chromium Carbide</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process chromium
            carbide, which is a hard, wear-resistant ceramic compound commonly used in coatings,
            wear parts, and high-temperature corrosion-resistant applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ChromiumProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ChromiumProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Non-FerrousMetalProcessingCapability"/>
        <rdfs:label>Chromium</rdfs:label>
        <skos:altLabel>Chrome</skos:altLabel>
        <skos:definition>The capability of a manufacturing system or machine to process chromium,
            which is a hard, corrosion-resistant metallic element commonly used in alloys, coatings,
            and surface treatments.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ChromizingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ChromizingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SurfaceHardeningCapability"/>
        <rdfs:label>Chromizing</rdfs:label>
        <skos:definition>A process that involves depositing a chromium layer onto a metal substrate
            to enhance its corrosion and wear resistance.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/City -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/City">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/GeopoliticalSite"/>
        <rdfs:label xml:lang="en">City</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CityOfAddress -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CityOfAddress">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/PhysicalLocationIdentifier"/>
        <rdfs:label xml:lang="en">city of address</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CivilInfrastructureIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CivilInfrastructureIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ConstructionAndInfrastructureIndustry"/>
        <rdfs:label>Civil Infrastructure</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving materials, equipment, components, systems, and services used in
            roads, bridges, tunnels, airports, ports, and other public infrastructure assets, and
            are intended to realize similar or related primary business functions according to their
            organizational objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CladdingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CladdingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CoatingCapability"/>
        <rdfs:label>Cladding</rdfs:label>
        <skos:definition>a process can consistently produce outputs that meet predetermined
            specifications or requirements.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/Classifier -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/Classifier">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/InformationContentEntity"/>
        <rdfs:label xml:lang="en">classifier</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en">Designed to organize entities based on
            shared characteristics, facilitating the systematic classification and identification of
            entities within a specified context</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ClinchingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ClinchingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/DipBrazingCapability"/>
        <rdfs:label>Clinching</rdfs:label>
        <skos:definition>A process where sheet metal parts are joined by plastically deforming and
            interlocking material without using additional components or heat.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CoalIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CoalIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/EnergyIndustry"/>
        <rdfs:label>Coal</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving equipment, systems, components, and services used in coal mining,
            preparation, handling, transportation, and coal-fired energy applications, and are
            intended to realize similar or related primary business functions according to their
            organizational objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CoatingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CoatingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SurfaceFinishingCapability"/>
        <rdfs:label>Coating</rdfs:label>
        <skos:definition>A process where a substrate is covered with a layer of material to improve
            surface properties such as appearance, adhesion, wetability, corrosion resistance, or
            wear resistance.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CobaltAlloyProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CobaltAlloyProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Non-FerrousAlloyProcessingCapability"/>
        <rdfs:label>Cobalt Alloy</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process cobalt
            alloys, which are non-ferrous alloys known for wear resistance, corrosion resistance,
            high-temperature strength, and biomedical or aerospace applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CobaltProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CobaltProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Non-FerrousMetalProcessingCapability"/>
        <rdfs:label>Cobalt</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process cobalt,
            which is a non-ferrous metal used in high-temperature alloys, wear-resistant alloys,
            magnets, batteries, and biomedical materials.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CoiningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CoiningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ForgingCapability"/>
        <rdfs:label>Coining</rdfs:label>
        <skos:definition>Coining is a precision closed-die forging process where a workpiece is
            compressed between two dies under very high pressure to create fine detailed features,
            smooth surfaces, and tight dimensional tolerances.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ColdChamberDieCastingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ColdChamberDieCastingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/DieCastingCapability"/>
        <rdfs:label>Cold Chamber Die Casting</rdfs:label>
        <skos:definition>A manufacturing process where molten metal, often aluminum or magnesium, is
            heated in a separate furnace and then transferred to the die casting machine.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ColdDrawingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ColdDrawingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/DrawingCapability"/>
        <rdfs:label>Cold Drawing</rdfs:label>
        <skos:definition>A process where metal is pulled through a die to reduce its diameter,
            improve surface finish, and enhance mechanical properties without heating.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ColdExtrusionCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ColdExtrusionCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ExtrudingCapability"/>
        <rdfs:label>Cold Extrusion</rdfs:label>
        <skos:definition>A process where metal billets are forced through a die at room temperature,
            enhancing mechanical properties and dimensional accuracy without thermal degradation.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ColdForgingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ColdForgingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ForgingCapability"/>
        <rdfs:label>Cold Forging</rdfs:label>
        <skos:definition>A process where metal is plastically deformed at room temperature using
            compressive forces to increase strength and achieve precise dimensional tolerances.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ColdFormingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ColdFormingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FormingCapability"/>
        <rdfs:label>Cold Forming</rdfs:label>
        <skos:definition>A process where metal is plastically deformed at room temperature to
            increase strength, improve surface finish, and achieve precise dimensional tolerances.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ColdIsostaticsPressingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ColdIsostaticsPressingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/IsostaticPressingCapability"/>
        <rdfs:label>Cold Isostatics Pressing</rdfs:label>
        <skos:definition>A process where powdered materials are compacted into dense, uniform shapes
            using high-pressure fluid applied isotropically at ambient temperature.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ColdRolledSteelProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ColdRolledSteelProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SteelProcessingCapability"/>
        <rdfs:label>Cold Rolled Steel</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process cold rolled
            steel, which is steel that has been rolled at room temperature to improve surface
            finish, dimensional accuracy, and mechanical properties.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ColdRollingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ColdRollingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RollingCapability"/>
        <rdfs:label>Cold Rolling</rdfs:label>
        <skos:definition>A process where metal is passed through rollers below recrystallization
            temperature, increasing strength and hardness while reducing thickness and improving
            surface finish.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ColdSprayAdditiveManufacturingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ColdSprayAdditiveManufacturingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AdditiveManufacturingCapability"/>
        <rdfs:label>Cold Spray Additive Manufacturing</rdfs:label>
        <skos:altLabel>CSAM</skos:altLabel>
        <skos:altLabel>Cold Spray AM</skos:altLabel>
        <skos:definition>An additive manufacturing process where solid powder particles are
            accelerated in a high-velocity gas stream and deposited onto a substrate, causing them
            to bond through plastic deformation without significant melting.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ColdTreatmentCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ColdTreatmentCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/HeatTreatingCapability"/>
        <rdfs:label>Cold Treatment</rdfs:label>
        <skos:definition>A process where materials are subjected to low temperatures to improve
            hardness, strength, and stress relief without altering their original structure.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ColdVacuumPressingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ColdVacuumPressingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/VacuumPressingCapability"/>
        <rdfs:label>Cold Vacuum Pressing</rdfs:label>
        <skos:definition>A process where materials are compressed at low temperatures in a vacuum
            environment to eliminate air pockets and enhance bonding strength.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ColdWorkingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ColdWorkingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ProcessAnnealingCapability"/>
        <rdfs:label>Cold Working</rdfs:label>
        <skos:altLabel>Cold Work</skos:altLabel>
        <skos:definition>A process where metal is plastically deformed below its recrystallization
            temperature, enhancing strength and hardness through strain hardening without altering
            its phase.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CombustibleGasWeldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CombustibleGasWeldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/GasWeldingCapability"/>
        <rdfs:label>Combustible Gas Welding</rdfs:label>
        <skos:definition>A process where a combustible gas, typically acetylene, is used to generate
            heat, melting the workpieces to form a joint.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CommercialAviationIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CommercialAviationIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AerospaceIndustry"/>
        <rdfs:label>Commercial Aviation</rdfs:label>
        <skos:altLabel>Airline Aviation</skos:altLabel>
        <skos:altLabel>Civil Aviation</skos:altLabel>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving aircraft, aircraft systems, components, maintenance, and services
            used in commercial air transportation, and are intended to realize similar or related
            primary business functions according to their organizational objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CommercialConstructionIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CommercialConstructionIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ConstructionAndInfrastructureIndustry"/>
        <rdfs:label>Commercial Construction</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving materials, equipment, components, systems, and services used in the
            construction, renovation, or maintenance of commercial buildings, and are intended to
            realize similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CommercialMarineIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CommercialMarineIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MarineAndShipbuildingIndustry"/>
        <rdfs:label>Commercial Marine</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving vessels, equipment, components, and services used in commercial
            maritime transportation, workboats, and marine operations, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CommercialVehiclesIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CommercialVehiclesIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AutomotiveIndustry"/>
        <rdfs:label>Commercial Vehicles</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving vehicles, components, systems, and services used in trucks, vans,
            buses, and other vehicles intended for commercial transportation, and are intended to
            realize similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CommunicationInfrastructureIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CommunicationInfrastructureIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/TelecommunicationsIndustry"/>
        <rdfs:label>Communication Infrastructure</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving towers, cables, antennas, cabinets, power systems, enclosures, and
            related products used to support communication networks, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CompositeAdditiveManufacturingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CompositeAdditiveManufacturingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AdditiveManufacturingCapability"/>
        <rdfs:label>Composite Additive Manufacturing</rdfs:label>
        <skos:altLabel>Composite AM</skos:altLabel>
        <skos:definition>An additive manufacturing process where composite materials consisting of
            two or more constituent materials are selectively deposited, bonded, consolidated, or
            cured layer by layer to produce composite components.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CompositeManufacturingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CompositeManufacturingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ManufacturingProcessCapability"/>
        <rdfs:label>Composite Manufacturing</rdfs:label>
        <skos:definition>A manufacturing process where composite materials are fabricated, formed,
            assembled, or finished to produce components with desired structural and functional
            properties</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CompositeMaterialExtrusionCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CompositeMaterialExtrusionCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CompositeAdditiveManufacturingCapability"/>
        <rdfs:label>Composite Material Extrusion</rdfs:label>
        <skos:altLabel>Composite Extrusion AM</skos:altLabel>
        <skos:definition>A composite additive manufacturing process where a composite feedstock is
            selectively dispensed through a nozzle or orifice to form a three-dimensional composite
            component layer by layer.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CompositePowderBedFusionCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CompositePowderBedFusionCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CompositeAdditiveManufacturingCapability"/>
        <rdfs:label>Composite Powder Bed Fusion</rdfs:label>
        <skos:altLabel>Composite PBF</skos:altLabel>
        <skos:definition>A composite additive manufacturing process where regions of a powder bed
            containing composite or reinforced powder material are selectively fused or sintered to
            produce a composite component layer by layer.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CompositeProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CompositeProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MaterialProcessingCapability"/>
        <rdfs:label xml:lang="en">Composite</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process composite
            materials, which consist of two or more distinct constituent materials combined to
            achieve properties not attainable by the individual constituents alone.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CompositeVatPhotopolymerizationCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CompositeVatPhotopolymerizationCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CompositeAdditiveManufacturingCapability"/>
        <rdfs:label>Composite Vat Photopolymerization</rdfs:label>
        <skos:altLabel>Composite Vat Polymerization</skos:altLabel>
        <skos:definition>A composite additive manufacturing process where a photopolymer resin
            containing reinforcing or functional filler materials is selectively cured by light in a
            vat to produce a composite component layer by layer.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CompressionMoldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CompressionMoldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MoldingCapability"/>
        <rdfs:label>Compression Molding</rdfs:label>
        <skos:altLabel>CRTM</skos:altLabel>
        <skos:altLabel>Compression Resin Transfer Molding</skos:altLabel>
        <skos:definition>A process where thermosetting plastics are preheated, placed in a mold, and
            subjected to pressure to form complex, high-strength parts.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ConcreteProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ConcreteProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SilicateProcessingCapability"/>
        <rdfs:label>Concrete</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process concrete,
            which is a cementitious composite material made from cement, aggregates, water, and
            additives and used primarily in construction and infrastructure applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ConformityAttestation -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ConformityAttestation">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/InformationContentEntity"/>
        <rdfs:label>Conformity Attestation</rdfs:label>
        <skos:definition>An information artifact that attests that an organization, person, product,
            process, facility, or system has satisfied specified requirements, standards,
            qualifications, or regulatory conditions, typically through assessment, auditing,
            inspection, testing, review, registration, accreditation, certification, clearance, or
            approval activities.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ConstructionAndInfrastructureIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ConstructionAndInfrastructureIndustry">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/supplychain/SupplyChain/Industry"/>
        <rdfs:label>Construction and Infrastructure</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving the design, manufacturing, integration, operation, maintenance,
            distribution, or support of products, systems, equipment, or services associated with
            the built environment and infrastructure systems, and are intended to realize similar or
            related primary business functions according to their organizational objectives and
            plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ConsumerElectronicsIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ConsumerElectronicsIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ConsumerProductsIndustry"/>
        <rdfs:label>Consumer Electronics</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving electronic devices, accessories, appliances, and support products
            intended for personal, household, or recreational use, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ConsumerProductsIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ConsumerProductsIndustry">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/supplychain/SupplyChain/Industry"/>
        <rdfs:label>Consumer Products</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving the design, manufacturing, integration, operation, maintenance,
            distribution, or support of products, systems, equipment, or services associated with
            consumer markets and everyday-use products, and are intended to realize similar or
            related primary business functions according to their organizational objectives and
            plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ContinuousCastingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ContinuousCastingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CastingCapability"/>
        <rdfs:label>Continuous Casting</rdfs:label>
        <skos:definition>A process where molten metal is solidified into a continuous length,
            usually in the form of slabs, billets, or blooms.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ContinuousFiberAdditiveManufacturingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ContinuousFiberAdditiveManufacturingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CompositeAdditiveManufacturingCapability"/>
        <rdfs:label>Continuous Fiber Additive Manufacturing</rdfs:label>
        <skos:altLabel>Continuous Fiber AM</skos:altLabel>
        <skos:definition>A composite additive manufacturing process where continuous reinforcing
            fibers are deposited with a matrix material layer by layer to produce composite
            components with enhanced mechanical properties.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ContourMachiningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ContourMachiningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PrecisionMachiningCapability"/>
        <rdfs:label>Contour Machining</rdfs:label>
        <skos:definition>A process where CNC machine tools cut along curved or angled paths to
            produce complex contoured shapes with high accuracy.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ContourMillingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ContourMillingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MillingCapability"/>
        <rdfs:label>Contour Milling</rdfs:label>
        <skos:definition>A process where milling machines cut along curved or angled paths to create
            contoured or complex 3D surfaces with precision.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ConventionalMachiningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ConventionalMachiningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MachiningCapability"/>
        <rdfs:label>Conventional Machining</rdfs:label>
        <skos:altLabel>standard machining</skos:altLabel>
        <skos:definition>A process where material is removed from a workpiece using cutting tools to
            achieve precise dimensions and surface finishes through controlled material removal.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CopperPlatingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CopperPlatingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ElectroPlatingCapability"/>
        <rdfs:label>Copper Plating</rdfs:label>
        <skos:definition>A process where a workpiece is coated with a thin layer of copper by
            electrochemical deposition from a copper ion solution.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CopperProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CopperProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Non-FerrousMetalProcessingCapability"/>
        <rdfs:label xml:lang="en">Copper</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process copper,
            which is a highly conductive, ductile non-ferrous metal used in electrical, thermal,
            plumbing, and industrial applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CoremakingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CoremakingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MoldMakingCapability"/>
        <rdfs:label>Core Making</rdfs:label>
        <skos:definition>A process where sand cores are created using binders and heat to form
            internal cavities and passages in metal castings.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CorrugatedPackagingIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CorrugatedPackagingIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PackagingIndustry"/>
        <rdfs:label>Corrugated Packaging</rdfs:label>
        <skos:altLabel>Cardboard Packaging</skos:altLabel>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving corrugated boxes, boards, containers, displays, materials, and
            equipment used to package, protect, or ship products, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CorrugationCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CorrugationCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SheetMetalProcessingProcessingCapability"/>
        <rdfs:label>Corrugation</rdfs:label>
        <skos:altLabel>Corrugating</skos:altLabel>
        <skos:definition>A process where flat sheets of material are mechanically formed into a
            series of parallel ridges and grooves to enhance structural rigidity.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CounterBoringCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CounterBoringCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/HoleMakingCapability"/>
        <rdfs:label>Counter Boring</rdfs:label>
        <skos:definition>A process where a larger diameter hole is drilled into an existing hole to
            create a stepped hole or to accommodate a fastener head.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CounterSinkingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CounterSinkingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/HoleMakingCapability"/>
        <rdfs:label>Counter Sinking</rdfs:label>
        <skos:definition>A process that involves enlarging and beveling the top of a drilled hole to
            allow a flat-headed fastener to sit flush with a surface.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/Country -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/Country">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/GeopoliticalSite"/>
        <rdfs:label xml:lang="en">Country</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CountryOfAddress -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CountryOfAddress">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/PhysicalLocationIdentifier"/>
        <rdfs:label xml:lang="en">country of address</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/County -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/County">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/GeopoliticalSite"/>
        <rdfs:label xml:lang="en">County</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CreepFeedGrindingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CreepFeedGrindingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/GrindingCapability"/>
        <rdfs:label>Creep Feed Grinding</rdfs:label>
        <skos:altLabel>Precision Grinding</skos:altLabel>
        <skos:definition>A process where high-precision abrasive machining is performed with a slow,
            deep-cutting grinding action on hard materials using a specialized machine.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CrochetCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CrochetCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/TextileProcessCapability"/>
        <rdfs:label xml:lang="en">Crochet</rdfs:label>
        <skos:definition>A process that involves creating fabric by interlocking loops of yarn,
            thread, or strands of other materials using a crochet hook.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CropProductionIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CropProductionIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AgricultureIndustry"/>
        <rdfs:label>Crop Production</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving equipment, systems, inputs, and services used in planting,
            cultivating, harvesting, handling, or storing crops, and are intended to realize similar
            or related primary business functions according to their organizational objectives and
            plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CuringCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CuringCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FabricatingCapability"/>
        <rdfs:label>Curing</rdfs:label>
        <skos:definition>A process where polymers, composites, adhesives, or coatings are hardened
            through chemical reactions or thermal treatment.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CurvicGrindingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CurvicGrindingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/GrindingCapability"/>
        <rdfs:label>Curvic Grinding</rdfs:label>
        <skos:definition>A process where precise, curved, tooth-like forms are ground into surfaces
            to enable high torque transmissions and accurate alignment in mechanical systems.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CustomTubingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CustomTubingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/TubingCapability"/>
        <rdfs:label>Custom Tubing</rdfs:label>
        <skos:definition>A process that involves fabricating tubes to specific dimensions and
            material specifications as per individual customer requirements.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CutToLengthTubingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CutToLengthTubingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/TubingCapability"/>
        <rdfs:label>Cut to Length Tubing</rdfs:label>
        <skos:definition>A process where specific lengths of tubing are produced by cutting longer
            tubes using precise, automated machinery.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CyanidingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CyanidingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SurfaceHardeningCapability"/>
        <rdfs:label>Cyaniding</rdfs:label>
        <skos:definition>A process where steel parts are heated in a cyanide bath to create a hard,
            wear-resistant surface through the formation of a thin layer of iron cyanide.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CylindricalGrindingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CylindricalGrindingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/GrindingCapability"/>
        <rdfs:label>Cylindrical Grinding</rdfs:label>
        <skos:definition>A process where an abrasive wheel removes material from a workpiece&apos;s
            external surface to achieve precise diameter and surface finish.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/CylindricalSilkScreenPrintingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/CylindricalSilkScreenPrintingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ScreenPrintingCapability"/>
        <rdfs:label>Cylindrical Silk Screen Printing</rdfs:label>
        <skos:definition>A process where screen printing techniques are applied to cylindrical or
            curved surfaces such as bottles, tubes, or containers.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/DEAControlledSubstanceRegistration -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/DEAControlledSubstanceRegistration">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RegulatoryRegistration"/>
        <rdfs:comment>Regulatory authority: United States Drug Enforcement Administration (DEA). Typical industry: Pharmaceutical, biotechnology, chemical, and controlled-substance manufacturing and distribution.</rdfs:comment>
        <rdfs:label>DEA Controlled Substance Registration</rdfs:label>
        <skos:altLabel>Controlled Substance Registration</skos:altLabel>
        <skos:altLabel>DEA Registration</skos:altLabel>
        <skos:definition>A regulatory registration issued by the United States Drug Enforcement Administration authorizing an organization to conduct specified controlled-substance activities, such as manufacturing, distributing, importing, exporting, researching, or dispensing, within the registered schedules and activity categories.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/DairyProductsIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/DairyProductsIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FoodAndBeverageIndustry"/>
        <rdfs:label>Dairy Products</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving equipment, materials, packaging, systems, and services used to
            produce, process, package, or distribute dairy products, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/DataCentersIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/DataCentersIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/TelecommunicationsIndustry"/>
        <rdfs:label>Data Centers</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving equipment, components, infrastructure, cooling systems, power
            systems, and services used in data center operations, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/DeburringCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/DeburringCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ConventionalMachiningCapability"/>
        <rdfs:label>Deburring</rdfs:label>
        <skos:altLabel>Debur</skos:altLabel>
        <skos:definition>A process where residual material edges or protrusions are removed from a
            workpiece after machining operations, enhancing its quality and safety.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/DecorativeAnodizingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/DecorativeAnodizingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AnodizingCapability"/>
        <rdfs:label>Decorative Anodizing</rdfs:label>
        <skos:definition>A process where aluminum surfaces are electrolytically treated to form a
            durable, corrosion-resistant, and aesthetic oxide layer.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/DeepDrawingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/DeepDrawingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/DrawingCapability"/>
        <rdfs:label>Deep Drawing</rdfs:label>
        <skos:definition>A process where a metal blank is radially drawn into a forming die by a
            mechanical punch, creating a hollow, cup-like structure.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/DeepHoleDrillingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/DeepHoleDrillingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/DrillingCapability"/>
        <rdfs:label>Deep Hole Drilling</rdfs:label>
        <skos:altLabel>Deep Hole Machining</skos:altLabel>
        <skos:definition>A process that involves creating deep, straight holes in a material using
            specialized drilling machines and tools for precision and accuracy.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/DefenseAerospaceIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/DefenseAerospaceIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AerospaceIndustry"/>
        <rdfs:label>Defense Aerospace</rdfs:label>
        <skos:altLabel>Military Aerospace</skos:altLabel>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving aircraft, aerospace systems, components, and services used for
            military or national defense applications, and are intended to realize similar or
            related primary business functions according to their organizational objectives and
            plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/DefenseElectronicsIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/DefenseElectronicsIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/DefenseIndustry"/>
        <rdfs:label>Defense Electronics</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving electronic systems, sensors, communication devices, computing
            systems, and components used in defense platforms or missions, and are intended to
            realize similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/DefenseIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/DefenseIndustry">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/supplychain/SupplyChain/Industry"/>
        <rdfs:label>Defense</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving the design, manufacturing, integration, operation, maintenance,
            distribution, or support of products, systems, equipment, or services associated with
            national security and defense operations, and are intended to realize similar or related
            primary business functions according to their organizational objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/DelrinProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/DelrinProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermoplasticProcessingCapability"/>
        <rdfs:label>Delrin</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process Delrin,
            which is an acetal homopolymer engineering thermoplastic valued for stiffness, low
            friction, wear resistance, and dimensional stability.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/DentalProductsIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/DentalProductsIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/HealthcareAndMedicalDevicesIndustry"/>
        <rdfs:label>Dental Products</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving devices, instruments, materials, equipment, and support products
            used in dental care, diagnosis, restoration, or treatment, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/DesignativeName -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/DesignativeName">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/Identifier"/>
        <rdfs:label>designative name</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/DesktopsProductCategory -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/DesktopsProductCategory">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Computing%20DevicesProductCategory"/>
        <rdfs:label xml:lang="en">Desktops</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/DiagnosticEquipmentIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/DiagnosticEquipmentIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/HealthcareAndMedicalDevicesIndustry"/>
        <rdfs:label>Diagnostic Equipment</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving equipment, instruments, devices, components, and systems used to
            detect, measure, image, or analyze health-related conditions, and are intended to
            realize similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/DiamondCompositeProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/DiamondCompositeProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CompositeProcessingCapability"/>
        <rdfs:label>Diamond Composite</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process diamond
            composite materials, which combine diamond particles or structures with another matrix
            material to provide high hardness, wear resistance, and cutting performance.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/DiamondMachiningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/DiamondMachiningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SpecializedMachiningCapability"/>
        <rdfs:label>Diamond Machining</rdfs:label>
        <skos:altLabel>Polycrystaline Diamond Machining</skos:altLabel>
        <skos:definition>A process where ultra-precision cutting tools with diamond tips are used to
            machine materials with high surface quality and dimensional accuracy.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/DiamondProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/DiamondProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CarbonProcessingCapability"/>
        <rdfs:label>Diamond</rdfs:label>
        <skos:altLabel>Natural Diamond</skos:altLabel>
        <skos:altLabel>Synthetic Diamond</skos:altLabel>
        <skos:definition>The capability of a manufacturing system or machine to process diamond,
            which is a crystalline form of carbon known for extreme hardness, high thermal
            conductivity, wear resistance, and use in abrasives, cutting tools, and precision
            components.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/DieCastingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/DieCastingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CastingCapability"/>
        <rdfs:label>Die Casting</rdfs:label>
        <skos:definition>A process where molten metal is forced under high pressure into a
            specialized metal mold (die).</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/DieDesignCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/DieDesignCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ToolDesignCapability"/>
        <owl:disjointWith rdf:resource="http://asu.edu/semantics/SUDOKN/FixtureDesignCapability"/>
        <rdfs:label>die design capability</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/DieForgingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/DieForgingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ForgingCapability"/>
        <rdfs:label>Die Forging</rdfs:label>
        <skos:definition>A process where metal is plastically deformed under high pressure using
            dies to produce components with improved mechanical properties and dimensional accuracy.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/DieMakingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/DieMakingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ToolMakingCapability"/>
        <rdfs:label>Die Making</rdfs:label>
        <skos:definition>A process where precision tools and dies are designed and fabricated to
            shape, cut, or form materials in manufacturing operations.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/DieSinkingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/DieSinkingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/HoleDrillingEDMCapability"/>
        <rdfs:label>Die Sinking</rdfs:label>
        <skos:definition>A process where an electrically conductive workpiece is shaped by
            controlled erosion using a spark discharge between the workpiece and a shaped electrode.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/DiffusionBondingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/DiffusionBondingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermalWeldingCapability"/>
        <rdfs:label>Diffusion Bonding</rdfs:label>
        <skos:definition>A process where materials are joined through atomic diffusion at elevated
            temperature and pressure, without melting, resulting in a monolithic structure.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/DiffusionHardeningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/DiffusionHardeningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SurfaceHardeningCapability"/>
        <rdfs:label>Diffusion Hardening</rdfs:label>
        <skos:definition>A process where carbon or nitrogen atoms are diffused into a metal surface
            to increase hardness, wear resistance, and fatigue strength.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/DipBrazingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/DipBrazingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/BrazingCapability"/>
        <rdfs:label>Dip Brazing</rdfs:label>
        <skos:definition>A process where components are joined by immersing them in a molten filler
            metal, which then cools to form a strong, sealed joint.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/DipSolderingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/DipSolderingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SolderingCapability"/>
        <rdfs:label>Dip Soldering</rdfs:label>
        <skos:definition>A process where electronic components are submerged into molten solder to
            create reliable, conductive joints between the component and the circuit board.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/DirectExtrusionCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/DirectExtrusionCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ExtrudingCapability"/>
        <rdfs:label>Direct Extrusion</rdfs:label>
        <skos:definition>A process where a billet is heated and forced through a die, reducing
            cross-sectional area and increasing length, to produce a desired profile.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/DirectedEnergyDepositionCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/DirectedEnergyDepositionCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AdditiveManufacturingCapability"/>
        <rdfs:label>Directed Energy Deposition</rdfs:label>
        <skos:definition>A process where focused thermal energy fuses material, typically metal
            powder or wire, layer by layer to build or repair components.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/DisabledVeteranOwned -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/DisabledVeteranOwned">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/OwnershipStatusClassifier"/>
        <owl:disjointWith rdf:resource="http://asu.edu/semantics/SUDOKN/MinorityOwned"/>
        <rdfs:label xml:lang="en">Disabled Veteran Owned</rdfs:label>
        <skos:altLabel xml:lang="en">Disabled Veteran Owner</skos:altLabel>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/DownstreamOilAndGasIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/DownstreamOilAndGasIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/OilAndGasIndustry"/>
        <rdfs:label>Downstream Oil and Gas</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving equipment, systems, components, and services used in refining,
            distribution, and marketing of petroleum and fuel products, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/DrawingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/DrawingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FormingCapability"/>
        <rdfs:label>Drawing</rdfs:label>
        <skos:definition>A process where metal is pulled through a die to reduce its cross-section
            and increase its length, commonly used in wire and tube production.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/DrillingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/DrillingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/HoleMakingCapability"/>
        <rdfs:label>Drilling</rdfs:label>
        <skos:definition>A process where a rotating cutting tool, known as a drill bit, is used to
            cut a hole of circular cross-section in solid materials.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/DropForgingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/DropForgingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ForgingCapability"/>
        <rdfs:label>Drop Forging</rdfs:label>
        <skos:definition>A process where heated metal is shaped by being placed between two dies and
            hammered, enhancing strength and structural integrity.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/DropOnDemandCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/DropOnDemandCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AdditiveManufacturingCapability"/>
        <rdfs:label>Drop On Demand</rdfs:label>
        <skos:definition>The process where ink droplets are ejected only when needed to print a
            specific dot on a surface.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/DrugDeliverySystemsIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/DrugDeliverySystemsIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PharmaceuticalsAndBiotechnologyIndustry"/>
        <rdfs:label>Drug Delivery Systems</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving devices, packaging, materials, components, and systems used to
            deliver pharmaceutical or therapeutic products to patients, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/DryingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/DryingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FabricatingCapability"/>
        <rdfs:label>Drying</rdfs:label>
        <skos:definition>A process where moisture or solvents are removed from materials, coatings,
            or products using heat, air, vacuum, or other methods.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/DuctileIronProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/DuctileIronProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CastIronProcessingCapability"/>
        <rdfs:label>Ductile Iron</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process ductile
            iron, which is cast iron containing nodular graphite that provides improved ductility,
            toughness, and fatigue resistance compared with gray cast iron.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/DyeingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/DyeingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/TextileProcessCapability"/>
        <rdfs:label xml:lang="en">Dyeing</rdfs:label>
        <skos:definition>A process where textiles are treated with a soluble colorant to impart a
            permanent and resistant color.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ECGTubeCuttingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ECGTubeCuttingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ElectrochemicalGrindingCapability"/>
        <rdfs:label>ECG Tube Cutting</rdfs:label>
        <skos:definition>A process where electrical discharge machining is utilized to cut precise
            shapes into electro-conductive materials, specifically tubes.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/EDMCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/EDMCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermalSubtractionCapability"/>
        <owl:disjointWith rdf:resource="http://asu.edu/semantics/SUDOKN/WaterjetCuttingCapability"/>
        <rdfs:label>EDM</rdfs:label>
        <skos:altLabel>Electric Discharge Machining</skos:altLabel>
        <skos:definition>A process that utilizes electrical discharges to remove material from a
            workpiece, known as Electrical Discharge Machining (EDM).</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/EPAPesticideRegistration -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/EPAPesticideRegistration">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RegulatoryRegistration"/>
        <rdfs:comment>Regulatory authority: United States Environmental Protection Agency (EPA). Typical industry: Agricultural chemicals, pesticides, biocides, and antimicrobial product manufacturing.</rdfs:comment>
        <rdfs:label>EPA Pesticide Registration</rdfs:label>
        <skos:altLabel>EPA Product Registration</skos:altLabel>
        <skos:altLabel>FIFRA Pesticide Registration</skos:altLabel>
        <skos:definition>A regulatory registration issued by the United States Environmental Protection Agency under the Federal Insecticide, Fungicide, and Rodenticide Act authorizing a specified pesticide product and its approved labeling and uses to be sold or distributed in the United States, subject to applicable conditions.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/EPAVehicleEmissionsCertification -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/EPAVehicleEmissionsCertification">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RegulatoryApproval"/>
        <rdfs:comment>Regulatory authority: United States Environmental Protection Agency (EPA). Typical industry: Automotive, engine, vehicle, and mobile equipment manufacturing.</rdfs:comment>
        <rdfs:label>EPA Vehicle Emissions Certification</rdfs:label>
        <skos:altLabel>EPA Certificate of Conformity</skos:altLabel>
        <skos:altLabel>Vehicle Emissions Certificate of Conformity</skos:altLabel>
        <skos:definition>A regulatory approval documented by a certificate of conformity issued by the United States Environmental Protection Agency confirming that a specified vehicle, engine, or equipment family conforms to applicable federal emissions requirements and may be introduced into United States commerce for the covered model year.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ElastomerProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ElastomerProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PolymerProcessingCapability"/>
        <rdfs:label>Elastomer</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process elastomer
            materials, which are polymers capable of substantial elastic deformation and recovery
            after unloading.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ElectricArcWeldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ElectricArcWeldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermalWeldingCapability"/>
        <rdfs:label>Electric Arc Welding</rdfs:label>
        <skos:definition>A process where an electric arc between an electrode and the workpiece
            generates heat to melt and join metals.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ElectricPowerGenerationIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ElectricPowerGenerationIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/EnergyIndustry"/>
        <rdfs:label>Electric Power Generation</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving equipment, systems, components, and services used to generate
            electric power from conventional, renewable, or hybrid sources, and are intended to
            realize similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ElectricUtilitiesIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ElectricUtilitiesIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/EnergyIndustry"/>
        <rdfs:label>Electric Utilities</rdfs:label>
        <skos:altLabel>Power Utilities</skos:altLabel>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving equipment, systems, components, and services used in electric power
            transmission, distribution, grid operation, and utility support, and are intended to
            realize similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ElectricVehiclesIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ElectricVehiclesIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AutomotiveIndustry"/>
        <rdfs:label>Electric Vehicles</rdfs:label>
        <skos:altLabel>EV</skos:altLabel>
        <skos:altLabel>EVs</skos:altLabel>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving vehicles, components, charging systems, battery systems, and support
            products used in electrically powered transportation, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ElectricalResistanceWeldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ElectricalResistanceWeldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermalWeldingCapability"/>
        <rdfs:label>Electrical Resistance Welding</rdfs:label>
        <skos:definition>A process where heat generated from electrical resistance is used to join
            or fuse metal parts together under applied pressure.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ElectroChemicalMachiningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ElectroChemicalMachiningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MachiningCapability"/>
        <rdfs:label>Electro Chemical Machining</rdfs:label>
        <skos:definition>A process where material is removed from a workpiece through anodic
            dissolution using a controlled electrolyte flow and electrical current.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ElectroDepositionCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ElectroDepositionCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CopperPlatingCapability"/>
        <rdfs:label>Electro Deposition</rdfs:label>
        <skos:definition>A process where metal ions in a solution are reduced and deposited onto a
            conductive substrate via an electric current.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ElectroFormingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ElectroFormingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FormingCapability"/>
        <rdfs:label>Electro Forming</rdfs:label>
        <skos:definition>A process where metal is deposited onto a mandrel through electroplating,
            creating precise, intricate components after mandrel removal.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ElectroPlatingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ElectroPlatingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PlatingCapability"/>
        <rdfs:label>Electroplating</rdfs:label>
        <skos:altLabel>Electro-Plating</skos:altLabel>
        <skos:altLabel>Electropolish</skos:altLabel>
        <skos:definition>A process where a metal workpiece is coated with a thin layer of another
            metal via electrodeposition to enhance corrosion resistance, wearability, or aesthetics.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ElectroSlagWeldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ElectroSlagWeldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ElectricalResistanceWeldingCapability"/>
        <rdfs:label>Electro Slag Welding</rdfs:label>
        <skos:altLabel>ESW Welding</skos:altLabel>
        <skos:definition>A process where high current is passed through a consumable electrode to
            melt and weld thick metal plates using slag&apos;s heat conductivity.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ElectrochemicalGrindingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ElectrochemicalGrindingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/GrindingCapability"/>
        <rdfs:label>Electrochemical Grinding</rdfs:label>
        <skos:definition>A process where material removal is achieved by combined mechanical
            grinding and electrochemical erosion, reducing stress and thermal damage.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ElectrochemicalProcessesCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ElectrochemicalProcessesCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ChemicalProcessingProcessingCapability"/>
        <rdfs:label>Electrochemical Processes</rdfs:label>
        <skos:definition>A process where electrical energy drives chemical reactions to deposit,
            dissolve, or alter materials on a workpiece at the atomic level.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ElectrocoatingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ElectrocoatingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CoatingCapability"/>
        <rdfs:label>Electrocoating</rdfs:label>
        <skos:definition>A process where electrically charged particles deposit onto a conductive
            substrate, forming a uniform, corrosion-resistant coating through electrodeposition.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ElectrodepositedCoatingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ElectrodepositedCoatingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CoatingCapability"/>
        <rdfs:label>Electrodeposited Coating</rdfs:label>
        <skos:definition>A process where metal ions are deposited onto a substrate via electrolysis,
            forming a uniform, adherent coating for enhanced surface properties.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ElectrolessNickelPlatingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ElectrolessNickelPlatingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ElectroPlatingCapability"/>
        <rdfs:label>Electroless Nickel Plating</rdfs:label>
        <skos:definition>A process where a nickel-phosphorus alloy is deposited onto a metal surface
            via chemical reduction, enhancing corrosion resistance and hardness.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ElectronBeamMachiningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ElectronBeamMachiningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/HighEnergyBeamMachiningCapability"/>
        <rdfs:label>Electron Beam Machining</rdfs:label>
        <skos:definition>A process where high-velocity electrons concentrated into a narrow beam are
            used to remove or cut material by melting or vaporizing it.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ElectronBeamMeltingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ElectronBeamMeltingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PowderDepositionCapability"/>
        <rdfs:label>Electron Beam Melting</rdfs:label>
        <skos:altLabel>EBM</skos:altLabel>
        <skos:altLabel>Electron Beam Powder Bed Fusion</skos:altLabel>
        <skos:definition>A powder bed fusion process where an electron beam selectively melts
            metallic powder in a vacuum environment to produce a part layer by layer.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ElectronBeamWeldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ElectronBeamWeldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/HighEnergyBeamWeldingCapability"/>
        <rdfs:label>Electron Beam Welding</rdfs:label>
        <skos:definition>A process where high-velocity electrons are used to generate heat, causing
            fusion and joining materials, known as Electron Beam Welding.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ElectronicComponentsIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ElectronicComponentsIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ElectronicsIndustry"/>
        <rdfs:label>Electronic Components</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving components, modules, interconnects, assemblies, and materials used
            in electronic products and systems, and are intended to realize similar or related
            primary business functions according to their organizational objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ElectronicsIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ElectronicsIndustry">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/supplychain/SupplyChain/Industry"/>
        <rdfs:label>Electronics</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving the design, manufacturing, integration, operation, maintenance,
            distribution, or support of products, systems, equipment, or services associated with
            electronic systems, components, and technology-enabled products, and are intended to
            realize similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ElectropolishingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ElectropolishingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PolishingCapability"/>
        <rdfs:label>Electropolishing</rdfs:label>
        <skos:altLabel>Electrochemical Polishing</skos:altLabel>
        <skos:altLabel>Electrolytic Polishing</skos:altLabel>
        <skos:definition>A process where metal surfaces are polished and smoothed by anodic
            dissolution in a concentrated electrolyte solution to reduce surface roughness.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/EmailAddress -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/EmailAddress">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/VirtualLocationIdentifier"/>
        <rdfs:label xml:lang="en">email address</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/EmbeddedSystemsIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/EmbeddedSystemsIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ElectronicsIndustry"/>
        <rdfs:label>Embedded Systems</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving hardware, software, controllers, modules, and integrated systems
            used to provide computing and control functions within products or equipment, and are
            intended to realize similar or related primary business functions according to their
            organizational objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/EmbossingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/EmbossingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SheetMetalProcessingProcessingCapability"/>
        <rdfs:label>Embossing</rdfs:label>
        <skos:altLabel>Sheet Metal Embossing</skos:altLabel>
        <skos:definition>A process where a pattern is created on a material&apos;s surface by
            applying pressure, resulting in a raised or indented design.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/EndMillingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/EndMillingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/VerticalMillingCapability"/>
        <owl:disjointWith rdf:resource="http://asu.edu/semantics/SUDOKN/FaceMillingCapability"/>
        <rdfs:label>End Milling</rdfs:label>
        <skos:definition>A process that involves rotating a multi-tooth cutter to remove material
            from a workpiece along its axis, creating precise profiles and slots.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/EnergyIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/EnergyIndustry">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/supplychain/SupplyChain/Industry"/>
        <rdfs:label>Energy</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving the design, manufacturing, integration, operation, maintenance,
            distribution, or support of products, systems, equipment, or services associated with
            energy production, conversion, storage, transmission, and distribution, and are intended
            to realize similar or related primary business functions according to their
            organizational objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/EnergyStarCertificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/EnergyStarCertificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ProductComplianceCertificate"/>
        <rdfs:label>ENERGY STAR Certificate</rdfs:label>
        <skos:definition>A product compliance certificate confirming that a product, building, or
            facility satisfies specified energy efficiency requirements under the ENERGY STAR
            program.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/EnergyStorageIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/EnergyStorageIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/EnergyIndustry"/>
        <rdfs:label>Energy Storage</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving batteries, storage systems, power electronics, controls, materials,
            and support products used to store and manage energy, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/EngineeringCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/EngineeringCapability">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/supplychain/SupplyChain/ProductionCapability"/>
        <rdfs:label>engineering capability</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/EngineeringDesignCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/EngineeringDesignCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/EngineeringCapability"/>
        <rdfs:label>engineering design capability</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/EngravingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/EngravingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MachiningCapability"/>
        <rdfs:label>Engraving</rdfs:label>
        <skos:definition>A process where material is incised or carved to create designs, typically
            utilizing tools or lasers for precision and detail.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/EpoxyProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/EpoxyProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermosettProcessingCapability"/>
        <rdfs:label>Epoxy</rdfs:label>
        <skos:altLabel>Epoxy Resin</skos:altLabel>
        <skos:definition>The capability of a manufacturing system or machine to process epoxy, which
            is a thermosetting polymer or resin system valued for adhesion, chemical resistance,
            dimensional stability, and use in coatings, adhesives, composites, and encapsulation.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ErosionMachiningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ErosionMachiningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/UnconventionalMachiningCapability"/>
        <rdfs:label>Erosion Machining</rdfs:label>
        <skos:definition>A process where material is removed from a workpiece through controlled
            surface erosion using high-velocity fluid, typically water or oil.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ErtalyteProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ErtalyteProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermoplasticProcessingCapability"/>
        <rdfs:label>Ertalyte</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process Ertalyte,
            which is a PET-based engineering plastic valued for dimensional stability, wear
            resistance, and suitability for precision machined components.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/EtchingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/EtchingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ChemicalMachiningCapability"/>
        <rdfs:label>Etching</rdfs:label>
        <skos:definition>A process that utilizes chemical or plasma reactive ion techniques to
            remove material from a substrate, creating precise patterns in microfabrication.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ExoticMaterialProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ExoticMaterialProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MaterialProcessingCapability"/>
        <rdfs:label>Exotic Material</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process exotic
            materials, which are specialized materials with unusual physical, chemical, electronic,
            or mechanical properties that often require specialized manufacturing methods.</skos:definition>
        <skos:note>context-dependent label for materials that are advanced, rare, or hard to work
            with—not a formal materials class.</skos:note>
        <iof-av:usageNote>Do not add sub-classes under this class. specific materials that can be
            classified as &apos;exotic&apos; are placed under their prime material category.</iof-av:usageNote>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ExplosionFormingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ExplosionFormingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FormingCapability"/>
        <rdfs:label>Explosion Forming</rdfs:label>
        <skos:definition>A process where a controlled explosive charge deforms metal sheets into
            complex shapes by generating high-pressure shock waves in a containment chamber.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ExplosiveWeldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ExplosiveWeldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MechanicalWeldingCapability"/>
        <rdfs:label>Explosive Welding</rdfs:label>
        <skos:definition>A process where high-velocity explosives are used to bond two dissimilar
            metals together, creating a high-quality weld without heat or deformation.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ExportLicense -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ExportLicense">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RegulatoryLicense"/>
        <rdfs:label>Export License</rdfs:label>
        <skos:definition>A regulatory authorization permitting the export of specified goods,
            technologies, software, or services in accordance with applicable regulations.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ExtrudingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ExtrudingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FormingCapability"/>
        <rdfs:label>Extruding</rdfs:label>
        <skos:altLabel>Extrusion</skos:altLabel>
        <skos:definition>A process that involves forcing material through a die to create objects
            with a fixed cross-sectional profile.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ExtrusionBlowMoldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ExtrusionBlowMoldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/BlowMoldingCapability"/>
        <rdfs:label>Extrusion Blow Molding</rdfs:label>
        <skos:definition>A process where a heated plastic tube is inflated into a mold to form
            hollow objects, utilizing high pressure air in extrusion blow molding.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FAAPartsManufacturerApproval -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FAAPartsManufacturerApproval">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RegulatoryApproval"/>
        <rdfs:comment>Regulatory authority: United States Federal Aviation Administration (FAA). Typical industry: Aerospace parts and component manufacturing.</rdfs:comment>
        <rdfs:label>FAA Parts Manufacturer Approval</rdfs:label>
        <skos:altLabel>FAA PMA</skos:altLabel>
        <skos:altLabel>Parts Manufacturer Approval</skos:altLabel>
        <skos:definition>A combined design and production approval issued by the United States Federal Aviation Administration authorizing a manufacturer to produce and sell specified modification or replacement articles for installation on type-certificated aviation products.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FAAProductionCertificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FAAProductionCertificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RegulatoryApproval"/>
        <rdfs:comment>Regulatory authority: United States Federal Aviation Administration (FAA). Typical industry: Aerospace and aviation manufacturing.</rdfs:comment>
        <rdfs:label>FAA Production Certificate</rdfs:label>
        <skos:altLabel>FAA Production Approval</skos:altLabel>
        <skos:definition>A regulatory approval issued by the United States Federal Aviation Administration authorizing an organization to manufacture duplicate aircraft, aircraft engines, or propellers in conformity with an FAA-approved type design and an approved production quality system.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FAARepairStationCertificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FAARepairStationCertificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RegulatoryApproval"/>
        <rdfs:label>FAA Repair Station Certificate</rdfs:label>
        <skos:altLabel>FAA Part 145 Repair Station Certificate</skos:altLabel>
        <skos:altLabel>Repair Station Operator (Part 145)</skos:altLabel>
        <skos:definition>A regulatory approval issued by the United States Federal Aviation Administration (FAA) confirming that an organization has demonstrated compliance with the requirements of 14 CFR Part 145 and is authorized to perform specified maintenance, preventive maintenance, alterations, and inspections on aircraft, aircraft engines, propellers, appliances, or component parts.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FAASupplementalTypeCertificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FAASupplementalTypeCertificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RegulatoryApproval"/>
        <rdfs:comment>Regulatory authority: United States Federal Aviation Administration (FAA). Typical industry: Aerospace modification, maintenance, repair, and manufacturing.</rdfs:comment>
        <rdfs:label>FAA Supplemental Type Certificate</rdfs:label>
        <skos:altLabel>FAA STC</skos:altLabel>
        <skos:altLabel>Supplemental Type Certificate</skos:altLabel>
        <skos:definition>A regulatory approval issued by the United States Federal Aviation Administration approving a major modification to the type design of an aircraft, aircraft engine, or propeller and specifying how the modification affects the original approved design.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FAATypeCertificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FAATypeCertificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RegulatoryApproval"/>
        <rdfs:comment>Regulatory authority: United States Federal Aviation Administration (FAA). Typical industry: Aerospace and aviation design and manufacturing.</rdfs:comment>
        <rdfs:label>FAA Type Certificate</rdfs:label>
        <skos:altLabel>FAA TC</skos:altLabel>
        <skos:altLabel>Type Certificate</skos:altLabel>
        <skos:definition>A regulatory approval issued by the United States Federal Aviation Administration confirming that the type design of an aircraft, aircraft engine, or propeller complies with applicable airworthiness and environmental requirements.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FDA510kClearance -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FDA510kClearance">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RegulatoryClearance"/>
        <rdfs:label>FDA 510(k) Clearance</rdfs:label>
        <skos:altLabel>FDA 510(k)</skos:altLabel>
        <skos:definition>A regulatory clearance issued by the FDA confirming that a medical device
            is substantially equivalent to a legally marketed predicate device.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FDAApproval -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FDAApproval">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RegulatoryApproval"/>
        <rdfs:label>FDA Approved</rdfs:label>
        <skos:definition>A regulatory approval issued by the FDA confirming that a product has satisfied applicable safety, effectiveness, and regulatory requirements for market authorization.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FDAGMPCertificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FDAGMPCertificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/QualityCertificate"/>
        <rdfs:label xml:lang="en">FDA GMP</rdfs:label>
        <skos:altLabel>FDA GMP Certificate</skos:altLabel>
        <skos:altLabel>FDA cGMP Certificate</skos:altLabel>
        <skos:altLabel>GMP</skos:altLabel>
        <skos:definition>A confirmation that an organization has demonstrated conformance to
            applicable FDA Good Manufacturing Practice requirements.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FDAPMACertificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FDAPMACertificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RegulatoryApproval"/>
        <rdfs:label xml:lang="en">FDA PMA</rdfs:label>
        <skos:definition>A regulatory approval issued by the FDA confirming that a medical device has demonstrated reasonable assurance of safety and effectiveness through the Premarket Approval process.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FDARegistration -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FDARegistration">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RegulatoryRegistration"/>
        <rdfs:label>FDA Registration</rdfs:label>
        <skos:definition>A confirmation that an organization, facility, product, or establishment
            has been registered with the FDA in accordance with applicable regulatory requirements.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FSCCertificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FSCCertificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ProductComplianceCertificate"/>
        <rdfs:label>FSC Certificate</rdfs:label>
        <skos:altLabel>Forest Stewardship Council Certificate</skos:altLabel>
        <skos:definition>A product compliance certificate confirming conformance to Forest
            Stewardship Council requirements for responsible sourcing and chain of custody.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FabricatingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FabricatingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ManufacturingProcessCapability"/>
        <rdfs:label xml:lang="en">Fabricating</rdfs:label>
        <skos:altLabel>Metal Fabrication</skos:altLabel>
        <skos:definition>A process that involves cutting, shaping, and assembling components to
            create finished products from raw or semi-finished materials.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FaceMillingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FaceMillingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/VerticalMillingCapability"/>
        <rdfs:label>Face Milling</rdfs:label>
        <skos:definition>A process where a rotating cutter with multiple cutting edges removes
            material from a workpiece to create a flat surface perpendicular to the tool axis.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/Facing_Capability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/Facing_Capability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/TurningCapability"/>
        <rdfs:label>Facing</rdfs:label>
        <skos:definition>A process where a cutting tool machines the end of a rotating workpiece to
            create a flat surface, typically performed on a lathe.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FairTradeCertificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FairTradeCertificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ProductComplianceCertificate"/>
        <rdfs:label>Fair Trade Certificate</rdfs:label>
        <skos:definition>A product compliance certificate confirming conformance to specified fair
            trade requirements governing ethical sourcing and production practices.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FashionProductsIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FashionProductsIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/TextilesAndApparelIndustry"/>
        <rdfs:label>Fashion Products</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving apparel, accessories, textiles, components, and products intended
            for fashion-oriented consumer markets, and are intended to realize similar or related
            primary business functions according to their organizational objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FerrousAlloyProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FerrousAlloyProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AlloyProcessingCapability"/>
        <rdfs:label>Ferrous Alloy</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process ferrous
            alloys, which are iron-based alloys widely used for their strength, durability, magnetic
            properties, and versatility in structural and industrial applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FerrousMetalProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FerrousMetalProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PureMetalProcessingCapability"/>
        <owl:disjointWith rdf:resource="http://asu.edu/semantics/SUDOKN/Non-FerrousMetalProcessingCapability"/>
        <rdfs:label>Ferrous Metal</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process ferrous
            metals, which are iron-based metallic materials and are commonly used for strength,
            magnetic properties, and structural performance.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/Fiber-ReinforcedCompositeProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/Fiber-ReinforcedCompositeProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CompositeProcessingCapability"/>
        <rdfs:label>Fiber-Reinforced Composite</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process
            fiber-reinforced composites, which combine reinforcing fibers with a matrix material to
            provide improved strength, stiffness, fatigue resistance, or weight reduction.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FiberGlassProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FiberGlassProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Fiber-ReinforcedCompositeProcessingCapability"/>
        <rdfs:label>Fiber Glass</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process fiberglass,
            which is a fiber-reinforced composite material made with glass fibers embedded in a
            polymer or resin matrix.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FiberOpticsIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FiberOpticsIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/TelecommunicationsIndustry"/>
        <rdfs:label>Fiber Optics</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving optical fibers, cables, connectors, transceivers, equipment, and
            systems used in optical communication networks, and are intended to realize similar or
            related primary business functions according to their organizational objectives and
            plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FiberProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FiberProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MaterialProcessingCapability"/>
        <rdfs:label xml:lang="en">Fiber</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process fibrous
            materials, which consist of elongated filaments or strands used for reinforcement,
            textiles, filtration, insulation, or structural applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FilamentWindingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FilamentWindingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CompositeManufacturingCapability"/>
        <rdfs:label>Filament Winding</rdfs:label>
        <skos:definition>A process where continuous fibers are wound under tension onto a rotating
            mandrel to create composite structures with high strength-to-weight ratios.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FineBlankingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FineBlankingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/StampingCapability"/>
        <rdfs:label>Fine Blanking</rdfs:label>
        <skos:definition>A process that produces precise, smooth-edged components by shearing
            material between a punch and die with high pressure and minimal clearance.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FirewallsProductCategory -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FirewallsProductCategory">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Networking%20EquipmentProductCategory"/>
        <rdfs:label xml:lang="en">Firewalls</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FirmwareProductCategory -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FirmwareProductCategory">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SoftwareProductCategory"/>
        <rdfs:label xml:lang="en">Firmware</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FixtureDesignCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FixtureDesignCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ToolDesignCapability"/>
        <rdfs:label>fixture design capability</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FlameHardeningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FlameHardeningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SurfaceHardeningCapability"/>
        <rdfs:label>Flame Hardening</rdfs:label>
        <skos:definition>A process where heat from a high-temperature flame is applied to a metal
            surface, followed by rapid cooling, to increase its hardness and wear resistance.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FlameSprayingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FlameSprayingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermalSprayCoatingCapability"/>
        <rdfs:label>Flame Spraying</rdfs:label>
        <skos:definition>A process where a heat source melts a coating material, which is then
            sprayed onto a surface to form a protective or decorative layer.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FlangingEDMCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FlangingEDMCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/EDMCapability"/>
        <rdfs:label>Flanging EDM</rdfs:label>
        <skos:definition>A process where controlled electrical discharges remove material from a
            workpiece, creating precise flanges via erosion in Electrical Discharge Machining (EDM).</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FlatRollingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FlatRollingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RollingCapability"/>
        <rdfs:label>Flat Rolling</rdfs:label>
        <skos:definition>A process where metal slabs are compressed between rotaxting rolls to
            reduce thickness and achieve uniform cross-sectional dimensions.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FlexiblePackagingIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FlexiblePackagingIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PackagingIndustry"/>
        <rdfs:label>Flexible Packaging</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving films, pouches, bags, wraps, labels, materials, and equipment used
            to package products with flexible packaging formats, and are intended to realize similar
            or related primary business functions according to their organizational objectives and
            plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FlowDrillingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FlowDrillingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/DrillingCapability"/>
        <rdfs:label>Flow Drilling</rdfs:label>
        <skos:definition>A process where a rotating conical tool generates frictional heat to form
            holes and bushings in thin-walled materials without producing chips.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FlowFormingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FlowFormingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FormingCapability"/>
        <rdfs:label>Flow Forming</rdfs:label>
        <skos:definition>A process where a rotating metal blank is axially compressed and elongated
            by rollers to form precise cylindrical components with enhanced mechanical properties.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FluxCoredArcWeldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FluxCoredArcWeldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ElectricArcWeldingCapability"/>
        <rdfs:label>Flux-Cored Arc Welding</rdfs:label>
        <skos:altLabel>FCAW Welding</skos:altLabel>
        <skos:definition>A process where a continuous tubular wire filled with flux is used to
            create an electric arc, resulting in a weld.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FoamProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FoamProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MaterialProcessingCapability"/>
        <rdfs:label xml:lang="en">Foam</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process foam
            materials, which contain a cellular structure of gas-filled pores that provide low
            density, thermal insulation, cushioning, buoyancy, or energy absorption properties.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FoodAndBeverageIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FoodAndBeverageIndustry">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/supplychain/SupplyChain/Industry"/>
        <rdfs:label>Food and Beverage</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving the design, manufacturing, integration, operation, maintenance,
            distribution, or support of products, systems, equipment, or services associated with
            food and beverage products intended for human or animal consumption, and are intended to
            realize similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FoodPackagingIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FoodPackagingIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FoodAndBeverageIndustry"/>
        <rdfs:label>Food Packaging</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving packaging materials, containers, closures, labeling, and equipment
            used to package or protect food and beverage products, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FoodProcessingIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FoodProcessingIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FoodAndBeverageIndustry"/>
        <rdfs:label>Food Processing</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving equipment, materials, packaging, systems, and services used to
            transform, prepare, preserve, or handle food products, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FootwearIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FootwearIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/TextilesAndApparelIndustry"/>
        <rdfs:label>Footwear</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving shoes, boots, components, materials, and manufacturing services used
            in footwear products, and are intended to realize similar or related primary business
            functions according to their organizational objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ForgingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ForgingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FormativeManufacturingCapability"/>
        <rdfs:label>Forging</rdfs:label>
        <skos:definition>A process where metal is heated and deformed under high pressure to produce
            stronger, more durable parts with improved microstructure.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FormativeManufacturingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FormativeManufacturingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ManufacturingProcessCapability"/>
        <rdfs:label>Formative Manufacturing</rdfs:label>
        <skos:definition>A manufacturing processe where material is shaped into a desired geometry
            through deformation, molding, casting, or other forming operations.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FormingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FormingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FormativeManufacturingCapability"/>
        <rdfs:label>Forming</rdfs:label>
        <skos:definition>A process where materials are deformed or reshaped without adding or
            removing material, typically involving bending, stretching, or compressing.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FractionalTubingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FractionalTubingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/TubingCapability"/>
        <rdfs:label>Fractional Tubing</rdfs:label>
        <skos:definition>A process where tubing is produced in precise, small diameters and tight
            tolerances, typically through extrusion or drawing methods.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FreightRailIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FreightRailIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RailAndTransitIndustry"/>
        <rdfs:label>Freight Rail</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving railcars, locomotives, components, equipment, and services used to
            move goods by rail, and are intended to realize similar or related primary business
            functions according to their organizational objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FrictionDrillingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FrictionDrillingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/DrillingCapability"/>
        <rdfs:label>Friction Drilling</rdfs:label>
        <skos:definition>A process where a rotating conical tool generates heat through friction to
            penetrate and form holes in metal without producing chips.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FrictionStirWeldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FrictionStirWeldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FrictionWeldingCapability"/>
        <rdfs:label>Friction Stir Welding</rdfs:label>
        <skos:definition>A process where a rotating tool generates frictional heat to join materials
            without melting, creating a solid-state weld with improved mechanical properties.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FrictionWeldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FrictionWeldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MechanicalWeldingCapability"/>
        <rdfs:label>Friction Welding</rdfs:label>
        <skos:definition>A process where heat generated from mechanical friction between workpieces,
            combined with a force to press them together, creates a solid-state weld.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FullAnnealingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FullAnnealingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RecrystallizationCapability"/>
        <rdfs:label>Full Annealing</rdfs:label>
        <skos:definition>A process where a metal is heated to a specific temperature, held, then
            cooled slowly to relieve internal stresses and improve ductility and toughness.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FurnaceBrazingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FurnaceBrazingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/BrazingCapability"/>
        <rdfs:label>Furnace Brazing</rdfs:label>
        <skos:definition>A process where metals are joined by melting a filler metal between work
            pieces in a controlled atmosphere furnace, creating a strong, high-temperature resistant
            bond.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FurnitureIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FurnitureIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ConsumerProductsIndustry"/>
        <rdfs:label>Furniture</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving furniture products, components, materials, hardware, and support
            products used in residential, commercial, or institutional settings, and are intended to
            realize similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FusedDepositionModelingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FusedDepositionModelingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AdditiveManufacturingCapability"/>
        <rdfs:label>Fused Deposition Modeling</rdfs:label>
        <skos:definition>The process where a thermoplastic filament is melted and extruded through a
            nozzle to build objects layer by layer.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FusedFilamentFabricationCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FusedFilamentFabricationCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FusedDepositionModelingCapability"/>
        <rdfs:label>Fused Filament Fabrication</rdfs:label>
        <skos:definition>A process where thermoplastic filament is extruded layer-by-layer through a
            heated nozzle to create three-dimensional objects based on digital models.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FusedNitrateConversionCoatingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FusedNitrateConversionCoatingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ChemicalConversionCoatingCapability"/>
        <rdfs:label>Fused Nitrate Conversion Coating</rdfs:label>
        <skos:definition>A process where nitrate salts are fused onto a metal surface to form a
            protective, corrosion-resistant conversion coating.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FusedSilicaProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FusedSilicaProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/GlassProcessingCapability"/>
        <rdfs:label>Fused Silica</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process fused
            silica, which is a high-purity amorphous silicon dioxide glass valued for optical
            clarity, low thermal expansion, and high temperature resistance.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FusionJoiningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FusionJoiningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/JoiningCapability"/>
        <rdfs:label>Fusion Joining</rdfs:label>
        <skos:definition>A process where materials are joined by melting interfaces, allowing them
            to cool and solidify, forming a continuous bond without additional adhesives.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/FusionWeldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/FusionWeldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermalWeldingCapability"/>
        <rdfs:label>Fusion Welding</rdfs:label>
        <skos:definition>A process where materials are joined by melting interfaces, forming a joint
            upon solidification, often utilizing heat from an electric arc or laser.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/GWOBasicSafetyTrainingCertificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/GWOBasicSafetyTrainingCertificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/GWOCertificate"/>
        <owl:disjointWith rdf:resource="http://asu.edu/semantics/SUDOKN/GWOBasicTechnicalTrainingCertificate"/>
        <rdfs:label>GWO Basic Safety Training Certificate</rdfs:label>
        <skos:altLabel>GWO BST Certificate</skos:altLabel>
        <skos:definition>A professional certificate confirming completion of Global Wind
            Organisation Basic Safety Training requirements.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/GWOBasicTechnicalTrainingCertificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/GWOBasicTechnicalTrainingCertificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/GWOCertificate"/>
        <rdfs:label>GWO Basic Technical Training Certificate</rdfs:label>
        <skos:altLabel>GWO BTT Certificate</skos:altLabel>
        <skos:definition>A professional certificate confirming completion of Global Wind
            Organisation Basic Technical Training requirements.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/GWOCertificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/GWOCertificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ProfessionalCertificate"/>
        <rdfs:label xml:lang="en">GWO</rdfs:label>
        <skos:definition>A professional certificate confirming that a person has demonstrated
            specified safety or technical competencies in accordance with Global Wind Organisation
            standards.</skos:definition>
        <iof-av:directSource xml:lang="en">
            https://www.globalwindsafety.org/trainingstandards/trainingstandards</iof-av:directSource>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/GalvanizedSteelProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/GalvanizedSteelProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SteelProcessingCapability"/>
        <rdfs:label>Galvanized Steel</rdfs:label>
        <skos:altLabel>Zinc Coated Steel</skos:altLabel>
        <skos:definition>The capability of a manufacturing system or machine to process galvanized
            steel, which is steel coated with zinc to improve corrosion resistance in structural,
            sheet metal, and outdoor applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/GalvanizingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/GalvanizingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CoatingCapability"/>
        <rdfs:label>Galvanizing</rdfs:label>
        <skos:altLabel>Galvanization</skos:altLabel>
        <skos:definition>A process where a protective zinc coating is applied to steel or iron to
            prevent rusting and corrosion.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/GasBrazingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/GasBrazingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/BrazeWeldingCapability"/>
        <rdfs:label>Gas Brazing</rdfs:label>
        <skos:definition>A process where filler metal is heated above melting point and distributed
            between two or more close-fitting parts by capillary action to join them.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/GasMetalArcWeldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/GasMetalArcWeldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ElectricArcWeldingCapability"/>
        <rdfs:label>Gas Metal Arc Welding</rdfs:label>
        <skos:altLabel>GMAW</skos:altLabel>
        <skos:definition>A process where an electric arc forms between a consumable wire electrode
            and the workpiece metal, heating both to create a weld pool.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/GasTungstenArcWeldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/GasTungstenArcWeldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ElectricArcWeldingCapability"/>
        <rdfs:label>Gas Tungsten Arc Welding</rdfs:label>
        <skos:altLabel>GTAW</skos:altLabel>
        <skos:definition>A process where an electric arc is formed between a tungsten electrode and
            the workpiece to create a weld using inert gas as a shield.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/GasWeldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/GasWeldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermalWeldingCapability"/>
        <rdfs:label>Gas Welding</rdfs:label>
        <skos:definition>A process where heat from a gas flame, typically oxy-acetylene, is used to
            melt interface surfaces, creating a joint upon cooling.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/GearCuttingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/GearCuttingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MultipointCuttingCapability"/>
        <rdfs:label>Gear Cutting</rdfs:label>
        <skos:definition>A process that involves the use of specialized tools to create precise,
            interlocking teeth on a gear wheel for mechanical transmission systems.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/GearGashingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/GearGashingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MillingCapability"/>
        <rdfs:label>Gear Gashing</rdfs:label>
        <skos:definition>A process where large, rapid material removal from a gear blank is
            performed using a multi-tooth cutting tool, known as a gash cutter.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/GearHobbingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/GearHobbingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MultipointCuttingCapability"/>
        <rdfs:label>Gear Hobbing</rdfs:label>
        <skos:definition>A process where a specialized hobbing machine cuts teeth into a blank gear,
            utilizing continuous, synchronized rotations between the gear and the cutting tool.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/GeopoliticalSite -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/GeopoliticalSite">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000029"/>
        <rdfs:label xml:lang="en">Geopolitical Site</rdfs:label>
        <iof-av:naturalLanguageDefinition>site that delimits the authority of a formally constituted
            Government to exercise its control within the bounded area.</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/GeospatialLocation -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/GeospatialLocation">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:subClassOf rdf:resource="https://schema.org/Place"/>
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/supplychain/SupplyChain/GeospatialLocation"/>
        <rdfs:label xml:lang="en">SUDOKN Geospatial Location</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/GeothermalEnergyIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/GeothermalEnergyIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/EnergyIndustry"/>
        <rdfs:label>Geothermal Energy</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving equipment, components, materials, and services used to extract,
            convert, or support energy from geothermal resources, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/GlassFilledLiquidCrystalPolymerProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/GlassFilledLiquidCrystalPolymerProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CompositeProcessingCapability"/>
        <rdfs:label>Glass Filled Liquid Crystal Polymer</rdfs:label>
        <skos:altLabel>Glass Filled LCP</skos:altLabel>
        <skos:altLabel>Glass Reinforced LCP</skos:altLabel>
        <skos:definition>The capability of a manufacturing system or machine to process glass-filled
            liquid crystal polymer, which is a reinforced engineering thermoplastic containing glass
            fibers or fillers to improve stiffness, dimensional stability, and heat resistance.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/GlassProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/GlassProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CeramicProcessingCapability"/>
        <rdfs:label xml:lang="en">Glass</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process glass
            materials, which are amorphous inorganic solids typically characterized by transparency,
            chemical resistance, hardness, and dimensional stability.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/GoldPlatingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/GoldPlatingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ElectroPlatingCapability"/>
        <rdfs:label>Gold Plating</rdfs:label>
        <skos:definition>A process where a thin layer of gold is electrochemically deposited onto a
            substrate for enhanced conductivity, corrosion resistance, and aesthetic appeal.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/GraphiteProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/GraphiteProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CarbonProcessingCapability"/>
        <rdfs:label>Graphite</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process graphite,
            which is a crystalline carbon material valued for lubricity, thermal stability,
            electrical conductivity, and use in electrodes, molds, seals, and high-temperature
            components.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/GravityCastingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/GravityCastingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CastingCapability"/>
        <rdfs:label>Gravity Casting</rdfs:label>
        <skos:definition>A process where molten metal is poured into a mold and uses gravity to fill
            the cavities, solidifying into the final product.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/GrayCastIronProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/GrayCastIronProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CastIronProcessingCapability"/>
        <rdfs:label>Gray Cast Iron</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process gray cast
            iron, which is cast iron containing flake graphite and valued for castability, vibration
            damping, machinability, and compressive strength.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/GrindingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/GrindingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AbrassiveMachiningCapability"/>
        <rdfs:label>Grinding</rdfs:label>
        <skos:definition>A process where material is reduced to a fine powder or sharp edges are
            smoothed through friction and abrasion, typically using a grinding wheel or machine.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/GritBlastingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/GritBlastingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SandBlastingCapability"/>
        <rdfs:label>Grit Blasting</rdfs:label>
        <skos:definition>A process where high-pressure air blasts small particles against a surface
            to remove contaminants, roughen, or smooth it for subsequent operations.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/GroundDefenseSystemsIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/GroundDefenseSystemsIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/DefenseIndustry"/>
        <rdfs:label>Ground Defense Systems</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving vehicles, equipment, weapons, sensors, protective systems, and
            support products used in land-based military operations, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/GunDrillingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/GunDrillingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/DeepHoleDrillingCapability"/>
        <rdfs:label>Gun Drilling</rdfs:label>
        <skos:definition>A process where deep, straight holes are drilled into a material using a
            high-speed, high-feed rate, single-flute drill bit.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/HACCPCertificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/HACCPCertificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/QualityCertificate"/>
        <rdfs:label xml:lang="en">HACCP</rdfs:label>
        <skos:definition>A quality certificate confirming implementation of a Hazard Analysis and
            Critical Control Points system for food safety management.</skos:definition>
        <iof-av:directSource xml:lang="en">https://ehaccp.org/certification/</iof-av:directSource>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/HDPEProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/HDPEProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermoplasticProcessingCapability"/>
        <rdfs:label>HDPE</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process high-density
            polyethylene, which is a tough, chemically resistant thermoplastic used in containers,
            piping, sheets, and wear-resistant components.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/HUBZone -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/HUBZone">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/OwnershipStatusClassifier"/>
        <rdfs:label xml:lang="en">HUBZone</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/HandLayupCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/HandLayupCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CompositeManufacturingCapability"/>
        <rdfs:label>Hand Layup</rdfs:label>
        <skos:definition>A composite manufacturing process where reinforcement fibers are manually
            placed in a mold and impregnated with resin to form a composite part.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/HardeningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/HardeningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/HeatTreatingCapability"/>
        <rdfs:label>Hardening</rdfs:label>
        <skos:definition>A process that involves heating a material, typically metal, to a specific
            temperature and then cooling it rapidly to increase its hardness and strength.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/HarperizingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/HarperizingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SurfacePreparationCapability"/>
        <rdfs:label>Harperizing</rdfs:label>
        <skos:definition>A process where metal parts are polished and deburred by tumbling in a
            mixture of ceramic media and water under high gravitational forces.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/HastelloyProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/HastelloyProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/NickelAlloyProcessingCapability"/>
        <rdfs:label>Hastelloy</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process Hastelloy,
            which is a family of nickel-based corrosion-resistant alloys used in chemical
            processing, marine, and high-temperature environments.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/HaynesProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/HaynesProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/NickelAlloyProcessingCapability"/>
        <rdfs:label>Haynes</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process Haynes
            alloys, which are high-performance nickel- or cobalt-based alloys used for heat
            resistance, oxidation resistance, and strength in demanding environments.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/HeadingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/HeadingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/OpenDieForgingCapability"/>
        <rdfs:label>Heading</rdfs:label>
        <skos:definition>A process where metal is plastically deformed using dies and punches to
            form heads on fasteners like bolts and screws.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/HealthcareAndMedicalDevicesIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/HealthcareAndMedicalDevicesIndustry">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/supplychain/SupplyChain/Industry"/>
        <rdfs:label>Healthcare and Medical Devices</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving the design, manufacturing, integration, operation, maintenance,
            distribution, or support of products, systems, equipment, or services associated with
            healthcare delivery, medical technologies, and patient-support products, and are
            intended to realize similar or related primary business functions according to their
            organizational objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/HealthcareEquipmentIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/HealthcareEquipmentIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/HealthcareAndMedicalDevicesIndustry"/>
        <rdfs:label>Healthcare Equipment</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving equipment, furniture, systems, devices, and support products used in
            hospitals, clinics, laboratories, and care-delivery environments, and are intended to
            realize similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/HeatSealingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/HeatSealingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/JoiningCapability"/>
        <rdfs:label>Heat Sealing</rdfs:label>
        <skos:definition>A process where heat and pressure are applied to thermoplastic materials to
            create a bond, forming a sealed joint between surfaces.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/HeatTreatingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/HeatTreatingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ManufacturingProcessCapability"/>
        <rdfs:label>Heat Treating</rdfs:label>
        <skos:definition>A process where metals are heated and cooled under controlled conditions to
            alter their physical and mechanical properties, without changing the product shape.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/HeavyEquipmentIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/HeavyEquipmentIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ConstructionAndInfrastructureIndustry"/>
        <rdfs:label>Heavy Equipment</rdfs:label>
        <skos:altLabel>Construction Equipment</skos:altLabel>
        <skos:altLabel>Earthmoving Equipment</skos:altLabel>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving construction machinery, earthmoving equipment, lifting equipment,
            attachments, and related components used in infrastructure and construction operations,
            and are intended to realize similar or related primary business functions according to
            their organizational objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/HemmingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/HemmingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SheetMetalProcessingProcessingCapability"/>
        <rdfs:label>Hemming</rdfs:label>
        <skos:definition>A process where sheet metal edges are folded over onto themselves to
            enhance strength, eliminate sharp edges, and improve aesthetic appearance.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/HighAlloySteelProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/HighAlloySteelProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AlloySteelProcessingCapability"/>
        <rdfs:label>High Alloy Steel</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process high-alloy
            steel, which is steel containing relatively high levels of alloying elements to achieve
            enhanced corrosion resistance, heat resistance, strength, or specialized performance.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/HighEnergyBeamMachiningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/HighEnergyBeamMachiningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermalSubtractionCapability"/>
        <rdfs:label>High Energy Beam Machining</rdfs:label>
        <skos:definition>A process where focused high-energy beams, such as lasers or electron
            beams, are used to cut or drill materials with precision.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/HighEnergyBeamWeldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/HighEnergyBeamWeldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermalWeldingCapability"/>
        <rdfs:label>High Energy Beam Welding</rdfs:label>
        <skos:definition>A process where high-energy beams, such as lasers or electron beams, are
            used to melt and fuse materials together, creating a weld.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/HighSpeedMetalCuttingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/HighSpeedMetalCuttingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ConventionalMachiningCapability"/>
        <rdfs:label>High Speed Metal Cutting</rdfs:label>
        <skos:definition>A process where metals are machined at very high cutting speeds to improve
            productivity, surface finish, and dimensional accuracy.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/HobbingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/HobbingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MultipointCuttingCapability"/>
        <rdfs:label>Hobbing</rdfs:label>
        <skos:definition>A process where a rotating hob cuts teeth into a workpiece, typically for
            gears or splines, using synchronized rotational movements.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/HoleDrillingEDMCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/HoleDrillingEDMCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/EDMCapability"/>
        <rdfs:label>Hole Drilling EDM</rdfs:label>
        <skos:definition>A process that utilizes electrical discharges to create precise holes in a
            workpiece using a rotating conductive tube as an electrode.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/HoleMakingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/HoleMakingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MultipointCuttingCapability"/>
        <rdfs:label>Hole Making</rdfs:label>
        <skos:definition>A process where specific tools, such as drills or punches, are used to
            create precise holes in a workpiece for assembly or operational purposes.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/HoningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/HoningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AbrassiveMachiningCapability"/>
        <rdfs:label>Honing</rdfs:label>
        <skos:definition>A process where abrasive stones are used to refine surface finish and
            geometry of a workpiece, typically in bore or cylinder applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/HorizontalBoringCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/HorizontalBoringCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/BoringCapability"/>
        <rdfs:label>Horizontal Boring</rdfs:label>
        <skos:definition>A process where a horizontal boring machine drills holes into workpieces,
            typically large, heavy materials, with precision and accuracy.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/HorizontalMillingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/HorizontalMillingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MillingCapability"/>
        <owl:disjointWith rdf:resource="http://asu.edu/semantics/SUDOKN/VerticalMillingCapability"/>
        <rdfs:label>Horizontal Milling</rdfs:label>
        <skos:definition>A process where a horizontally oriented spindle performs multi-axis
            machining on a workpiece using a rotary cutter.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/HotChamberDieCastingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/HotChamberDieCastingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/DieCastingCapability"/>
        <rdfs:label>Hot Chamber Die Casting</rdfs:label>
        <skos:definition>A metal casting process where the injection system is submerged in a
            furnace containing molten metal.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/HotExtrusionCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/HotExtrusionCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ExtrudingCapability"/>
        <rdfs:label>Hot Extrusion</rdfs:label>
        <skos:definition>A process where heated material is forced through a die to produce
            continuous cross-sectional profiles, enhancing ductility and reducing required forming
            force.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/HotFormingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/HotFormingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FormingCapability"/>
        <rdfs:label>Hot Forming</rdfs:label>
        <skos:definition>A process where metal is heated above recrystallization temperature and
            deformed to enhance ductility and reduce work hardening for complex geometries.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/HotIsostaticCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/HotIsostaticCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/HotVacuumPressingCapability"/>
        <rdfs:label>Hot Isostatic</rdfs:label>
        <skos:definition>A process where materials are subjected to high temperature and isostatic
            gas pressure to eliminate porosity and improve mechanical properties.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/HotRollingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/HotRollingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RollingCapability"/>
        <rdfs:label>Hot Rolling</rdfs:label>
        <skos:definition>A process where metal is heated above recrystallization temperature and
            passed through rollers to reduce thickness and alter mechanical properties.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/HotSpinningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/HotSpinningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SpinningCapability"/>
        <rdfs:label>Hot Spinning</rdfs:label>
        <skos:definition>A process where a heated metal blank is rotated and formed over a mandrel
            using a roller to produce axisymmetric components.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/HotStampingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/HotStampingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/StampingCapability"/>
        <rdfs:label>Hot Stamping</rdfs:label>
        <skos:definition>A process where heated dies press metallic foils onto substrates, creating
            permanent designs through pressure and temperature-induced adhesion.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/HotVacuumPressingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/HotVacuumPressingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/VacuumPressingCapability"/>
        <rdfs:label>Hot Vacuum Pressing</rdfs:label>
        <skos:definition>A process where materials are heated and compressed in a vacuum environment
            to reduce porosity and increase density, enhancing mechanical properties.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/HotWorkingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/HotWorkingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ProcessAnnealingCapability"/>
        <rdfs:label>Hot Working</rdfs:label>
        <skos:definition>A process where metals are plastically deformed above their
            recrystallization temperature, enhancing ductility and reducing work hardening for
            improved mechanical properties.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/HouseholdProductsIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/HouseholdProductsIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ConsumerProductsIndustry"/>
        <rdfs:label>Household Products</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving products, components, materials, and packaging intended for use in
            homes and domestic environments, and are intended to realize similar or related primary
            business functions according to their organizational objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/HydroelectricEnergyIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/HydroelectricEnergyIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/EnergyIndustry"/>
        <rdfs:label>Hydroelectric Energy</rdfs:label>
        <skos:altLabel>Hydropower</skos:altLabel>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving turbines, generators, controls, structures, and support products
            used to generate power from flowing or stored water, and are intended to realize similar
            or related primary business functions according to their organizational objectives and
            plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/HydroformingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/HydroformingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FormingCapability"/>
        <rdfs:label>Hydroforming</rdfs:label>
        <skos:definition>A process where high-pressure hydraulic fluid shapes ductile metals into
            complex geometries within a die, enhancing structural integrity and material efficiency.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/HypodermicTubingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/HypodermicTubingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/TubingCapability"/>
        <rdfs:label>Hypodermic Tubing</rdfs:label>
        <skos:definition>A process where stainless steel is drawn into thin-walled tubes, typically
            for use in medical or industrial applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/IATF16949Certificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/IATF16949Certificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/IATFCertificate"/>
        <rdfs:comment>the global, industry-standard Quality Management System (QMS) for the
            automotive supply chain. Developed by the International Automotive Task Force (IATF), it
            builds upon ISO 9001 to emphasize defect prevention, variance reduction, and waste
            minimization across automotive design, production, and service</rdfs:comment>
        <rdfs:label>IATF 16949</rdfs:label>
        <skos:definition>IATF 16949 is the global, industry-standard Quality Management System (QMS)
            for the automotive supply chain.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/IATFCertificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/IATFCertificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/QualityCertificate"/>
        <rdfs:label>IATF</rdfs:label>
        <skos:definition>A quality certificate confirming conformance to requirements established by
            the International Automotive Task Force.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/IDODGrindingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/IDODGrindingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/GrindingCapability"/>
        <rdfs:label>ID-OD Grinding</rdfs:label>
        <skos:altLabel>ID/OD Grinding</skos:altLabel>
        <skos:definition>A process where internal and external diameters of a workpiece are ground
            to precise dimensions using a rotating grinding wheel.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ISO-IEC17025LaboratoryAccreditation -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ISO-IEC17025LaboratoryAccreditation">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/A2LAAccreditation"/>
        <rdfs:label>ISO/IEC 17025 Laboratory Accreditation</rdfs:label>
        <skos:definition>An accreditation confirming the technical competence of a testing or
            calibration laboratory in accordance with ISO/IEC 17025.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ISO13485Certificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ISO13485Certificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ISOQualityCertificate"/>
        <rdfs:label xml:lang="en">ISO 13485</rdfs:label>
        <skos:definition>A quality certificate confirming conformance to ISO 13485 requirements for
            medical device quality management systems.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ISO14000Certificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ISO14000Certificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ISOQualityCertificate"/>
        <rdfs:label xml:lang="en">ISO 14000</rdfs:label>
        <skos:definition>A certificate confirming conformance to requirements within the ISO 14000
            family of environmental management standards.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ISO14001Certificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ISO14001Certificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ISOQualityCertificate"/>
        <rdfs:label xml:lang="en">ISO 14001</rdfs:label>
        <skos:definition>A certificate confirming conformance to ISO 14001 environmental management
            system requirements.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ISO16949Certificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ISO16949Certificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ISOQualityCertificate"/>
        <rdfs:label xml:lang="en">ISO 16949</rdfs:label>
        <skos:definition>A quality certificate confirming conformance to ISO/TS 16949 automotive
            quality management requirements.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ISO17265Certificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ISO17265Certificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ISOQualityCertificate"/>
        <rdfs:label xml:lang="en">ISO 17265</rdfs:label>
        <skos:definition>A certificate confirming conformance to ISO 17265 requirements.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ISO22000Certificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ISO22000Certificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ISOQualityCertificate"/>
        <rdfs:label>ISO 22000</rdfs:label>
        <skos:definition>A quality certificate confirming conformance to ISO 22000 food safety
            management system requirements.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ISO27001Certificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ISO27001Certificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ISOQualityCertificate"/>
        <rdfs:label xml:lang="en">ISO 27001</rdfs:label>
        <skos:definition>A certificate confirming conformance to ISO/IEC 27001 information security
            management system requirements.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ISO45001Certificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ISO45001Certificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/OccupationalHealthAndSafetyCertificate"/>
        <rdfs:label>ISO 45001</rdfs:label>
        <skos:definition>A certificate confirming conformance to ISO 45001 occupational health and
            safety management system requirements.</skos:definition>
        <iof-av:directSource>https://www.iso.org/standard/63787.html</iof-av:directSource>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ISO50001Certificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ISO50001Certificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ISOQualityCertificate"/>
        <rdfs:label>ISO 50001</rdfs:label>
        <skos:definition>A certificate confirming conformance to ISO 50001 energy management system
            requirements.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ISO9000Certificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ISO9000Certificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ISOQualityCertificate"/>
        <rdfs:label xml:lang="en">ISO 9000</rdfs:label>
        <skos:definition>A quality certificate confirming conformance to requirements within the ISO
            9000 family of quality management standards.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ISO9001Certificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ISO9001Certificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ISOQualityCertificate"/>
        <rdfs:label xml:lang="en">ISO 9001</rdfs:label>
        <skos:definition>A quality certificate confirming conformance to ISO 9001 quality management
            system requirements.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ISOQualityCertificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ISOQualityCertificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/QualityCertificate"/>
        <rdfs:label xml:lang="en">ISO Quality</rdfs:label>
        <skos:altLabel xml:lang="en">International Organization For Standardization Certificate</skos:altLabel>
        <skos:definition>A quality certificate confirming conformance to one or more ISO standards
            related to quality management.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ITARRegistration -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ITARRegistration">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RegulatoryRegistration"/>
        <rdfs:label>ITAR Registration</rdfs:label>
        <skos:definition>A regulatory registration confirming compliance with International Traffic
            in Arms Regulations requirements.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ImpactExtrusionCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ImpactExtrusionCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ExtrudingCapability"/>
        <rdfs:label>Impact Extrusion</rdfs:label>
        <skos:definition>A process where a metal slug is forced into a die at high speed and
            pressure to create hollow or shaped parts, often from aluminum or soft metals.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ImpressionDieForgingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ImpressionDieForgingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ForgingCapability"/>
        <rdfs:label>Impression Die Forging</rdfs:label>
        <skos:definition>A process where metal is heated and pressed into a die to produce
            high-precision parts with excellent surface finish and dimensional accuracy.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/InconelProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/InconelProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/NickelAlloyProcessingCapability"/>
        <rdfs:label>Inconel</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process Inconel,
            which is a family of nickel-chromium superalloys known for high-temperature strength,
            oxidation resistance, and corrosion resistance.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/IndirectExtrusionCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/IndirectExtrusionCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ExtrudingCapability"/>
        <rdfs:label>Indirect Extrusion</rdfs:label>
        <skos:definition>A process where the billet remains stationary while the die assembly moves
            to create a product with a hollow or solid cross-section.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/InductionBrazingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/InductionBrazingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/BrazingCapability"/>
        <rdfs:label>Induction Brazing</rdfs:label>
        <skos:definition>A process where electromagnetic fields heat metal pieces, allowing a filler
            metal to melt and create a joint, is called Induction Brazing.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/InductionHardeningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/InductionHardeningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SurfaceHardeningCapability"/>
        <rdfs:label>Induction Hardening</rdfs:label>
        <skos:definition>A process that utilizes induction heating to harden a metal surface,
            increasing its resistance to wear and extending its lifespan.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/InductionSolderingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/InductionSolderingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SolderingCapability"/>
        <rdfs:label>Induction Soldering</rdfs:label>
        <skos:definition>A process where electromagnetic fields generate heat to melt solder,
            facilitating the joining of metal parts without direct contact.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/IndustrialElectronicsIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/IndustrialElectronicsIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ElectronicsIndustry"/>
        <rdfs:label>Industrial Electronics</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving electronic devices, controls, drives, sensors, and systems used in
            industrial equipment, automation, and production environments, and are intended to
            realize similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/IndustrialMachineryAndEquipmentIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/IndustrialMachineryAndEquipmentIndustry">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/supplychain/SupplyChain/Industry"/>
        <rdfs:label>Industrial Machinery and Equipment</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving the design, manufacturing, integration, operation, maintenance,
            distribution, or support of products, systems, equipment, or services associated with
            industrial production, automation, and operational support, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/IndustrialRoboticsIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/IndustrialRoboticsIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/IndustrialMachineryAndEquipmentIndustry"/>
        <rdfs:label>Industrial Robotics</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving robots, end effectors, controllers, sensors, software, and related
            systems used in industrial automation and manufacturing operations, and are intended to
            realize similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/InfraredBrazingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/InfraredBrazingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/BrazingCapability"/>
        <rdfs:label>Infrared Brazing</rdfs:label>
        <skos:definition>A process where infrared radiation is used to heat and join two metal
            pieces together using a filler metal, without melting the base materials.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/InfraredSolderingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/InfraredSolderingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SolderingCapability"/>
        <rdfs:label>Infrared Soldering</rdfs:label>
        <skos:definition>A process that utilizes infrared radiation to generate heat for melting and
            flowing solder, facilitating the joining of metal surfaces in electronic assemblies.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/InjectionBlowMoldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/InjectionBlowMoldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/BlowMoldingCapability"/>
        <rdfs:label>Injection Blow Molding</rdfs:label>
        <skos:definition>A process where molten plastic is injected into a mold to form a preform,
            then inflated to create hollow products like bottles.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/InjectionMoldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/InjectionMoldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MoldingCapability"/>
        <rdfs:label>Injection Molding</rdfs:label>
        <skos:altLabel>Plastic Molding</skos:altLabel>
        <skos:definition>A process where molten material is injected into a mold to produce parts
            with complex geometries in high volumes.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/InvarProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/InvarProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Iron-NickelAlloyProcessingCapability"/>
        <rdfs:label>Invar</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process Invar, which
            is an iron-nickel alloy known for its very low coefficient of thermal expansion and use
            in precision instruments, tooling, and aerospace applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/InvestmentCastingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/InvestmentCastingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CastingCapability"/>
        <rdfs:label>Investment Casting</rdfs:label>
        <skos:altLabel>Lost Wax Casting</skos:altLabel>
        <skos:definition>A process where a wax pattern is coated in ceramic material, hardened, then
            heated to remove wax, creating a mold for molten metal casting.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/IriditeCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/IriditeCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AnodizingCapability"/>
        <rdfs:label>Iridite</rdfs:label>
        <skos:definition>A process where aluminum surfaces are coated with a protective chromate
            conversion layer, enhancing corrosion resistance and electrical conductivity.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/Iron-Nickel-CobaltAlloyProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/Iron-Nickel-CobaltAlloyProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FerrousAlloyProcessingCapability"/>
        <rdfs:label>Iron-Nickel-Cobalt Alloy</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process
            iron-nickel-cobalt alloys, which are controlled-expansion ferrous alloys used in
            sealing, electronics, and precision applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/Iron-NickelAlloyProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/Iron-NickelAlloyProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FerrousAlloyProcessingCapability"/>
        <rdfs:label>Iron-Nickel Alloy</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process iron-nickel
            alloys, which are ferrous alloys engineered for controlled thermal expansion, magnetic
            properties, or corrosion resistance.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/IronProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/IronProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FerrousMetalProcessingCapability"/>
        <rdfs:label xml:lang="en">Iron</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process iron, which
            is a ferrous metallic element widely used as the base material for steels, cast irons,
            and many structural or industrial products.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/IronSolderingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/IronSolderingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SolderingCapability"/>
        <rdfs:label>Iron Soldering</rdfs:label>
        <skos:definition>A process where a filler metal is heated to join iron pieces together,
            creating a strong, permanent bond through the application of intense heat.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/IroningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/IroningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/BarDrawingCapability"/>
        <rdfs:label>Ironing</rdfs:label>
        <skos:definition>A process where sheet metal is thinned and elongated by passing through a
            series of dies, enhancing surface finish and dimensional accuracy.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/IrrigationSystemsIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/IrrigationSystemsIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AgricultureIndustry"/>
        <rdfs:label>Irrigation Systems</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving equipment, controls, pumps, pipes, sensors, and support products
            used to distribute and manage water in agricultural operations, and are intended to
            realize similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/IsostaticPressingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/IsostaticPressingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PowderMetalFormingCapability"/>
        <rdfs:label>Isostatic Pressing</rdfs:label>
        <skos:definition>A process where materials are compacted uniformly using high-pressure fluid
            in all directions to enhance density and mechanical properties.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/JogBoringCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/JogBoringCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/BoringCapability"/>
        <rdfs:label>Jig Boring</rdfs:label>
        <skos:definition>a precision machining process where a specialized machine tool, called a
            jig borer, is used to accurately enlarge and finish holes to extremely tight tolerances,
            often for locating dowels or alignment pins in tooling and dies.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/JoiningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/JoiningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ManufacturingProcessCapability"/>
        <rdfs:label>Joining</rdfs:label>
        <skos:altLabel>Assembly</skos:altLabel>
        <skos:definition>A process where two or more materials are combined through methods such as
            welding, adhesive bonding, or mechanical fastening to form a single entity.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/KaptonProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/KaptonProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermoplasticProcessingCapability"/>
        <rdfs:label>Kapton</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process Kapton,
            which is a polyimide film material valued for high temperature resistance, electrical
            insulation, and dimensional stability.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/KevlarProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/KevlarProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermoplasticProcessingCapability"/>
        <rdfs:label>Kevlar</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process Kevlar,
            which is an aramid fiber material valued for high tensile strength, low weight, impact
            resistance, and reinforcement applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/KittingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/KittingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FabricatingCapability"/>
        <rdfs:label>Kitting</rdfs:label>
        <skos:definition>A process where specific parts are grouped together into a single kit for
            streamlined assembly or production.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/KnittingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/KnittingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/TextileProcessCapability"/>
        <rdfs:label xml:lang="en">Knitting</rdfs:label>
        <skos:definition>A process that interlocks loops of yarn in a series of interconnected
            stitches to create a flexible, elastic fabric or garment.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/KnurlingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/KnurlingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FormingCapability"/>
        <rdfs:label>Knurling</rdfs:label>
        <skos:definition>A process where a pattern of straight, angled or crossed lines is rolled
            onto a material&apos;s surface for grip enhancement or aesthetic purposes.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/KosherApprovedCertificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/KosherApprovedCertificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ProductComplianceCertificate"/>
        <rdfs:label xml:lang="en">Kosher Approved</rdfs:label>
        <skos:definition>A certificate confirming that a product, ingredient, process, facility, or
            service conforms to specified kosher dietary requirements, typically through inspection,
            assessment, certification, and ongoing compliance activities conducted by a recognized
            kosher certification authority.</skos:definition>
        <iof-av:directSource xml:lang="en">https://en.wikipedia.org/wiki/Kosher_certification_agency</iof-av:directSource>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/KovarProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/KovarProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Iron-Nickel-CobaltAlloyProcessingCapability"/>
        <rdfs:label>Kovar</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process Kovar, which
            is an iron-nickel-cobalt controlled-expansion alloy commonly used for glass-to-metal and
            ceramic-to-metal seals.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/LDPEProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/LDPEProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermoplasticProcessingCapability"/>
        <rdfs:label>LDPE</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process low-density
            polyethylene, which is a flexible, chemically resistant thermoplastic used in films,
            bags, tubing, and packaging products.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/LEEDCertificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/LEEDCertificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SustainabilityCertificate"/>
        <rdfs:label>LEED</rdfs:label>
        <skos:altLabel>LEED Certification</skos:altLabel>
        <skos:definition>A certificate confirming that a building, facility, or project has
            demonstrated conformance to LEED sustainability and environmental performance
            requirements.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/LabelingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/LabelingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PackingCapability"/>
        <rdfs:label>Labeling</rdfs:label>
        <skos:definition>A process where specific information is printed or affixed onto a product
            or its packaging for identification, branding, or regulatory compliance.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/LaboratoryAccreditation -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/LaboratoryAccreditation">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Accreditation"/>
        <rdfs:label>Laboratory Accreditation</rdfs:label>
        <skos:definition>An accreditation confirming that a laboratory has demonstrated competence
            to perform specified testing, calibration, measurement, or analytical activities.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/LaminatedObjectManufacturingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/LaminatedObjectManufacturingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AdditiveManufacturingCapability"/>
        <rdfs:label>Laminated Object Manufacturing</rdfs:label>
        <skos:definition>A 3D printing process that builds objects layer by layer, using
            adhesive-coated materials like paper, plastic, or metal sheets.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/LaminationCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/LaminationCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AdhesiveBondingCapability"/>
        <rdfs:label>Lamination</rdfs:label>
        <skos:definition>A process where multiple layers of material are bonded together using heat,
            pressure, or adhesives to enhance strength, durability, and insulation properties.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/LappingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/LappingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AbrassiveMachiningCapability"/>
        <rdfs:label>Lapping</rdfs:label>
        <skos:definition>A process that involves abrading two surfaces against each other with an
            abrasive between them to achieve high levels of surface flatness and parallelism.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/LaptopsProductCategory -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/LaptopsProductCategory">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Computing%20DevicesProductCategory"/>
        <rdfs:label xml:lang="en">Laptops</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/LaptosProductCategory -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/LaptosProductCategory">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Computing%20DevicesProductCategory"/>
        <rdfs:label xml:lang="en">Laptos</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/LaserBeamWeldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/LaserBeamWeldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/HighEnergyBeamWeldingCapability"/>
        <rdfs:label>Laser Beam Welding</rdfs:label>
        <skos:definition>A process where high-energy laser beams are used to fuse materials
            together, resulting in high-quality, precision welds.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/LaserBrazingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/LaserBrazingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/BrazingCapability"/>
        <rdfs:label>Laser Brazing</rdfs:label>
        <skos:altLabel>Brazing Laser Welding</skos:altLabel>
        <skos:definition>A process where a laser provides concentrated heat, enabling the joining of
            metals using a filler material without melting the base materials.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/LaserCuttingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/LaserCuttingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/HighEnergyBeamMachiningCapability"/>
        <rdfs:label>Laser Cutting</rdfs:label>
        <skos:altLabel>Laser Beam Cutting</skos:altLabel>
        <skos:definition>A process where a high-powered laser beam precisely cuts or engraves
            materials, guided by computer-aided design (CAD) data.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/LaserDirectedEnergyDepositionCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/LaserDirectedEnergyDepositionCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/DirectedEnergyDepositionCapability"/>
        <rdfs:label>Laser Directed Energy Deposition</rdfs:label>
        <skos:definition>A directed energy deposition process where a laser is used as the energy
            source to melt metallic feedstock during deposition.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/LaserEngravingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/LaserEngravingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/EngravingCapability"/>
        <rdfs:label>Laser Engraving</rdfs:label>
        <skos:definition>A process where a laser beam is used to etch or mark surfaces with high
            precision, by removing material to create an image or pattern.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/LaserEtchingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/LaserEtchingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/HighEnergyBeamMachiningCapability"/>
        <rdfs:label>Laser Etching</rdfs:label>
        <skos:definition>A process that utilizes a high-powered laser to remove surface material,
            creating precise, permanent markings on an object.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/LaserMachiningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/LaserMachiningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/UnconventionalMachiningCapability"/>
        <rdfs:label>Laser Machining</rdfs:label>
        <skos:definition>A process where a focused laser beam removes material through melting,
            vaporization, or ablation, enabling precise cutting, drilling, or engraving of
            workpieces.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/LaserPowderBedFusionCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/LaserPowderBedFusionCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PowderDepositionCapability"/>
        <rdfs:label>Laser Powder Bed Fusion</rdfs:label>
        <skos:altLabel>LPBF</skos:altLabel>
        <skos:definition>A powder bed fusion process where one or more lasers selectively melt
            metallic powder to produce a part layer by layer.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/LeadProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/LeadProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Non-FerrousMetalProcessingCapability"/>
        <rdfs:label>Lead</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process lead, which
            is a dense, soft non-ferrous metal used in radiation shielding, batteries, weights, and
            specialized industrial applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/LexanProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/LexanProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermoplasticProcessingCapability"/>
        <rdfs:label>Lexan</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process Lexan, which
            is a polycarbonate engineering thermoplastic valued for impact resistance, optical
            clarity, and toughness.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/LightRailIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/LightRailIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RailAndTransitIndustry"/>
        <rdfs:label>Light Rail</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving vehicles, tracks, components, systems, and equipment used in urban
            or regional light-rail transportation, and are intended to realize similar or related
            primary business functions according to their organizational objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/LiquidCrystalPolymerProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/LiquidCrystalPolymerProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermoplasticProcessingCapability"/>
        <rdfs:label>Liquid Crystal Polymer</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process liquid
            crystal polymer, which is a high-performance thermoplastic valued for high temperature
            resistance, dimensional stability, chemical resistance, and electrical performance.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/LiveToolingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/LiveToolingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/TurningCapability"/>
        <rdfs:label>Live Tooling</rdfs:label>
        <skos:altLabel>Live-Tooling</skos:altLabel>
        <skos:definition>A process where rotating cutting tools are used on a CNC lathe to perform
            milling operations on a workpiece.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/LivestockProductionIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/LivestockProductionIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AgricultureIndustry"/>
        <rdfs:label>Livestock Production</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving equipment, systems, facilities, and services used in raising,
            feeding, monitoring, handling, or processing livestock, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/LongitudinalSeamWeldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/LongitudinalSeamWeldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermalWeldingCapability"/>
        <rdfs:label>Longitudinal Seam Welding</rdfs:label>
        <skos:definition>A process where a continuous weld seam is produced along the length of a
            workpiece, commonly used in manufacturing pipes, tubes, and cylindrical components.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/LostFoamCastingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/LostFoamCastingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CastingCapability"/>
        <rdfs:label>Lost Foam Casting</rdfs:label>
        <skos:definition>A process where foam patterns are coated in refractory material, evaporated
            during molten metal pour, forming a precise casting.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/LowAlloySteelProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/LowAlloySteelProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AlloySteelProcessingCapability"/>
        <rdfs:label>Low Alloy Steel</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process low-alloy
            steel, which is steel containing modest amounts of alloying elements to improve
            strength, toughness, hardenability, or wear resistance.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/LuciteProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/LuciteProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermoplasticProcessingCapability"/>
        <rdfs:label>Lucite</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process Lucite,
            which is an acrylic thermoplastic valued for optical clarity, weather resistance, and
            lightweight transparent components.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MDFProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MDFProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/WoodProcessingCapability"/>
        <rdfs:label>MDF</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process
            medium-density fiberboard, which is an engineered wood product made from wood fibers
            bonded with resin and used in furniture, fixtures, tooling, and interior products.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MIGWeldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MIGWeldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/GasMetalArcWeldingCapability"/>
        <rdfs:label>MIG Welding</rdfs:label>
        <skos:definition>A process where a continuous solid wire electrode is fed through a welding
            gun, creating a weld pool by heating and melting the workpieces.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MachineToolsIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MachineToolsIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/IndustrialMachineryAndEquipmentIndustry"/>
        <rdfs:label>Machine Tools</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving machines, tooling, controls, fixtures, and components used to cut,
            form, grind, or otherwise shape materials in manufacturing, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MachiningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MachiningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ManufacturingProcessCapability"/>
        <rdfs:label xml:lang="en">Machining</rdfs:label>
        <skos:altLabel>Material Removal Process</skos:altLabel>
        <skos:altLabel>Subtractive Process</skos:altLabel>
        <skos:altLabel>subtractive manufacturing</skos:altLabel>
        <skos:definition>A process where material is selectively removed from a workpiece using
            cutting tools to create specific dimensions and surface quality.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MachiningOfCastingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MachiningOfCastingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SpecializedMachiningCapability"/>
        <rdfs:label>Machining Of Castings</rdfs:label>
        <skos:altLabel>Post-Cast Machining</skos:altLabel>
        <skos:definition>A process where excess material is removed from a cast workpiece using
            various machine tools to achieve precise dimensions and finish.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MagnesiumAlloyProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MagnesiumAlloyProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Non-FerrousAlloyProcessingCapability"/>
        <rdfs:label xml:lang="en">Magnesium Alloy</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process magnesium
            alloys, which are very lightweight non-ferrous alloys used where weight reduction,
            machinability, and castability are important.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MainframesProductCategory -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MainframesProductCategory">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Computing%20DevicesProductCategory"/>
        <rdfs:label xml:lang="en">Mainframes</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MalleableIronProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MalleableIronProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CastIronProcessingCapability"/>
        <rdfs:label>Malleable Iron</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process malleable
            iron, which is heat-treated cast iron with improved ductility and toughness compared
            with white cast iron.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ManMadeFiberProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ManMadeFiberProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FiberProcessingCapability"/>
        <rdfs:label xml:lang="en">Man Made Fiber</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process man-made
            fibers, which are manufactured fibers produced from synthetic polymers or regenerated
            natural materials for textile, composite, filtration, or industrial applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ManufacturedProductFamilyCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ManufacturedProductFamilyCapability">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/supplychain/SupplyChain/ProductionCapability"/>
        <rdfs:label>manufactured product family capability</rdfs:label>
        <skos:definition>capability of a manufacturing system or machine to manufacture specific
            families of products</skos:definition>
        <skos:example>capability to machine heavy parts, capability to manufacture medical-grade
            parts, capability to manufacture aerospace precision parts</skos:example>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ManufacturingCertificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ManufacturingCertificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Certificate"/>
        <rdfs:label>Manufacturing Certificate</rdfs:label>
        <skos:definition>A confirmation that an organization, facility, product, process, or
            individual has demonstrated conformance to specified manufacturing requirements,
            standards, qualifications, or competencies, typically through auditing, assessment,
            testing, inspection, certification, or external review activities related to
            manufacturing operations, products, or services.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ManufacturingEquipmentIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ManufacturingEquipmentIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/IndustrialMachineryAndEquipmentIndustry"/>
        <rdfs:label>Manufacturing Equipment</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving equipment, machines, systems, components, and services used to
            produce, process, inspect, or assemble manufactured goods, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ManufacturingProcessCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ManufacturingProcessCapability">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/supplychain/SupplyChain/ProductionCapability"/>
        <rdfs:label xml:lang="en">manufacturing process capability</rdfs:label>
        <iof-av:naturalLanguageDefinition>capability of an agent or a system that is realized in a
            manufacturing process</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MarineAndShipbuildingIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MarineAndShipbuildingIndustry">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/supplychain/SupplyChain/Industry"/>
        <rdfs:label>Marine and Shipbuilding</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving the design, manufacturing, integration, operation, maintenance,
            distribution, or support of products, systems, equipment, or services associated with
            marine transportation and maritime operations, and are intended to realize similar or
            related primary business functions according to their organizational objectives and
            plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MarineEquipmentIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MarineEquipmentIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MarineAndShipbuildingIndustry"/>
        <rdfs:label>Marine Equipment</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving equipment, components, systems, materials, and support products used
            in marine vessels and maritime operations, and are intended to realize similar or
            related primary business functions according to their organizational objectives and
            plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MartemperingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MartemperingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThroughHardeningCapability"/>
        <rdfs:label>Martempering</rdfs:label>
        <skos:definition>A process where steel or cast iron alloys are rapidly cooled to avoid
            brittleness, then tempered to achieve high toughness and hardness.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MassTransitSystemsIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MassTransitSystemsIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RailAndTransitIndustry"/>
        <rdfs:label>Mass Transit Systems</rdfs:label>
        <skos:altLabel>Public Transit</skos:altLabel>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving vehicles, stations, infrastructure, controls, components, and
            equipment used in public transit systems, and are intended to realize similar or related
            primary business functions according to their organizational objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MaterialExtrusionCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MaterialExtrusionCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AdditiveManufacturingCapability"/>
        <rdfs:label>Material Extrusion</rdfs:label>
        <skos:definition>An additive manufacturing process where material is selectively dispensed
            through a nozzle or orifice to form a three-dimensional object layer by layer.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MaterialHandlingEquipmentIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MaterialHandlingEquipmentIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/IndustrialMachineryAndEquipmentIndustry"/>
        <rdfs:label>Material Handling Equipment</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving conveyors, cranes, lifts, carts, storage systems, and related
            products used to move, store, or handle materials, and are intended to realize similar
            or related primary business functions according to their organizational objectives and
            plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MaterialJettingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MaterialJettingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AdditiveManufacturingCapability"/>
        <rdfs:label>Material Jetting</rdfs:label>
        <skos:definition>An additive manufacturing process where droplets of build material are
            selectively deposited onto a build surface and subsequently solidified or consolidated
            to form a three-dimensional object layer by layer.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MaterialProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MaterialProcessingCapability">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/supplychain/SupplyChain/ProductionCapability"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/ManufacturingProcess"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">material processing capability</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process material
            processing capability materials, which are used as workpiece, feedstock, or product
            materials in manufacturing applications.</skos:definition>
        <skos:example>capability of a die cast machine to create parts made of aluminum, capability
            of a machine shop to machine super alloys</skos:example>
        <iof-av:explanatoryNote>There should be a parallel &apos;material taxonomy&apos; under
            independent continuants with the exact same structure. Currently the material taxonomy
            does not exist in the SUDOKN ontology. This class merely deals with the capability to
            process the material.</iof-av:explanatoryNote>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MeatAndPoultryProcessingIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MeatAndPoultryProcessingIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FoodAndBeverageIndustry"/>
        <rdfs:label>Meat and Poultry Processing</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving equipment, materials, packaging, systems, and services used to
            process, package, inspect, or distribute meat and poultry products, and are intended to
            realize similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MechanicalCoatingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MechanicalCoatingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CoatingCapability"/>
        <rdfs:label>Mechanical Coating</rdfs:label>
        <skos:definition>A process that involves the use of mechanical equipment and machinery to
            transform raw materials into finished goods.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MechanicalJoiningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MechanicalJoiningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/JoiningCapability"/>
        <owl:disjointWith rdf:resource="http://asu.edu/semantics/SUDOKN/ThermaJoiningCapability"/>
        <rdfs:label>Mechanical Joining</rdfs:label>
        <skos:altLabel>Mechanical Assembly</skos:altLabel>
        <skos:altLabel>Mechanical Fastening</skos:altLabel>
        <skos:definition>A process where two or more materials are physically combined through
            methods such as welding, bolting, or riveting to form a unified structure.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MechanicalPolishingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MechanicalPolishingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PolishingCapability"/>
        <rdfs:label>Mechanical Polishing</rdfs:label>
        <skos:definition>A process where material surfaces are smoothed and shined by mechanical
            abrasion, reducing roughness and enhancing appearance or performance.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MechanicalWeldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MechanicalWeldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MechanicalJoiningCapability"/>
        <owl:disjointWith rdf:resource="http://asu.edu/semantics/SUDOKN/RivetingCapability"/>
        <rdfs:label>Mechanical Welding</rdfs:label>
        <skos:definition>A process where two or more metal parts are permanently joined by applying
            heat, pressure, or both, causing fusion or coalescence.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MedicalDevicesIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MedicalDevicesIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/HealthcareAndMedicalDevicesIndustry"/>
        <rdfs:label>Medical Devices</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving devices, components, materials, instruments, and support products
            used for diagnosis, treatment, monitoring, or prevention of medical conditions, and are
            intended to realize similar or related primary business functions according to their
            organizational objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MedicalPackagingIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MedicalPackagingIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PackagingIndustry"/>
        <rdfs:label>Medical Packaging</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving packaging materials, containers, sterile barriers, labeling, and
            equipment used to package medical, healthcare, or life-science products, and are
            intended to realize similar or related primary business functions according to their
            organizational objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MetalAdditiveManufacturingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MetalAdditiveManufacturingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AdditiveManufacturingCapability"/>
        <rdfs:label>Metal Additive Manufacturing</rdfs:label>
        <skos:definition>A process where metal powders are selectively fused layer by layer using a
            heat source, such as a laser or electron beam, to create complex geometries.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MetalBinderJettingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MetalBinderJettingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/binderjettingCapability"/>
        <rdfs:label>Metal Binder Jetting</rdfs:label>
        <skos:definition>A binder jetting process where a liquid binder is selectively deposited
            onto layers of metallic powder, followed by debinding and sintering.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MetalClinchingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MetalClinchingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SeamWeldingCapability"/>
        <rdfs:label>Metal Clinching</rdfs:label>
        <skos:definition>A process where sheet metal layers are mechanically joined by deforming and
            interlocking without using heat, fasteners, or adhesives.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MetalCoatingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MetalCoatingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CoatingCapability"/>
        <rdfs:label>Metal Coating</rdfs:label>
        <skos:definition>A process where a protective or decorative layer is applied to metal
            surfaces to enhance corrosion resistance, wear resistance, or aesthetic appeal.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MetalFilamentExtrusionCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MetalFilamentExtrusionCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MaterialExtrusionCapability"/>
        <rdfs:label>Metal Filament Extrusion</rdfs:label>
        <skos:altLabel>Metal FFF</skos:altLabel>
        <skos:altLabel>Metal Fused Filament Fabrication</skos:altLabel>
        <skos:definition>A material extrusion additive manufacturing process where a filament
            containing metal powder and binder is extruded through a heated nozzle to form a green
            part that is subsequently debound and sintered to produce a metal part.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MetalFormingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MetalFormingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FormingCapability"/>
        <rdfs:label>Metal Forming</rdfs:label>
        <skos:altLabel>Metalforming</skos:altLabel>
        <skos:definition>A process where metal workpieces are plastically deformed into specific
            geometries using compressive forces, typically through rolling, forging, extrusion, or
            stamping.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MetalInjectionMoldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MetalInjectionMoldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/InjectionMoldingCapability"/>
        <rdfs:label>Metal Injection Molding</rdfs:label>
        <skos:definition>A process where fine metal powders are mixed with a binder, injected into a
            mold, and then sintered to produce high-density, complex parts.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MetalJoiningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MetalJoiningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/JoiningCapability"/>
        <rdfs:label>Metal Joining</rdfs:label>
        <skos:definition>A process where two or more metal parts are permanently bonded using
            techniques like welding, brazing, or soldering to ensure structural integrity.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MetalProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MetalProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MaterialProcessingCapability"/>
        <rdfs:label xml:lang="en">Metal</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process metallic
            materials, which are materials characterized by metallic bonding and typically exhibit
            strength, ductility, thermal conductivity, electrical conductivity, and machinability or
            formability depending on composition.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MetalSheetLaminationCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MetalSheetLaminationCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SheetLaminationCapability"/>
        <rdfs:label>Metal Sheet Lamination</rdfs:label>
        <skos:definition>A sheet lamination additive manufacturing process where metallic sheets or
            foils are bonded together layer by layer to produce a three-dimensional component.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MetricTubingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MetricTubingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/TubingCapability"/>
        <rdfs:label>Metric Tubing</rdfs:label>
        <skos:definition>A process where precise tubes are produced using metric dimensions,
            typically through extrusion or drawing methods, adhering to international standards.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MicroDrillingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MicroDrillingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/DrillingCapability"/>
        <rdfs:label>Micro Drilling</rdfs:label>
        <skos:definition>A process that involves creating small, precise holes in a material using
            specialized drilling machines with high rotational speeds and low feed rates.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MicroFabricationCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MicroFabricationCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FabricatingCapability"/>
        <rdfs:label>Micro Fabrication</rdfs:label>
        <skos:altLabel>Microfabricationy</skos:altLabel>
        <skos:definition>A process where materials are precisely manipulated at the microscale to
            create intricate structures and devices, primarily for semiconductor and MEMS
            applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MicroFinishingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MicroFinishingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SurfaceFinishingCapability"/>
        <rdfs:label>MicroFinishing</rdfs:label>
        <skos:altLabel>Micro Finishing</skos:altLabel>
        <skos:definition>A process that uses abrasive films to achieve precise surface finishes and
            dimensional accuracy on metal components by removing microscopic material layers.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MicrocontrollersProductCategory -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MicrocontrollersProductCategory">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Computer%20ComponentsProductCategory"/>
        <rdfs:label xml:lang="en">Microcontrollers</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MicroelectronicsIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MicroelectronicsIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SemiconductorIndustry"/>
        <rdfs:label>Microelectronics</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving devices, components, assemblies, materials, and systems involving
            miniaturized electronic circuits and semiconductor-based products, and are intended to
            realize similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MidstreamOilAndGasIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MidstreamOilAndGasIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/OilAndGasIndustry"/>
        <rdfs:label>Midstream Oil and Gas</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving equipment, systems, components, and services used in gathering,
            processing, storage, compression, and transportation of oil and natural gas, and are
            intended to realize similar or related primary business functions according to their
            organizational objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MildSteelProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MildSteelProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SteelProcessingCapability"/>
        <rdfs:label>Mild Steel</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process mild steel,
            which is low-carbon steel valued for weldability, formability, machinability, and
            general-purpose structural use.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MilitarySystemsIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MilitarySystemsIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/DefenseIndustry"/>
        <rdfs:label>Military Systems</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving systems, platforms, equipment, components, and services used by
            military organizations to support defense missions, and are intended to realize similar
            or related primary business functions according to their organizational objectives and
            plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MillingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MillingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MultipointCuttingCapability"/>
        <rdfs:label>Milling</rdfs:label>
        <skos:definition>A process that involves the removal of material from a workpiece using
            rotary cutters to produce a specific part.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MineralProcessingIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MineralProcessingIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MiningIndustry"/>
        <rdfs:label>Mineral Processing</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving equipment, components, materials, systems, and services used to
            crush, separate, refine, or prepare extracted minerals, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MiningEquipmentIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MiningEquipmentIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MiningIndustry"/>
        <rdfs:label>Mining Equipment</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving machines, tools, components, systems, and support products used in
            mining operations and mineral extraction, and are intended to realize similar or related
            primary business functions according to their organizational objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MiningIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MiningIndustry">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/supplychain/SupplyChain/Industry"/>
        <rdfs:label>Mining</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving the design, manufacturing, integration, operation, maintenance,
            distribution, or support of products, systems, equipment, or services associated with
            mineral extraction, processing, and mining operations, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MinorityOwned -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MinorityOwned">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/OwnershipStatusClassifier"/>
        <rdfs:label xml:lang="en">Minority Owned</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ModemsProductCategory -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ModemsProductCategory">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Networking%20EquipmentProductCategory"/>
        <rdfs:label xml:lang="en">Modems</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MoldDesignCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MoldDesignCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ToolDesignCapability"/>
        <rdfs:label>mold design capability</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MoldMakingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MoldMakingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ToolMakingCapability"/>
        <rdfs:label>Mold Making</rdfs:label>
        <skos:definition>A process where a hollow container is created to form materials into
            specific dimensions and designs through casting or injection molding techniques.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MoldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MoldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FormativeManufacturingCapability"/>
        <rdfs:label xml:lang="en">Molding</rdfs:label>
        <skos:altLabel>Moulding</skos:altLabel>
        <skos:definition>A process that involves shaping a pliable raw material by using a rigid
            frame or model called a mold.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MolybdenumProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MolybdenumProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Non-FerrousMetalProcessingCapability"/>
        <rdfs:label>Molybdenum</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process molybdenum,
            which is a refractory metal valued for high melting point, strength at elevated
            temperatures, and use in alloys, electrodes, and high-temperature components.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MonelProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MonelProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/NickelAlloyProcessingCapability"/>
        <rdfs:label>Monel</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process Monel, which
            is a family of nickel-copper alloys valued for corrosion resistance, strength, and
            marine or chemical processing applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MotherboardsProductCategory -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MotherboardsProductCategory">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Computer%20ComponentsProductCategory"/>
        <rdfs:label xml:lang="en">Motherboards</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MotorsportsIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MotorsportsIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AutomotiveIndustry"/>
        <rdfs:label>Motorsports</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving vehicles, components, tooling, materials, and support products used
            in racing and high-performance automotive applications, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MultiJetFusionCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MultiJetFusionCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PowderDepositionCapability"/>
        <rdfs:label>Multijet Fusion</rdfs:label>
        <skos:altLabel>Multi Jet Fusion</skos:altLabel>
        <skos:definition>A powder bed fusion additive manufacturing process where a fusing agent and
            detailing agent are selectively deposited onto layers of polymer powder and thermal
            energy is applied to fuse the selected regions into a solid part layer by layer</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MultipointCuttingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MultipointCuttingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ConventionalMachiningCapability"/>
        <rdfs:label>Multipoint Cutting</rdfs:label>
        <skos:definition>A process that involves the simultaneous use of multiple cutting edges to
            remove material from a workpiece in a machining operation.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/NADCAPAccreditation -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/NADCAPAccreditation">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AerospaceAccreditation"/>
        <rdfs:label xml:lang="en">NADCAP</rdfs:label>
        <skos:altLabel>Nadcap Accreditation</skos:altLabel>
        <skos:definition>An aerospace accreditation confirming that an organization has demonstrated
            conformance to aerospace-industry requirements for a specified special manufacturing
            process, product, or service, typically through auditing and assessment activities
            conducted under the Nadcap program.</skos:definition>
        <iof-av:directSource xml:lang="en">https://www.p-r-i.org/nadcap</iof-av:directSource>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/NAICS111 -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/NAICS111">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/NAICSClassifier"/>
        <rdfs:label xml:lang="en">NAICS 111</rdfs:label>
    </owl:Class>
    


