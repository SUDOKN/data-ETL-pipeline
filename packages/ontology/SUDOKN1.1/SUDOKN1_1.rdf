    <owl:ObjectProperty rdf:about="http://asu.edu/semantics/SUDOKN/hasName">
        <rdfs:subPropertyOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/denotedBy"/>
        <rdfs:label xml:lang="en">has name</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://asu.edu/semantics/SUDOKN/hasOwnershipStatusClassifier -->

    <owl:ObjectProperty rdf:about="http://asu.edu/semantics/SUDOKN/hasOwnershipStatusClassifier">
        <rdfs:domain rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/Organization"/>
        <rdfs:range rdf:resource="http://asu.edu/semantics/SUDOKN/OwnershipStatusClassifier"/>
        <rdfs:label xml:lang="en">has ownership status classifier</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://asu.edu/semantics/SUDOKN/hasPrimaryNAICSClassifier -->

    <owl:ObjectProperty rdf:about="http://asu.edu/semantics/SUDOKN/hasPrimaryNAICSClassifier">
        <rdfs:subPropertyOf rdf:resource="http://asu.edu/semantics/SUDOKN/hasNAICSClassifier"/>
        <rdfs:domain rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/Organization"/>
        <rdfs:range rdf:resource="http://asu.edu/semantics/SUDOKN/NAICSClassifier"/>
        <rdfs:label xml:lang="en">has primary NAICS classifier</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://asu.edu/semantics/SUDOKN/hasProcessCapability -->

    <owl:ObjectProperty rdf:about="http://asu.edu/semantics/SUDOKN/hasProcessCapability">
        <rdfs:domain rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/Organization"/>
        <rdfs:range rdf:resource="http://asu.edu/semantics/SUDOKN/ManufacturingProcessCapability"/>
        <rdfs:label xml:lang="en">has process capability</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://asu.edu/semantics/SUDOKN/hasSecondaryNAICSClassifier -->

    <owl:ObjectProperty rdf:about="http://asu.edu/semantics/SUDOKN/hasSecondaryNAICSClassifier">
        <rdfs:subPropertyOf rdf:resource="http://asu.edu/semantics/SUDOKN/hasNAICSClassifier"/>
        <rdfs:domain rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/Organization"/>
        <rdfs:range rdf:resource="http://asu.edu/semantics/SUDOKN/NAICSClassifier"/>
        <rdfs:label xml:lang="en">has secondary NAICS classifier</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://asu.edu/semantics/SUDOKN/hasSpecialBusinessStatusClassifier -->

    <owl:ObjectProperty rdf:about="http://asu.edu/semantics/SUDOKN/hasSpecialBusinessStatusClassifier">
        <rdfs:domain rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/Organization"/>
        <rdfs:range rdf:resource="http://asu.edu/semantics/SUDOKN/SpecialBusinessStatusClassifier"/>
        <rdfs:label xml:lang="en">has special business status classifier</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://asu.edu/semantics/SUDOKN/hasWebAddress -->

    <owl:ObjectProperty rdf:about="http://asu.edu/semantics/SUDOKN/hasWebAddress">
        <rdfs:domain rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/Organization"/>
        <rdfs:range rdf:resource="http://asu.edu/semantics/SUDOKN/WebAddress"/>
        <rdfs:label xml:lang="en">has web address</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://asu.edu/semantics/SUDOKN/locatedInCity -->

    <owl:ObjectProperty rdf:about="http://asu.edu/semantics/SUDOKN/locatedInCity">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000171"/>
        <rdfs:domain rdf:resource="https://spec.industrialontologies.org/ontology/supplychain/SupplyChain/GeospatialSite"/>
        <rdfs:range rdf:resource="http://asu.edu/semantics/SUDOKN/City"/>
        <rdfs:label>located in city</rdfs:label>
        <iof-av:naturalLanguageDefinition>relationship between a geospatial site and a city when the
            site is located in the state</iof-av:naturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- http://asu.edu/semantics/SUDOKN/locatedInCountry -->

    <owl:ObjectProperty rdf:about="http://asu.edu/semantics/SUDOKN/locatedInCountry">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000171"/>
        <rdfs:domain rdf:resource="https://spec.industrialontologies.org/ontology/supplychain/SupplyChain/GeospatialSite"/>
        <rdfs:range rdf:resource="http://asu.edu/semantics/SUDOKN/Country"/>
        <rdfs:label>located in country</rdfs:label>
        <iof-av:naturalLanguageDefinition>relationship between a geospatial site and a country when
            the site is located in the country</iof-av:naturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- http://asu.edu/semantics/SUDOKN/locatedInCounty -->

    <owl:ObjectProperty rdf:about="http://asu.edu/semantics/SUDOKN/locatedInCounty">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000171"/>
        <rdfs:domain rdf:resource="https://spec.industrialontologies.org/ontology/supplychain/SupplyChain/GeospatialSite"/>
        <rdfs:range rdf:resource="http://asu.edu/semantics/SUDOKN/County"/>
        <rdfs:label>located in county</rdfs:label>
        <iof-av:naturalLanguageDefinition>relationship between a geospatial site and a county when
            the site is located in the county</iof-av:naturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- http://asu.edu/semantics/SUDOKN/locatedInState -->

    <owl:ObjectProperty rdf:about="http://asu.edu/semantics/SUDOKN/locatedInState">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000171"/>
        <owl:inverseOf rdf:resource="http://asu.edu/semantics/SUDOKN/stateOf"/>
        <rdfs:domain rdf:resource="https://spec.industrialontologies.org/ontology/supplychain/SupplyChain/GeospatialSite"/>
        <rdfs:range rdf:resource="http://asu.edu/semantics/SUDOKN/State"/>
        <rdfs:label>located in state</rdfs:label>
        <iof-av:naturalLanguageDefinition>relationship between a geospatial site and a state when
            the site is located in the state</iof-av:naturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- http://asu.edu/semantics/SUDOKN/manufactures -->

    <owl:ObjectProperty rdf:about="http://asu.edu/semantics/SUDOKN/manufactures">
        <rdfs:domain rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/Organization"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/core/Core/MaterialComponent"/>
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/core/Core/MaterialProduct"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:label xml:lang="en">manufactures</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://asu.edu/semantics/SUDOKN/organizationLocatedIn -->

    <owl:ObjectProperty rdf:about="http://asu.edu/semantics/SUDOKN/organizationLocatedIn">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000171"/>
        <rdfs:label>organization located in</rdfs:label>
        <iof-av:naturalLanguageDefinition>relationship connecting an organization to its geospatial
            location</iof-av:naturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- http://asu.edu/semantics/SUDOKN/stateOf -->

    <owl:ObjectProperty rdf:about="http://asu.edu/semantics/SUDOKN/stateOf">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000124"/>
        <rdfs:label>state of</rdfs:label>
        <iof-av:naturalLanguageDefinition>relationship between a state and a geospatial site when
            the state is the location of the site</iof-av:naturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- http://asu.edu/semantics/SUDOKN/suppliesToIndustry -->

    <owl:ObjectProperty rdf:about="http://asu.edu/semantics/SUDOKN/suppliesToIndustry">
        <rdfs:domain rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/Organization"/>
        <rdfs:range rdf:resource="https://spec.industrialontologies.org/ontology/supplychain/SupplyChain/Industry"/>
        <rdfs:label xml:lang="en">supplies to industry</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://spec.industrialontologies.org/ontology/core/Core/denotedBy -->

    <owl:ObjectProperty rdf:about="https://spec.industrialontologies.org/ontology/core/Core/denotedBy"/>
    


