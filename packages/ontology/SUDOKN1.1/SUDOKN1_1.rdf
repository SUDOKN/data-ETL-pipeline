    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/Environmental%20Control%20SystemsProductCategory -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/Environmental%20Control%20SystemsProductCategory">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Power%20%26%20InfrastructureProductCategory"/>
        <rdfs:label xml:lang="en">Environmental Control Systems</rdfs:label>
