    <!-- http://asu.edu/semantics/SUDOKN/Zinc–AluminumAlloyProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/Zinc–AluminumAlloyProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ZincAlloyProcessingCapability"/>
        <rdfs:label>Zinc–Aluminum Alloy</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process
            zinc-aluminum alloys, which combine zinc with aluminum to improve strength, bearing
            properties, castability, or corrosion resistance.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/Zinc–CopperAlloyProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/Zinc–CopperAlloyProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ZincAlloyProcessingCapability"/>
        <rdfs:label>Zinc-Copper Alloy</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process zinc-copper
            alloys, which are zinc-based alloys containing copper to improve strength, hardness, or
            wear resistance.</skos:definition>
    </owl:Class>
    


