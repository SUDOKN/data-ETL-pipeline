        <rdfs:label xml:lang="en">NAICS 4931</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/NAICS517 -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/NAICS517">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/NAICSClassifier"/>
        <rdfs:label xml:lang="en">NAICS 517</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/NAICS541 -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/NAICS541">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/NAICSClassifier"/>
        <rdfs:label xml:lang="en">NAICS 541</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/NAICS562 -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/NAICS562">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/NAICSClassifier"/>
        <rdfs:label xml:lang="en">NAICS 562</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/NAICS611 -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/NAICS611">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/NAICSClassifier"/>
        <rdfs:label xml:lang="en">NAICS 611</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/NAICS622 -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/NAICS622">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/NAICSClassifier"/>
        <rdfs:label xml:lang="en">NAICS 622</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/NAICS722 -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/NAICS722">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/NAICSClassifier"/>
        <rdfs:label xml:lang="en">NAICS 722</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/NAICS811 -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/NAICS811">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/NAICSClassifier"/>
        <rdfs:label xml:lang="en">NAICS 811</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/NAICS9221 -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/NAICS9221">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/NAICSClassifier"/>
        <rdfs:label xml:lang="en">NAICS 9221</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/NAICS9261 -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/NAICS9261">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/NAICSClassifier"/>
        <rdfs:label xml:lang="en">NAICS 9261</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/NAICS927110 -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/NAICS927110">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/NAICSClassifier"/>
        <rdfs:label xml:lang="en">NAICS 927110</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/NAICS9281 -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/NAICS9281">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/NAICSClassifier"/>
        <rdfs:label xml:lang="en">NAICS 9281</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/NAICSClassifier -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/NAICSClassifier">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Classifier"/>
        <rdfs:label xml:lang="en">NAICS classifier</rdfs:label>
        <iof-av:naturalLanguageDefinition>classifier designed to categorize businesses based on
            their primary business functions</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/NIST800171Certificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/NIST800171Certificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/NISTCertificate"/>
        <rdfs:label xml:lang="en">NIST 800171</rdfs:label>
        <skos:definition>A certificate confirming conformance to NIST SP 800-171 cybersecurity
            requirements.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/NISTCertificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/NISTCertificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/QualityCertificate"/>
        <rdfs:label xml:lang="en">NIST</rdfs:label>
        <skos:definition>A certificate confirming conformance to requirements, standards, or
            programs developed or recognized by NIST.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/NRCLicense -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/NRCLicense">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RegulatoryLicense"/>
        <rdfs:comment>Regulatory authority: United States Nuclear Regulatory Commission (NRC). Typical industry: Nuclear energy, radioactive-material product manufacturing, and nuclear medical or industrial equipment.</rdfs:comment>
        <rdfs:label>NRC License</rdfs:label>
        <skos:altLabel>NRC Materials License</skos:altLabel>
        <skos:altLabel>Nuclear Regulatory Commission License</skos:altLabel>
        <skos:definition>A regulatory license issued by the United States Nuclear Regulatory Commission authorizing a specified organization to possess, use, manufacture, distribute, or otherwise conduct regulated activities involving source, byproduct, or special nuclear material within the scope and conditions of the license.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/NanoparticleJettingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/NanoparticleJettingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MaterialJettingCapability"/>
        <rdfs:label>Nanoparticle Jetting</rdfs:label>
        <skos:definition>A material jetting process where droplets containing metallic nanoparticles
            are selectively deposited and consolidated to produce metallic components.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/NasProductCategory -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/NasProductCategory">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Storage%20SystemsProductCategory"/>
        <rdfs:label xml:lang="en">Nas</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/NativeAmericanOwned -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/NativeAmericanOwned">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/OwnershipStatusClassifier"/>
        <rdfs:label xml:lang="en">Native American Owned</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/NaturalFiberProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/NaturalFiberProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FiberProcessingCapability"/>
        <rdfs:label xml:lang="en">Natural Fiber</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process natural
            fibers, which are fibrous materials derived from plants, animals, or minerals and used
            in textiles, composites, packaging, and insulation applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/NavalDefenseIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/NavalDefenseIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/DefenseIndustry"/>
        <rdfs:label>Naval Defense</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving ships, submarines, naval systems, marine components, and support
            products used for military maritime operations, and are intended to realize similar or
            related primary business functions according to their organizational objectives and
            plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/NetworkingEquipmentIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/NetworkingEquipmentIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/TelecommunicationsIndustry"/>
        <rdfs:label>Networking Equipment</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving routers, switches, servers, enclosures, modules, and related
            equipment used in communication and data networks, and are intended to realize similar
            or related primary business functions according to their organizational objectives and
            plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/NickelAlloyProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/NickelAlloyProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Non-FerrousAlloyProcessingCapability"/>
        <rdfs:label>Nickel Alloy</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process nickel
            alloys, which are non-ferrous alloys valued for corrosion resistance, oxidation
            resistance, strength, and high-temperature performance.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/NickelPlatingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/NickelPlatingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ElectroPlatingCapability"/>
        <rdfs:label>Nickel Plating</rdfs:label>
        <skos:definition>A process where a thin layer of nickel is electrochemically deposited onto
            a metal surface to enhance corrosion resistance and wear properties.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/NickelProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/NickelProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Non-FerrousMetalProcessingCapability"/>
        <rdfs:label>Nickel</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process nickel,
            which is a corrosion-resistant non-ferrous metal used in plating, batteries, stainless
            steels, and high-performance alloys.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/NitrideCeramicProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/NitrideCeramicProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CeramicProcessingCapability"/>
        <rdfs:label>Nitride</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process nitride
            ceramic materials, which are compounds containing nitrogen and are often valued for high
            hardness, thermal stability, wear resistance, and electrical or thermal performance.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/NitridingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/NitridingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/DiffusionHardeningCapability"/>
        <rdfs:label>Nitriding</rdfs:label>
        <skos:definition>A process that involves diffusing nitrogen into the surface of a metal to
            create a hard, wear-resistant layer.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/Non-FerrousAlloyProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/Non-FerrousAlloyProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AlloyProcessingCapability"/>
        <rdfs:label>Non-Ferrous Alloy</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process non-ferrous
            alloys, which are alloys that do not contain iron as the principal constituent and are
            often valued for low weight, corrosion resistance, conductivity, or specialized
            properties.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/Non-FerrousMetalProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/Non-FerrousMetalProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PureMetalProcessingCapability"/>
        <rdfs:label>Non-Ferrous Metal</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process non-ferrous
            metals, which are metallic elements or materials that do not contain iron as the
            principal constituent and are often valued for corrosion resistance, conductivity, or
            low density.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/NonwovenMaterialsIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/NonwovenMaterialsIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/TextilesAndApparelIndustry"/>
        <rdfs:label>Nonwoven Materials</rdfs:label>
        <skos:altLabel>Nonwovens</skos:altLabel>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving fibers, sheets, webs, materials, and products manufactured without
            weaving or knitting and used in industrial or consumer applications, and are intended to
            realize similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/NorylProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/NorylProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermoplasticProcessingCapability"/>
        <rdfs:label>Noryl</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process Noryl, which
            is a modified polyphenylene ether engineering thermoplastic valued for dimensional
            stability, electrical insulation, and heat resistance.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/NotchingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/NotchingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SheetMetalProcessingProcessingCapability"/>
        <rdfs:label>Notching</rdfs:label>
        <skos:definition>A process that involves cutting angular or V-shaped indentations along the
            edge or surface of a workpiece, typically using a press.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/NuclearEnergyIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/NuclearEnergyIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/EnergyIndustry"/>
        <rdfs:label>Nuclear Energy</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving equipment, components, materials, controls, and services used in
            nuclear power generation and nuclear energy systems, and are intended to realize similar
            or related primary business functions according to their organizational objectives and
            plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/NylonProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/NylonProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermoplasticProcessingCapability"/>
        <rdfs:label>Nylon</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process nylon, which
            is a polyamide thermoplastic valued for toughness, wear resistance, fatigue resistance,
            and use in gears, bushings, fasteners, and structural plastic parts.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/OHSAS18001Certificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/OHSAS18001Certificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/OccupationalHealthAndSafetyCertificate"/>
        <rdfs:label>OHSAS 18001</rdfs:label>
        <skos:definition>A certificate confirming conformance to OHSAS 18001 occupational health and
            safety management system requirements.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/OccupationalHealthAndSafetyCertificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/OccupationalHealthAndSafetyCertificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Certificate"/>
        <rdfs:label>Occupational Health and Safety Certificate</rdfs:label>
        <skos:definition>A confirmation that an object, person, or organization satisfies specified
            occupational health and safety requirements, competencies, practices, or management
            system standards, typically demonstrated through training, assessment, inspection,
            audit, or external review intended to reduce workplace health and safety risks.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/OffshoreMarineIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/OffshoreMarineIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MarineAndShipbuildingIndustry"/>
        <rdfs:label>Offshore Marine</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving vessels, platforms, systems, components, and services used in
            offshore energy, construction, or maritime operations, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/OffshoreOilAndGasIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/OffshoreOilAndGasIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/OilAndGasIndustry"/>
        <rdfs:label>Offshore Oil and Gas</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving platforms, vessels, equipment, components, systems, and services
            used in offshore exploration, drilling, production, and support operations, and are
            intended to realize similar or related primary business functions according to their
            organizational objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/OilAndGasIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/OilAndGasIndustry">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/supplychain/SupplyChain/Industry"/>
        <rdfs:label>Oil and Gas</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving the design, manufacturing, integration, operation, maintenance,
            distribution, or support of products, systems, equipment, or services associated with
            oil, gas, hydrocarbon, and related industrial operations, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/OilGroovingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/OilGroovingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SinglePointCuttingCapability"/>
        <rdfs:label>Oil Grooving</rdfs:label>
        <skos:definition>A process where specific channels are cut into components to facilitate the
            distribution and retention of lubricating oil.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/OilQuenchHardeningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/OilQuenchHardeningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThroughHardeningCapability"/>
        <rdfs:label>Oil Quench Hardening</rdfs:label>
        <skos:definition>A process where steel is heated to a specific temperature, then rapidly
            cooled in oil to increase hardness and toughness.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/OpenDieForgingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/OpenDieForgingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ForgingCapability"/>
        <rdfs:label>Open Die Forging</rdfs:label>
        <skos:definition>A process where a workpiece is deformed between a set of open dies that do
            not enclose the material entirely, allowing metal flow.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/OptoelectronicsProductCategory -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/OptoelectronicsProductCategory">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Computer%20ComponentsProductCategory"/>
        <rdfs:label xml:lang="en">Optoelectronics</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/OrganizationName -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/OrganizationName">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/DesignativeName"/>
        <rdfs:label xml:lang="en">organization name</rdfs:label>
        <iof-av:naturalLanguageDefinition>identifier that consists of a string of characters that
            designates an entity within a specified cultural or social namespace and which is
            typically a word or phrase in a natural language that has an accepted cultural or social
            significance.</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/OutOfAutoclaveProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/OutOfAutoclaveProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CompositeManufacturingCapability"/>
        <rdfs:label>Out-of-Autoclave Processing</rdfs:label>
        <skos:altLabel>OOA</skos:altLabel>
        <skos:altLabel>OOA Processing</skos:altLabel>
        <skos:definition>A composite manufacturing process where a composite part is cured without
            an autoclave using vacuum, oven, or ambient-pressure curing methods.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/OwnershipStatusClassifier -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/OwnershipStatusClassifier">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SpecialBusinessStatusClassifier"/>
        <rdfs:label xml:lang="en">ownership status classifier</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/OxideCeramicProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/OxideCeramicProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CeramicProcessingCapability"/>
        <rdfs:label>Oxide</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process oxide
            ceramic materials, which are ceramic compounds containing oxygen and are commonly used
            for hardness, corrosion resistance, thermal stability, and electrical insulation.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/OxyFuelCuttingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/OxyFuelCuttingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/TorchCuttingCapability"/>
        <rdfs:label>Oxy-Fuel Cutting</rdfs:label>
        <skos:altLabel>Flame Cutting</skos:altLabel>
        <skos:altLabel>Gas Cutting</skos:altLabel>
        <skos:altLabel>Oxy-Acetylene Cutting</skos:altLabel>
        <skos:altLabel>Oxyfuel Gas Cutting</skos:altLabel>
        <skos:definition>A process where a mixture of oxygen and fuel gases is used to generate a
            flame, capable of cutting through materials like steel.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/OxyacetyleneCuttingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/OxyacetyleneCuttingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FlameHardeningCapability"/>
        <rdfs:label>Oxyacetylene Cutting</rdfs:label>
        <skos:definition>A process where a high-temperature flame from burning acetylene with oxygen
            melts and cuts metal through localized oxidation and rapid heating.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/P20SteelProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/P20SteelProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SteelProcessingCapability"/>
        <rdfs:label>P20 Steel</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process P20 steel,
            which is a pre-hardened mold steel commonly used for plastic injection molds,
            die-casting dies, and tooling applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PBTProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PBTProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermoplasticProcessingCapability"/>
        <rdfs:label>PBT</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process polybutylene
            terephthalate, which is an engineering thermoplastic valued for dimensional stability,
            electrical insulation, chemical resistance, and use in electrical and automotive
            components.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PCBAssemblyCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PCBAssemblyCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/JoiningCapability"/>
        <rdfs:label>PCB Assembly</rdfs:label>
        <skos:definition>A process where electronic components are mounted and soldered onto printed
            circuit boards using methods such as surface-mount, through-hole, or mixed assembly.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PCBFabricationCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PCBFabricationCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ManufacturedProductFamilyCapability"/>
        <rdfs:label>PCB Fabrication</rdfs:label>
        <skos:definition>A process where bare printed circuit boards are manufactured through steps
            such as lamination, photolithography, etching, drilling, plating, and surface finishing
            before component assembly</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PCDProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PCDProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/DiamondCompositeProcessingCapability"/>
        <rdfs:label>PCD</rdfs:label>
        <skos:altLabel>Polycrystalline Diamond</skos:altLabel>
        <skos:definition>The capability of a manufacturing system or machine to process
            polycrystalline diamond, which is a diamond composite made from bonded diamond grains
            and commonly used for cutting tools, wear parts, and precision machining applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PETProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PETProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermoplasticProcessingCapability"/>
        <rdfs:label>PET</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process polyethylene
            terephthalate, which is a thermoplastic polyester used in packaging, fibers, films, and
            engineering plastic components.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PLCProgrammingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PLCProgrammingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/EngineeringCapability"/>
        <rdfs:label>PLC programming capability</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PPSProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PPSProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermoplasticProcessingCapability"/>
        <rdfs:label>PPS</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process
            polyphenylene sulfide, which is a high-performance thermoplastic valued for chemical
            resistance, dimensional stability, and high-temperature performance.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PVCProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PVCProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermoplasticProcessingCapability"/>
        <rdfs:label>PVC</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process polyvinyl
            chloride, which is a versatile thermoplastic used in piping, profiles, films, cable
            insulation, and chemical-resistant components.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PackagingIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PackagingIndustry">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/supplychain/SupplyChain/Industry"/>
        <rdfs:label>Packaging</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving the design, manufacturing, integration, operation, maintenance,
            distribution, or support of products, systems, equipment, or services associated with
            packaging products, packaging systems, and packaged-goods supply chains, and are
            intended to realize similar or related primary business functions according to their
            organizational objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PackingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PackingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ManufacturingProcessCapability"/>
        <rdfs:label>Packing</rdfs:label>
        <skos:altLabel>packaging</skos:altLabel>
        <skos:definition>A process where finished products are securely enclosed in containers or
            packaging materials for protection, storage, and transportation.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PalladiumProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PalladiumProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Non-FerrousMetalProcessingCapability"/>
        <rdfs:label>Palladium</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process palladium,
            which is a precious metal used in catalysts, electronics, hydrogen-related applications,
            and specialized jewelry or dental products.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PassengerRailIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PassengerRailIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RailAndTransitIndustry"/>
        <rdfs:label>Passenger Rail</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving rail vehicles, components, systems, equipment, and services used to
            transport passengers by rail, and are intended to realize similar or related primary
            business functions according to their organizational objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PassengerVehiclesIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PassengerVehiclesIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AutomotiveIndustry"/>
        <rdfs:label>Passenger Vehicles</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving vehicles, components, systems, and services used in cars and
            light-duty vehicles intended for personal transportation, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PassivationCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PassivationCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CoatingCapability"/>
        <rdfs:label>Passivation</rdfs:label>
        <skos:altLabel>Passivating</skos:altLabel>
        <skos:definition>A process that involves treating or coating a metal to reduce the chemical
            reactivity of its surface, enhancing its corrosion resistance.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PdusProductCategory -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PdusProductCategory">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Power%20%26%20InfrastructureProductCategory"/>
        <rdfs:label xml:lang="en">Pdus</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PeekProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PeekProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermoplasticProcessingCapability"/>
        <rdfs:label>Peek</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process polyether
            ether ketone, which is a high-performance thermoplastic valued for high temperature
            resistance, chemical resistance, strength, and wear performance.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PeenFormingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PeenFormingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FormingCapability"/>
        <rdfs:label>Peen Forming</rdfs:label>
        <skos:definition>A process where controlled shot impacts induce plastic deformation,
            creating curvature in metal sheets by generating compressive stresses on the surface.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PeeningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PeeningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ShotPeeningCapability"/>
        <rdfs:label>Peening</rdfs:label>
        <skos:definition>A process that involves bombarding a metal surface with small spheres to
            induce compressive stresses, enhancing fatigue resistance and preventing crack
            propagation.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PercussionWeldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PercussionWeldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ElectricalResistanceWeldingCapability"/>
        <rdfs:label>Percussion Welding</rdfs:label>
        <skos:definition>A process where rapid, controlled energy pulses create high-intensity
            impacts to fuse materials together without the need for filler metals or fluxes.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PerforatingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PerforatingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/HoleMakingCapability"/>
        <rdfs:label>Perforating</rdfs:label>
        <skos:definition>A process where holes are precisely punched or drilled into materials to
            enhance functionality, such as ventilation, filtration, or weight reduction.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PeripheralsProductCategory -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PeripheralsProductCategory">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Connectivity%20%26%20AccessoriesProductCategory"/>
        <rdfs:label xml:lang="en">Peripherals</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PermanentMoldCastingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PermanentMoldCastingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/GravityCastingCapability"/>
        <rdfs:label>Permanent Mold Casting</rdfs:label>
        <skos:definition>A process where molten metal is poured into a reusable mold, cooled, and
            solidified to form a part, known as permanent mold casting.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PersonalCareProductsIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PersonalCareProductsIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ConsumerProductsIndustry"/>
        <rdfs:label>Personal Care Products</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving products, packaging, components, and devices used for grooming,
            hygiene, cosmetics, and personal wellness applications, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PetrochemicalProcessingIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PetrochemicalProcessingIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/OilAndGasIndustry"/>
        <rdfs:label>Petrochemical Processing</rdfs:label>
        <skos:altLabel>Chemical and Petrochemical</skos:altLabel>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving equipment, systems, components, materials, and services used to
            convert petroleum or natural gas feedstocks into chemicals and related products, and are
            intended to realize similar or related primary business functions according to their
            organizational objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PharmaceuticalManufacturingIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PharmaceuticalManufacturingIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PharmaceuticalsAndBiotechnologyIndustry"/>
        <rdfs:label>Pharmaceutical Manufacturing</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving equipment, systems, materials, packaging, and services used to
            manufacture, process, test, or package pharmaceutical products, and are intended to
            realize similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PharmaceuticalsAndBiotechnologyIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PharmaceuticalsAndBiotechnologyIndustry">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/supplychain/SupplyChain/Industry"/>
        <rdfs:label>Pharmaceuticals and Biotechnology</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving the design, manufacturing, integration, operation, maintenance,
            distribution, or support of products, systems, equipment, or services associated with
            pharmaceutical, biotechnology, and life-science products, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PhosphateCoatingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PhosphateCoatingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CoatingCapability"/>
        <rdfs:label>Phosphate Coating</rdfs:label>
        <skos:definition>A process where metal surfaces are treated with a solution of phosphoric
            acid and phosphates to form a protective, corrosion-resistant layer.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PhosphateConversionCoatingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PhosphateConversionCoatingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ChemicalConversionCoatingCapability"/>
        <rdfs:label>Phosphate Conversion Coating</rdfs:label>
        <skos:definition>A process where a metal surface is treated with a phosphate solution to
            form a layer of insoluble crystalline phosphates for corrosion resistance and paint
            adhesion.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PhosphatingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PhosphatingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PhosphateConversionCoatingCapability"/>
        <rdfs:label>Phosphating</rdfs:label>
        <skos:definition>A process that applies a phosphate coating to metal surfaces to enhance
            corrosion resistance, improve paint adhesion, and reduce friction.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PhosphorBronzeProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PhosphorBronzeProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/BronzeProcessingCapability"/>
        <rdfs:label>Phosphor Bronze</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process phosphor
            bronze, which is a copper-tin-phosphorus alloy valued for fatigue resistance, spring
            properties, wear resistance, and electrical conductivity.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PhotoEtchingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PhotoEtchingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/EtchingCapability"/>
        <rdfs:label>Photo Etching</rdfs:label>
        <skos:definition>A process where metal sheets are selectively dissolved using chemical
            etchants through a photoresist mask to create precise, intricate patterns.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PhotochemicalMachiningProcessCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PhotochemicalMachiningProcessCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ChemicalMachiningCapability"/>
        <rdfs:label>Photochemical Machining</rdfs:label>
        <skos:definition>A process where controlled photochemical reactions remove material to form
            precise, complex metal parts with tight tolerances.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PhotolithographyCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PhotolithographyCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SemiconductorFabricatingCapability"/>
        <rdfs:label>Photolithography</rdfs:label>
        <skos:definition>A process where light is used to transfer geometric patterns from a mask
            onto a photoresist-coated substrate for semiconductor or microfabrication applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PhysicalVaporDepositionCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PhysicalVaporDepositionCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/VaporizedMetalCoatingCapability"/>
        <rdfs:label>Physical Vapor Deposition</rdfs:label>
        <skos:definition>A process where material is vaporized from a solid source and condensed
            onto a substrate, forming a thin film, in a vacuum environment.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PicklingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PicklingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ChemicalPolishingCapability"/>
        <rdfs:label>Pickling</rdfs:label>
        <skos:definition>A process that removes oxides and scale from metal surfaces using acidic
            solutions, enhancing surface finish and preparing for subsequent treatments.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PiercingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PiercingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PunchingCapability"/>
        <rdfs:label>Piercing</rdfs:label>
        <skos:definition>a process ability to consistently produce products or services that meet
            customer specifications or requirements.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PipeBendingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PipeBendingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/BendingCapability"/>
        <rdfs:label>Pipe Bending</rdfs:label>
        <skos:definition>A process where pipes are plastically deformed using mechanical force or
            heat to achieve specific angles or curves without compromising structural integrity.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PlanarizationCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PlanarizationCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PolishingCapability"/>
        <rdfs:label>Planarization</rdfs:label>
        <skos:definition>A process that involves flattening and smoothing a surface to achieve a
            uniform, level plane in semiconductor manufacturing.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PlaningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PlaningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SinglePointCuttingCapability"/>
        <owl:disjointWith rdf:resource="http://asu.edu/semantics/SUDOKN/ShapingCapability"/>
        <rdfs:label>Planing</rdfs:label>
        <skos:definition>A process that involves shaving off layers from a material&apos;s surface
            to achieve a smooth, flat finish using a planing machine.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PlasmaArcWeldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PlasmaArcWeldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/HighEnergyBeamWeldingCapability"/>
        <rdfs:label>Plasma Arc Welding</rdfs:label>
        <skos:definition>A process where a constricted plasma arc melts the workpiece and filler
            material, creating a joint upon solidification.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PlasmaCuttingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PlasmaCuttingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/TorchCuttingCapability"/>
        <rdfs:label>Plasma Cutting</rdfs:label>
        <skos:altLabel>Plasma Arc Cutting</skos:altLabel>
        <skos:definition>A process where an accelerated jet of hot plasma cuts through electrically
            conductive materials, utilizing high-speed, precision-guided technology.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PlasmaEnhancedChemicalVaporDepositionCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PlasmaEnhancedChemicalVaporDepositionCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ChemicalVaporDepositionCapability"/>
        <rdfs:label>Plasma Enhanced Chemical Vapor Deposition</rdfs:label>
        <skos:definition>A process where plasma is used to enhance chemical vapor deposition,
            enabling thin film deposition at lower temperatures with improved film quality and
            adhesion.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PlasmaSprayingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PlasmaSprayingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermalSprayCoatingCapability"/>
        <rdfs:label>Plasma Spraying</rdfs:label>
        <skos:definition>A process where a high-temperature plasma jet melts particles, which are
            then sprayed onto a substrate to form a coating.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PlasterMoldCastingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PlasterMoldCastingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CastingCapability"/>
        <rdfs:label>Plaster Mold Casting</rdfs:label>
        <skos:definition>A process where a plaster mixture is used to create a mold for casting
            non-ferrous materials, typically involving a two-part mold system.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PlasticMachiningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PlasticMachiningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SpecializedMachiningCapability"/>
        <rdfs:label>Plastic Machining</rdfs:label>
        <skos:definition>A process where solid blocks of plastic are precisely cut, drilled, or
            shaped using specialized tools or CNC machines to create specific components.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PlasticProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PlasticProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PolymerProcessingCapability"/>
        <rdfs:label xml:lang="en">Plastic</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process plastic
            materials, which are moldable polymeric materials used extensively in consumer,
            industrial, medical, electrical, and engineering applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PlateRollingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PlateRollingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RollingCapability"/>
        <rdfs:label>Plate Rolling</rdfs:label>
        <skos:definition>A process where metal plates are passed through rollers to reduce thickness
            and form cylindrical or conical shapes with precise dimensions.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PlatingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PlatingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ChemicalCoatingCapability"/>
        <rdfs:label>Plating</rdfs:label>
        <skos:definition>A process where a thin layer of metal is deposited onto the surface of a
            workpiece to enhance corrosion resistance, wear resistance, or aesthetics.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PlatinumProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PlatinumProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Non-FerrousMetalProcessingCapability"/>
        <rdfs:label>Platinum</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process platinum,
            which is a dense, corrosion-resistant precious metal used in catalysts, medical devices,
            electronics, jewelry, and high-temperature applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PlexiglasProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PlexiglasProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermoplasticProcessingCapability"/>
        <rdfs:label>Plexiglas</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process Plexiglas,
            which is an acrylic thermoplastic valued for optical clarity, weather resistance, and
            lightweight transparent components.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PlungeGrindingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PlungeGrindingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/GrindingCapability"/>
        <rdfs:label>Plunge Grinding</rdfs:label>
        <skos:altLabel>Infeed Grinding</skos:altLabel>
        <skos:definition>A process where a workpiece is ground by a grinding wheel, moving axially
            into the workpiece to remove material.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PlywoodProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PlywoodProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/WoodProcessingCapability"/>
        <rdfs:label>Plywood</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process plywood,
            which is an engineered wood panel made from bonded layers of wood veneer and used in
            structural, furniture, packaging, and tooling applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PolishingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PolishingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SurfacePreparationCapability"/>
        <rdfs:label>Polishing</rdfs:label>
        <skos:definition>A process that involves abrading materials to a smooth, reflective surface,
            reducing surface roughness and removing surface defects.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PolycarbonateProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PolycarbonateProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermoplasticProcessingCapability"/>
        <rdfs:label>Polycarbonate</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process
            polycarbonate, which is a tough, transparent engineering thermoplastic valued for impact
            resistance, dimensional stability, and optical clarity.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PolycrystallineDiamondMachiningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PolycrystallineDiamondMachiningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SpecializedMachiningCapability"/>
        <rdfs:label>Polycrystalline Diamond Machining</rdfs:label>
        <skos:altLabel>PCD Machining</skos:altLabel>
        <skos:definition>A process where a polycrystalline diamond, a high-performance cutting tool
            material, is used to machine extremely hard and abrasive materials.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PolyethyleneProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PolyethyleneProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermoplasticProcessingCapability"/>
        <rdfs:label>Polyethylene</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process
            polyethylene, which is a widely used thermoplastic valued for chemical resistance,
            toughness, low friction, and use in packaging, piping, sheets, and containers.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PolymerDepositionCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PolymerDepositionCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AdditiveManufacturingCapability"/>
        <rdfs:label>Polymer Deposition</rdfs:label>
        <skos:definition>The process of creating a layer of polymer material on a substrate.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PolymerProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PolymerProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MaterialProcessingCapability"/>
        <rdfs:label>Polymer</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process polymer
            materials, which are substances composed of long molecular chains and are commonly used
            for lightweight, corrosion-resistant, insulating, flexible, or moldable products.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PolypropyleneProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PolypropyleneProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermoplasticProcessingCapability"/>
        <rdfs:label>Polypropylene</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process
            polypropylene, which is a lightweight, chemically resistant thermoplastic used in
            packaging, living hinges, automotive parts, fibers, and consumer products.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PolysulfoneProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PolysulfoneProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermoplasticProcessingCapability"/>
        <rdfs:label>Polysulfone</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process polysulfone,
            which is a high-performance thermoplastic valued for heat resistance, hydrolytic
            stability, toughness, and use in medical, filtration, and electrical components.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PolywoodProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PolywoodProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PolyethyleneProcessingCapability"/>
        <rdfs:label>Polywood</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process Polywood,
            which is a polyethylene-based lumber-like material commonly used for outdoor furniture
            and durable consumer products.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PowderCoatingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PowderCoatingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MechanicalCoatingCapability"/>
        <rdfs:label>Powder Coating</rdfs:label>
        <skos:definition>A process where dry, free-flowing thermoplastic or thermoset powder
            material is applied to a surface, then cured under heat to form a solid coating.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PowderCompactingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PowderCompactingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PowderMetalFormingCapability"/>
        <rdfs:label>Powder Compacting</rdfs:label>
        <skos:definition>A process where metal or ceramic powders are compressed into a solid mass
            using a die, achieving high density and structural integrity.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PowderDepositionCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PowderDepositionCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AdditiveManufacturingCapability"/>
        <rdfs:label>Powder Deposition</rdfs:label>
        <skos:altLabel>powder bed fusion</skos:altLabel>
        <skos:definition>The process where materials are added in powder form to a molten pool
            created by a high-energy source, typically a laser or electron beam.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PowderMetalFormingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PowderMetalFormingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FormingCapability"/>
        <rdfs:label>Powder Metal Forming</rdfs:label>
        <skos:altLabel>powder metallurgy</skos:altLabel>
        <skos:definition>A process where metallic powders are compacted under high pressure and
            heated to form solid metal parts through sintering.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PowderMetallurgyCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PowderMetallurgyCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PowderMetalFormingCapability"/>
        <rdfs:label>Powder Metallurgy</rdfs:label>
        <skos:definition>A process where metal powders are compacted and sintered to form solid
            components with precise dimensions and controlled microstructures.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PowerElectronicsIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PowerElectronicsIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ElectronicsIndustry"/>
        <rdfs:label>Power Electronics</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving components, devices, assemblies, and systems used to convert,
            control, condition, or distribute electrical power, and are intended to realize similar
            or related primary business functions according to their organizational objectives and
            plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PreGalvanizedSteelProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PreGalvanizedSteelProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/GalvanizedSteelProcessingCapability"/>
        <rdfs:label>Pre Galvanized Steel</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process
            pre-galvanized steel, which is steel galvanized before subsequent forming, cutting, or
            fabrication operations.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PreciousMetalProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PreciousMetalProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MetalProcessingCapability"/>
        <rdfs:label>Precious Metal</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process precious
            metals, which are rare, high-value metals such as gold, silver, platinum, and palladium
            used for corrosion resistance, conductivity, jewelry, medical, and electronic
            applications.</skos:definition>
        <iof-av:usageNote>Do not add sub-classes under this class. Specific material processing
            capabilities that can be classified as &apos;precious&apos; metal processing capability
            are placed under their prime material processing category.</iof-av:usageNote>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PrecisionAgricultureIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PrecisionAgricultureIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AgricultureIndustry"/>
        <rdfs:label>Precision Agriculture</rdfs:label>
        <skos:altLabel>Digital Agriculture</skos:altLabel>
        <skos:altLabel>Smart Agriculture</skos:altLabel>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving sensors, positioning systems, data systems, automation technologies,
            and decision-support tools used to improve agricultural operations, and are intended to
            realize similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PrecisionBoringCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PrecisionBoringCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/BoringCapability"/>
        <rdfs:label>Precision Boring</rdfs:label>
        <skos:definition>A process where boring operations are performed with high accuracy and fine
            tolerances to achieve precise hole diameters and smooth finishes.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PrecisionCuttingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PrecisionCuttingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ConventionalMachiningCapability"/>
        <rdfs:label>Precision Cutting</rdfs:label>
        <skos:altLabel>precision machining</skos:altLabel>
        <skos:definition>A process where materials are cut with high accuracy and fine tolerances
            using specialized tools or advanced cutting technologies.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PrecisionFabricationCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PrecisionFabricationCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FabricatingCapability"/>
        <rdfs:label>Precision Fabrication</rdfs:label>
        <skos:definition>A process where fabrication techniques are applied with tight tolerances
            and high accuracy to produce components for critical applications such as aerospace,
            defense, and medical devices.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PrecisionMachiningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PrecisionMachiningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MachiningCapability"/>
        <rdfs:label>Precision Machining</rdfs:label>
        <skos:definition>A process where advanced machining methods are used to achieve tight
            tolerances, fine surface finishes, and high dimensional accuracy.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PrecisionMetalCuttingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PrecisionMetalCuttingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PrecisionCuttingCapability"/>
        <rdfs:label>Precision Metal Cutting</rdfs:label>
        <skos:definition>A process where metals are cut with fine tolerances and smooth finishes
            using advanced cutting methods such as laser, EDM, or waterjet.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PrecisionMoldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PrecisionMoldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MoldingCapability"/>
        <rdfs:label>Precision Molding</rdfs:label>
        <skos:definition>A process where molding techniques are applied with tight tolerances and
            fine detail to produce high-accuracy parts for critical applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PrecisionPCBAssemblyCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PrecisionPCBAssemblyCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PCBAssemblyCapability"/>
        <rdfs:label>Precision PCB Assembly</rdfs:label>
        <skos:definition>A process where electronic components are assembled on printed circuit
            boards with high accuracy, tight tolerances, and strict quality standards.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PrecisionWeldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PrecisionWeldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermalWeldingCapability"/>
        <rdfs:label>Precision Welding</rdfs:label>
        <skos:definition>A process where welding techniques are applied with tight control to
            achieve high accuracy, minimal heat distortion, and fine detail for critical
            applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PrepregLayupCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PrepregLayupCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CompositeManufacturingCapability"/>
        <rdfs:label>Prepreg Layup</rdfs:label>
        <skos:definition>A composite manufacturing process where pre-impregnated reinforcement
            materials are placed in a mold or on a tool to form a composite part.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PressFittingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PressFittingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MechanicalJoiningCapability"/>
        <rdfs:label>Press Fitting</rdfs:label>
        <skos:definition>A process where components are joined by being pressed into each other
            under high pressure, creating a tight, secure connection without welding or adhesives.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PressForgingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PressForgingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ForgingCapability"/>
        <rdfs:label>Press Forging</rdfs:label>
        <skos:definition>A process where metal is heated and shaped under high pressure using a
            press, resulting in high-strength, durable components.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PressFormingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PressFormingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FormingCapability"/>
        <rdfs:label>Press Forming</rdfs:label>
        <skos:definition>A process where sheet metal is shaped by applying pressure through a die,
            utilizing mechanical or hydraulic presses to achieve precise geometries.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PressWorkCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PressWorkCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/StampingCapability"/>
        <rdfs:label>Press Work</rdfs:label>
        <skos:definition>A process where metal sheets are shaped and cut using a press machine,
            employing dies and punches to achieve precise dimensions and geometries.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PressureWeldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PressureWeldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MechanicalWeldingCapability"/>
        <rdfs:label>Pressure Welding</rdfs:label>
        <skos:definition>A process where metals are joined under high pressure and elevated
            temperature, causing coalescence without the need for a filler material.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PrintedCircuitBoardsIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PrintedCircuitBoardsIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ElectronicsIndustry"/>
        <rdfs:label>Printed Circuit Boards</rdfs:label>
        <skos:altLabel>PCB</skos:altLabel>
        <skos:altLabel>PCBs</skos:altLabel>
        <skos:altLabel>Printed Wiring Boards</skos:altLabel>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving printed circuit boards, substrates, assemblies, fabrication
            services, and related components used in electronic systems, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PrintingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PrintingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CoatingCapability"/>
        <rdfs:label xml:lang="en">Painting</rdfs:label>
        <skos:definition>A process where a protective or decorative coating is applied to a surface
            using various methods such as spraying, brushing, or dipping.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ProcessAnnealingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ProcessAnnealingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RecrystallizationCapability"/>
        <rdfs:label>Process Annealing</rdfs:label>
        <skos:definition>A process where metals are heated below their recrystallization
            temperature, then cooled to reduce hardness and increase ductility for further
            processing.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ProcessorsProductCategory -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ProcessorsProductCategory">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Computer%20ComponentsProductCategory"/>
        <rdfs:label xml:lang="en">Processors</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ProductCategoryClassifier -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ProductCategoryClassifier">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Classifier"/>
        <rdfs:label xml:lang="en">Product category classifier</rdfs:label>
        <iof-av:naturalLanguageDefinition>classifier designed to categorize products based on their
            type, function, or intended use within a specific domain or industry</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ProductComplianceCertificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ProductComplianceCertificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Certificate"/>
        <rdfs:label>Product Compliance Certificate</rdfs:label>
        <skos:definition>A certificate confirming that a product has demonstrated conformance to
            specified requirements, standards, regulations, guidelines, or certification criteria,
            typically through testing, inspection, assessment, auditing, verification, or
            certification activities related to the product&apos;s characteristics, composition,
            performance, safety, quality, or production methods.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ProfessionalCertificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ProfessionalCertificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Certificate"/>
        <rdfs:label>Professional Certificate</rdfs:label>
        <skos:definition>A confirmation that a person has achieved specified professional knowledge,
            skills, competencies, qualifications, or training requirements, typically demonstrated
            through education, examination, assessment, practice, or external review related to a
            profession, occupation, or specialized field of work.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ProgressivePressStampingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ProgressivePressStampingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/StampingCapability"/>
        <rdfs:label>Progressive Press Stamping</rdfs:label>
        <skos:definition>a high-speed, automated metal forming process where a strip of metal is fed
            continuously through a stamping press equipped with a progressive die.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ProjectionWeldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ProjectionWeldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ElectricalResistanceWeldingCapability"/>
        <rdfs:label>Projection Welding</rdfs:label>
        <skos:definition>A process where two metal pieces are joined by applying heat and pressure,
            generated by electric current, through a shaped electrode.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ProstheticsAndOrthoticsIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ProstheticsAndOrthoticsIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/HealthcareAndMedicalDevicesIndustry"/>
        <rdfs:label>Prosthetics and Orthotics</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving devices, components, materials, and support products used to
            replace, support, align, or improve human body function, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ProtectiveTextilesIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ProtectiveTextilesIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/TextilesAndApparelIndustry"/>
        <rdfs:label>Protective Textiles</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving fabrics, garments, materials, and products designed to provide
            protection from physical, chemical, thermal, biological, or environmental hazards, and
            are intended to realize similar or related primary business functions according to their
            organizational objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PulsedGasMetalArcWeldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PulsedGasMetalArcWeldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/GasMetalArcWeldingCapability"/>
        <rdfs:label>Pulsed Gas Metal Arc Welding</rdfs:label>
        <skos:altLabel>GMAW-P</skos:altLabel>
        <skos:definition>A process where a consumable wire electrode is fed continuously, and the
            welding current is pulsed to provide better control over heat input, spatter reduction,
            and improved weld quality, especially in thin or out-of-position materials.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PulsedGasTungstenArcWeldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PulsedGasTungstenArcWeldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/GasTungstenArcWeldingCapability"/>
        <owl:disjointWith rdf:resource="http://asu.edu/semantics/SUDOKN/TIGWeldingCapability"/>
        <rdfs:label>Pulsed Gas Tungsten Arc Welding</rdfs:label>
        <skos:altLabel>GTAW-P</skos:altLabel>
        <skos:definition>A process where a non-consumable tungsten electrode is used to produce an
            arc, and the welding current is pulsed to control heat input and improve weld quality,
            commonly used for precision welding of thin or heat-sensitive materials.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PultrusionCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PultrusionCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ResinTransferMoldingCapability"/>
        <rdfs:label>Pultrusion</rdfs:label>
        <skos:altLabel>Pultrusion Process</skos:altLabel>
        <skos:definition>A process where continuous fibers are impregnated with resin and pulled
            through a heated die to form constant cross-section composite profiles.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PunchingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PunchingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SheetMetalProcessingProcessingCapability"/>
        <rdfs:label>Punching</rdfs:label>
        <skos:definition>A process where a punch press applies high force to a tool or die, creating
            holes in a workpiece by removing material.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/PureMetalProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/PureMetalProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MetalProcessingCapability"/>
        <rdfs:label>Pure Metal</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process pure metals,
            which are metallic elements consisting predominantly of a single chemical element rather
            than an engineered alloy.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/QS9000Certificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/QS9000Certificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/QSQualityCertificate"/>
        <rdfs:label xml:lang="en">QS 9000</rdfs:label>
        <skos:definition>A quality certificate confirming conformance to QS-9000 automotive quality
            system requirements.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/QSQualityCertificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/QSQualityCertificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/QualityCertificate"/>
        <rdfs:label xml:lang="en">QS Quality</rdfs:label>
        <skos:definition>A quality certificate confirming conformance to QS quality management
            requirements.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/QualityCertificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/QualityCertificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Certificate"/>
        <rdfs:label xml:lang="en">Quality Certificate</rdfs:label>
        <skos:definition>A confirmation that a person has demonstrated the ability to perform
            specified welding procedures in accordance with requirements established by the American
            Welding Society (AWS), typically through practical performance testing and certification
            activities related to welding processes and applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/QualityManagementCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/QualityManagementCapability">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/supplychain/SupplyChain/ProductionCapability"/>
        <rdfs:label xml:lang="en">quality management capability</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/QuenchHardeningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/QuenchHardeningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/HardeningCapability"/>
        <rdfs:label>Quench Hardening</rdfs:label>
        <skos:definition>A process where metal is rapidly cooled from austenitizing temperature to
            increase hardness and strength by forming martensitic microstructures.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/QuenchingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/QuenchingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/HardeningCapability"/>
        <rdfs:label>Quenching</rdfs:label>
        <skos:definition>A process where heated metal is rapidly cooled in water, oil, or air to
            increase hardness and strength by altering its microstructure.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/RISQSAccreditation -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/RISQSAccreditation">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RailwayAccreditation"/>
        <rdfs:label>RISQS Accreditation</rdfs:label>
        <skos:altLabel>Railway Industry Supplier Qualification Scheme Accreditation</skos:altLabel>
        <skos:definition>An accreditation confirming that an organization has demonstrated
            conformance to railway industry supplier qualification requirements.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/RadelProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/RadelProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermoplasticProcessingCapability"/>
        <rdfs:label>Radel</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process Radel, which
            is a polyphenylsulfone engineering thermoplastic valued for high heat resistance,
            toughness, chemical resistance, and sterilization resistance.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/RailAndTransitIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/RailAndTransitIndustry">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/supplychain/SupplyChain/Industry"/>
        <rdfs:label>Rail and Transit</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving the design, manufacturing, integration, operation, maintenance,
            distribution, or support of products, systems, equipment, or services associated with
            rail transportation, public transit, and mobility infrastructure, and are intended to
            realize similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/RailEquipmentIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/RailEquipmentIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RailAndTransitIndustry"/>
        <rdfs:label>Rail Equipment</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving rail vehicles, track components, signaling systems, maintenance
            equipment, and related products used in rail operations, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/RailwayAccreditation -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/RailwayAccreditation">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Accreditation"/>
        <rdfs:label>Railway Accreditation</rdfs:label>
        <skos:definition>An accreditation confirming competence and conformance to requirements
            applicable to the railway industry.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/RamEDMCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/RamEDMCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/EDMCapability"/>
        <rdfs:label>Ram EDM</rdfs:label>
        <skos:definition>A process that utilizes electrical discharges to remove material from a
            workpiece, specifically through a series of rapidly recurring current discharges.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/RapidPrototypingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/RapidPrototypingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/EngineeringCapability"/>
        <rdfs:label>rapid prototyping capability</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ReactionInjectionMoldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ReactionInjectionMoldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/InjectionMoldingCapability"/>
        <rdfs:label>Reaction Injection Molding</rdfs:label>
        <skos:definition>A process where two liquid components are mixed and injected into a mold to
            chemically react and form a thermosetting polymer.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ReamingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ReamingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/HoleMakingCapability"/>
        <rdfs:label>Reaming</rdfs:label>
        <skos:definition>A process that involves enlarging pre-drilled holes to precise dimensions
            using a multi-edged fluted cutting tool known as a reamer.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/RecoveryAnnealingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/RecoveryAnnealingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AnnealingCapability"/>
        <rdfs:label>Recovery Annealing</rdfs:label>
        <skos:definition>A process where heat treatment is applied to cold-worked metal to restore
            its ductility and reduce its hardness and internal stresses.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/RecreationalMarineIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/RecreationalMarineIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MarineAndShipbuildingIndustry"/>
        <rdfs:label>Recreational Marine</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving boats, marine products, engines, accessories, and components used in
            recreational boating and leisure marine activities, and are intended to realize similar
            or related primary business functions according to their organizational objectives and
            plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/RecrystallizationCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/RecrystallizationCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AnnealingCapability"/>
        <rdfs:label>Recrystallization</rdfs:label>
        <skos:definition>A process where a material is heated to high temperatures to form new,
            strain-free grains, reducing defects and enhancing mechanical properties.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/RegulatoryApproval -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/RegulatoryApproval">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RegulatoryAuthorization"/>
        <rdfs:label>Regulatory Approval</rdfs:label>
        <skos:definition>A regulatory authorization issued by a governmental or regulatory authority confirming that an organization, product, process, facility, or activity has demonstrated compliance with applicable regulatory requirements and is authorized to perform specified regulated activities or place regulated products into service or on the market.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/RegulatoryAuthorization -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/RegulatoryAuthorization">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ConformityAttestation"/>
        <rdfs:label>Regulatory Authorization</rdfs:label>
        <skos:definition>An attestation issued by a regulatory authority granting permission,
            approval, registration, clearance, or license to conduct specified activities or market
            specified products.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/RegulatoryClearance -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/RegulatoryClearance">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RegulatoryAuthorization"/>
        <rdfs:label>Regulatory Clearance</rdfs:label>
        <skos:definition>A regulatory authorization issued by a governmental or regulatory authority confirming that a product, process, facility, or activity has satisfied the requirements of an applicable clearance pathway and may proceed within the scope of that clearance.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/RegulatoryComplianceCertificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/RegulatoryComplianceCertificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Certificate"/>
        <rdfs:label>Regulatory Compliance Certificate</rdfs:label>
        <skos:definition>A certificate confirming conformance to specified regulatory requirements
            established by a governmental or regulatory authority.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/RegulatoryLicense -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/RegulatoryLicense">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RegulatoryAuthorization"/>
        <rdfs:label>Regulatory License</rdfs:label>
        <skos:definition>A regulatory authorization issued by a governmental or regulatory authority granting permission to an organization or person to conduct specified regulated activities, typically subject to defined conditions, scope, and duration.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/RegulatoryRegistration -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/RegulatoryRegistration">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RegulatoryAuthorization"/>
        <rdfs:label>Regulatory Registration</rdfs:label>
        <skos:definition>A regulatory authorization or formal recognition resulting from the recording of an organization, facility, product, or activity with a governmental or regulatory authority in accordance with applicable requirements.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ReneProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ReneProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/NickelAlloyProcessingCapability"/>
        <rdfs:label>Rene</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process René alloys,
            which are nickel-based superalloys used in turbine, aerospace, and other
            high-temperature applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/RenewableEnergyIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/RenewableEnergyIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/EnergyIndustry"/>
        <rdfs:label>Renewable Energy</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving equipment, components, materials, systems, and services used to
            generate, store, transmit, or support energy from renewable sources, and are intended to
            realize similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ResidentialConstructionIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ResidentialConstructionIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ConstructionAndInfrastructureIndustry"/>
        <rdfs:label>Residential Construction</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving materials, equipment, components, systems, and services used in the
            construction, renovation, or maintenance of residential buildings, and are intended to
            realize similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ResinInfusionCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ResinInfusionCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CompositeManufacturingCapability"/>
        <rdfs:label>Resin Infusion</rdfs:label>
        <skos:definition>A composite manufacturing process where liquid resin is introduced into a
            dry fiber preform to produce a composite part.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ResinTransferMoldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ResinTransferMoldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/TransferMoldingCapability"/>
        <rdfs:label>Resin Transfer Molding</rdfs:label>
        <skos:definition>A process where a fiber preform is placed into a mold, and then liquid
            resin is injected to impregnate the fibers and harden into shape.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ResistanceBrazingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ResistanceBrazingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/BrazingCapability"/>
        <rdfs:label>Resistance Brazing</rdfs:label>
        <skos:definition>A process where heat is generated through electrical resistance to join
            metal pieces using a filler metal, without melting the base materials.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ResistanceSolderingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ResistanceSolderingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SolderingCapability"/>
        <rdfs:label>Resistance Soldering</rdfs:label>
        <skos:definition>A process where heat generated from electrical resistance is used to melt
            solder, creating a robust joint between two metal pieces.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ResistanceSpotWeldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ResistanceSpotWeldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SpotWeldingCapability"/>
        <rdfs:label>Resistance Spot Welding</rdfs:label>
        <skos:definition>A process where metal surfaces are joined by applying pressure and heat
            generated from an electrical current through electrodes at the weld point.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ResistanceWeldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ResistanceWeldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ElectricalResistanceWeldingCapability"/>
        <rdfs:label>Resistance Welding</rdfs:label>
        <skos:definition>A process where electrical resistance generates heat to join metal surfaces
            by applying pressure, forming a weld without additional filler materials.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ReverseEngineeringCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ReverseEngineeringCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/EngineeringCapability"/>
        <rdfs:label>reverse engineering capability</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/RigidPackagingIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/RigidPackagingIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PackagingIndustry"/>
        <rdfs:label>Rigid Packaging</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving bottles, cans, jars, tubs, boxes, closures, materials, and equipment
            used to package products with rigid packaging formats, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/RingRollingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/RingRollingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RollingCapability"/>
        <rdfs:label>Ring Rolling</rdfs:label>
        <skos:definition>A process where a pre-formed metal ring is incrementally deformed between
            rollers to increase diameter and reduce wall thickness, enhancing material properties.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/RivetingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/RivetingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MechanicalJoiningCapability"/>
        <rdfs:label>Riveting</rdfs:label>
        <skos:altLabel>Rivet Joining</skos:altLabel>
        <skos:definition>A process where two or more materials are joined together using a rivet, a
            non-removable mechanical fastener, to create a strong, permanent assembly.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/RoboticWeldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/RoboticWeldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermalWeldingCapability"/>
        <rdfs:label>Robotic Welding</rdfs:label>
        <skos:definition>A process where industrial robots perform automated welding operations to
            achieve consistent quality, high productivity, and precision in mass production.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/RollBondingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/RollBondingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermoformingCapability"/>
        <rdfs:label>Roll Bonding</rdfs:label>
        <skos:definition>A process where two or more metal sheets are joined by applying pressure
            and heat, causing atomic diffusion at the interface.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/RollCoatingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/RollCoatingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CoatingCapability"/>
        <rdfs:label>Roll Coating</rdfs:label>
        <skos:definition>A process where a substrate is coated by transferring a liquid film from a
            rotating roller, ensuring uniform thickness and surface coverage.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/RollDieEngravingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/RollDieEngravingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FormingCapability"/>
        <rdfs:label>Roll Die Engraving</rdfs:label>
        <skos:definition>A process where a hardened image is engraved onto a roll die to imprint
            patterns or designs onto a material during production.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/RollForgingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/RollForgingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ForgingCapability"/>
        <rdfs:label>Roll Forging</rdfs:label>
        <skos:definition>A process that involves continuously hammering a long, heated metal piece
            between two cylindrical or semi-cylindrical rolls to reduce its thickness.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/RollFormingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/RollFormingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FormingCapability"/>
        <rdfs:label>Roll Forming</rdfs:label>
        <skos:definition>A process where metal strips are continuously bent into a specified
            cross-sectional profile through a series of roll stands.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/RollerFormingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/RollerFormingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FormingCapability"/>
        <rdfs:label>Roller Forming</rdfs:label>
        <skos:definition>A process where rollers progressively shape metal sheets or strips by
            applying pressure, enhancing material properties and achieving precise dimensional
            tolerances.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/RollingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/RollingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FormingCapability"/>
        <rdfs:label>Rolling</rdfs:label>
        <skos:definition>A process that reduces the thickness of a long workpiece by compressive
            forces applied through a set of rolls.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/RotaryBroachingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/RotaryBroachingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/BroachingCapability"/>
        <rdfs:label>Rotary Broaching</rdfs:label>
        <skos:definition>A process where a specially designed tool is rotated and pressed into a
            workpiece to cut complex shapes like hexagonal or square holes.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/RotationalMoldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/RotationalMoldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MoldingCapability"/>
        <rdfs:label>Rotational Molding</rdfs:label>
        <skos:definition>A process where a heated hollow mold is filled with a material and then
            slowly rotated, causing the softened material to disperse and stick to the walls.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/RotomoldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/RotomoldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MoldingCapability"/>
        <rdfs:label>Rotomolding</rdfs:label>
        <skos:definition>A process where powdered plastic is heated and rotated in a mold to form
            hollow, seamless, and uniform-walled parts.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/RoutersProductCategory -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/RoutersProductCategory">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Networking%20EquipmentProductCategory"/>
        <rdfs:label xml:lang="en">Routers</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/RubberInjectionMoldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/RubberInjectionMoldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/InjectionMoldingCapability"/>
        <rdfs:label>Rubber Injection Molding</rdfs:label>
        <skos:definition>A process where heated rubber is injected into a mold under high pressure
            to produce precise, high-volume rubber parts.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/RubberProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/RubberProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ElastomerProcessingCapability"/>
        <rdfs:label xml:lang="en">Rubber</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process rubber,
            which is an elastomeric material valued for elasticity, resilience, sealing performance,
            vibration isolation, and wear resistance.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/RytonProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/RytonProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermoplasticProcessingCapability"/>
        <rdfs:label>Ryton</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process Ryton, which
            is a polyphenylene sulfide engineering thermoplastic valued for chemical resistance,
            dimensional stability, and high-temperature performance.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SanProductCategory -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SanProductCategory">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Storage%20SystemsProductCategory"/>
        <rdfs:label xml:lang="en">San</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SandBlastingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SandBlastingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SurfacePreparationCapability"/>
        <rdfs:label>Sand Blasting</rdfs:label>
        <skos:altLabel>Abrasive Blasting</skos:altLabel>
        <skos:altLabel>Sandblasting</skos:altLabel>
        <skos:definition>A process where high-speed streams of sand particles are propelled towards
            a surface to clean or etch it.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SandCastingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SandCastingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CastingCapability"/>
        <rdfs:label>Sand Casting</rdfs:label>
        <skos:altLabel>No Bake Sand Casting</skos:altLabel>
        <skos:altLabel>Sand Mold Casting</skos:altLabel>
        <skos:definition>A process where molten metal is poured into a sand mold to form complex
            metal parts through solidification.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SatellitesAndPayloadsIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SatellitesAndPayloadsIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AerospaceIndustry"/>
        <rdfs:label>Satellites and Payloads</rdfs:label>
        <skos:altLabel>Satellite Systems</skos:altLabel>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving satellites, payloads, instruments, subsystems, and related
            ground-support products used in orbital or space-based missions, and are intended to
            realize similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SawingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SawingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MultipointCuttingCapability"/>
        <rdfs:label>Sawing</rdfs:label>
        <skos:definition>A process where materials such as wood or metal are cut into specific
            dimensions using a tool with a hard, serrated edge, known as a saw.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ScannersProductCategory -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ScannersProductCategory">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Office%20EquipmentProductCategory"/>
        <rdfs:label xml:lang="en">Scanners</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ScreenPrintingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ScreenPrintingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FabricatingCapability"/>
        <rdfs:label>Screen Printing</rdfs:label>
        <skos:definition>A process where ink, paste, or functional materials are forced through a
            mesh stencil onto a surface to create patterns or coatings.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SeamWeldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SeamWeldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ElectricalResistanceWeldingCapability"/>
        <rdfs:label>Seam Welding</rdfs:label>
        <skos:definition>A process where two metal sheets are joined by continuously creating a weld
            along their touching edges using heat and pressure.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SecondaryMachining -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SecondaryMachining">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SpecializedMachiningCapability"/>
        <rdfs:label>Secondary Machining</rdfs:label>
        <skos:definition>a process where parts formed by primary processes such as casting are
            machined to achieve tighter tolerances and better surface finishes</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SelectiveLaserMeltingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SelectiveLaserMeltingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PowderDepositionCapability"/>
        <rdfs:label>Selective Laser Melting</rdfs:label>
        <skos:definition>The process is where a high-powered laser selectively melts and fuses metal
            powder, layer by layer, to create solid 3D parts.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SelectiveLaserSinteringCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SelectiveLaserSinteringCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PowderDepositionCapability"/>
        <owl:disjointWith rdf:resource="http://asu.edu/semantics/SUDOKN/StereolithographyCapability"/>
        <rdfs:label>Selective Laser Sintering</rdfs:label>
        <skos:altLabel>SLS</skos:altLabel>
        <skos:definition>The process that uses a laser to selectively fuse powdered materials, layer
            by layer, to create a solid object</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SelectiveMaskSinteringCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SelectiveMaskSinteringCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AdditiveManufacturingCapability"/>
        <rdfs:label>Selective Mask Sintering</rdfs:label>
        <skos:definition>The process uses IR light and a digitally printed optical mask to sinter or
            melt layers of plastic powder selectively.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SemiconductorEquipmentIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SemiconductorEquipmentIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SemiconductorIndustry"/>
        <rdfs:label>Semiconductor Equipment</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving process tools, metrology tools, automation systems, components, and
            support products used in semiconductor manufacturing, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SemiconductorFabricatingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SemiconductorFabricatingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FabricatingCapability"/>
        <rdfs:label>Semiconductor Fabricating</rdfs:label>
        <skos:definition>A process where integrated circuits are produced on semiconductor
            materials, involving photolithography, etching, doping, and metallization.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SemiconductorIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SemiconductorIndustry">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/supplychain/SupplyChain/Industry"/>
        <rdfs:label>Semiconductor</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving the design, manufacturing, integration, operation, maintenance,
            distribution, or support of products, systems, equipment, or services associated with
            semiconductor devices, microelectronics, fabrication, packaging, and related equipment,
            and are intended to realize similar or related primary business functions according to
            their organizational objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SemiconductorMaterialsIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SemiconductorMaterialsIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SemiconductorIndustry"/>
        <rdfs:label>Semiconductor Materials</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving wafers, chemicals, gases, photoresists, substrates, and other
            materials used in semiconductor manufacturing and packaging, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SemiconductorPackagingIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SemiconductorPackagingIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SemiconductorIndustry"/>
        <rdfs:label>Semiconductor Packaging</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving equipment, materials, substrates, components, and services used to
            package and protect semiconductor devices, and are intended to realize similar or
            related primary business functions according to their organizational objectives and
            plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SensorsAndInstrumentationIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SensorsAndInstrumentationIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ElectronicsIndustry"/>
        <rdfs:label>Sensors and Instrumentation</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving sensors, measurement devices, instruments, controls, and related
            systems used to detect, measure, monitor, or control physical phenomena, and are
            intended to realize similar or related primary business functions according to their
            organizational objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ServersProductCategory -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ServersProductCategory">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Computing%20DevicesProductCategory"/>
        <rdfs:label xml:lang="en">Servers</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ServoPressStampingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ServoPressStampingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/StampingCapability"/>
        <rdfs:label>Servo Press Stamping</rdfs:label>
        <skos:definition>A metal forming process where a servo-driven press precisely controls
            speed, position, and force to stamp sheet metal into desired shapes.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SewingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SewingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/TextileProcessCapability"/>
        <rdfs:label>Sewing</rdfs:label>
        <skos:definition>A process where fabrics or materials are joined using a needle and thread,
            either by hand or with a sewing machine.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ShapeRollingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ShapeRollingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RollingCapability"/>
        <rdfs:label>Shape Rolling</rdfs:label>
        <skos:definition>A process where metal stock passes through rollers to reduce thickness and
            alter cross-sectional profile, enhancing mechanical properties and dimensional accuracy.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ShapingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ShapingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SinglePointCuttingCapability"/>
        <rdfs:label>Shaping</rdfs:label>
        <skos:definition>A process where raw materials are manipulated, through methods such as
            cutting or forming, to create specific geometrical configurations.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ShearFormingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ShearFormingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FormingCapability"/>
        <rdfs:label>Shear Forming</rdfs:label>
        <skos:definition>A process where a rotating metal blank is incrementally deformed by a
            roller tool to reduce thickness and form conical or cylindrical shapes.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ShearSpinningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ShearSpinningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SpinningCapability"/>
        <rdfs:label>Shear Spinning</rdfs:label>
        <skos:definition>A process where a rotating metal blank is incrementally deformed over a
            mandrel using a roller, reducing thickness while maintaining diameter.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ShearingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ShearingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SheetMetalProcessingProcessingCapability"/>
        <rdfs:label>Shearing</rdfs:label>
        <skos:definition>A process where a machine or tool applies a large cutting force to a
            material, causing it to break along a straight line without forming chips or using heat.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SheetBendingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SheetBendingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/BendingCapability"/>
        <rdfs:label>Sheet Bending</rdfs:label>
        <skos:definition>A process where flat metal sheets are plastically deformed along a straight
            axis to create an angular bend, altering their geometry and structural properties.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SheetFormingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SheetFormingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FormingCapability"/>
        <rdfs:label>Sheet Forming</rdfs:label>
        <skos:definition>A process where flat metal sheets are plastically deformed into specific
            geometries using dies, punches, or rollers, maintaining material continuity and
            thickness.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SheetLaminationCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SheetLaminationCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AdditiveManufacturingCapability"/>
        <rdfs:label>Sheet Lamination</rdfs:label>
        <skos:definition>An additive manufacturing process where sheets of material are successively
            bonded together and shaped to produce a three-dimensional object layer by layer.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SheetMetalProcessingProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SheetMetalProcessingProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FormativeManufacturingCapability"/>
        <rdfs:label>Sheet Metal Processing</rdfs:label>
        <skos:altLabel>Precision sheet metal fabrication</skos:altLabel>
        <skos:altLabel>Sheet Metal</skos:altLabel>
        <skos:altLabel>Sheet Metal Fabrication</skos:altLabel>
        <skos:altLabel>Sheet Metal Work</skos:altLabel>
        <skos:definition>A process where flat sheets of metal are manipulated into specific
            geometries through operations such as cutting, bending, and assembling.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SheetMetalRollingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SheetMetalRollingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SheetRollingCapability"/>
        <rdfs:label>Sheet Metal Rolling</rdfs:label>
        <skos:definition>A process where metal sheets are passed through rollers to reduce thickness
            and achieve uniform cross-section, enhancing material properties and dimensional
            accuracy.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SheetRollingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SheetRollingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RollingCapability"/>
        <rdfs:label>Sheet Rolling</rdfs:label>
        <skos:definition>A process where metal sheets are passed through rollers to reduce thickness
            and improve uniformity, enhancing mechanical properties and surface finish.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ShellMoldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ShellMoldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CastingCapability"/>
        <rdfs:label>Shell Molding</rdfs:label>
        <skos:altLabel>Shell Mold Casting</skos:altLabel>
        <skos:definition>A process where resin-coated sand is heated and formed into a mold, which
            is then filled with molten metal to create precise castings.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ShieldedMetalArcWeldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ShieldedMetalArcWeldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ElectricArcWeldingCapability"/>
        <rdfs:label>Shielded Metal Arc Welding</rdfs:label>
        <skos:altLabel>Stick Welding</skos:altLabel>
        <skos:definition>A process where an electric current is used to join metals together using a
            flux-coated electrode, creating a shielded gas environment.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ShipbuildingIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ShipbuildingIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MarineAndShipbuildingIndustry"/>
        <rdfs:label>Shipbuilding</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving ships, ship structures, marine systems, components, equipment, and
            services used to build or repair vessels, and are intended to realize similar or related
            primary business functions according to their organizational objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ShortCycleAnnealingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ShortCycleAnnealingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RecrystallizationCapability"/>
        <rdfs:label>Short Cycle Annealing</rdfs:label>
        <skos:definition>A process where materials are heated to below their recrystallization
            temperature, then cooled rapidly to improve ductility and reduce hardness.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ShortFiberReinforcedAdditiveManufacturingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ShortFiberReinforcedAdditiveManufacturingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CompositeAdditiveManufacturingCapability"/>
        <rdfs:label>Short Fiber Reinforced Additive Manufacturing</rdfs:label>
        <skos:altLabel>Short Fiber AM</skos:altLabel>
        <skos:altLabel>Short Fiber Reinforced AM</skos:altLabel>
        <skos:definition>A composite additive manufacturing process where a feedstock containing
            short reinforcing fibers dispersed in a matrix material is deposited, fused, cured, or
            consolidated layer by layer to produce composite components.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ShotPeeningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ShotPeeningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SurfacePreparationCapability"/>
        <rdfs:label>Shot Peening</rdfs:label>
        <skos:definition>A process where small spherical shot is blasted against a surface to induce
            compressive residual stresses, enhancing fatigue strength and reducing metal failure.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ShrinkFittingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ShrinkFittingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PressFittingCapability"/>
        <rdfs:label>Shrink Fitting</rdfs:label>
        <skos:definition>A process where components are heated or cooled to alter their dimensions
            for interference fit assembly, exploiting thermal expansion or contraction.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SilicateProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SilicateProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CeramicProcessingCapability"/>
        <rdfs:label>Silicate</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process silicate
            materials, which contain silicon and oxygen and are commonly found in glasses, ceramics,
            minerals, cements, and construction materials.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SiliconCarbideProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SiliconCarbideProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CarbideProcessingCapability"/>
        <rdfs:label>Silicon Carbide</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process silicon
            carbide, which is a very hard, thermally conductive ceramic material used in abrasives,
            wear components, armor, electronics, and high-temperature applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SiliconNitrideProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SiliconNitrideProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/NitrideCeramicProcessingCapability"/>
        <rdfs:label>Silicon Nitride</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process silicon
            nitride, which is a strong, tough nitride ceramic used in bearings, cutting tools,
            engine components, and high-temperature wear applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SiliconProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SiliconProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ExoticMaterialProcessingCapability"/>
        <rdfs:label>Silicon</rdfs:label>
        <skos:altLabel>Si</skos:altLabel>
        <skos:definition>The capability of a manufacturing system or machine to process silicon,
            which is a metalloid semiconductor material used in microelectronics, photovoltaics,
            sensors, and precision components.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SiliconeRubberProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SiliconeRubberProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ElastomerProcessingCapability"/>
        <rdfs:label xml:lang="en">Silicone Rubber</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process silicone
            rubber, which is an elastomer based on silicone polymers and valued for flexibility,
            temperature resistance, chemical stability, and biocompatibility.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SilverPlatingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SilverPlatingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ElectroPlatingCapability"/>
        <rdfs:label>Silver Plating</rdfs:label>
        <skos:definition>A process where a thin layer of silver is electrochemically deposited onto
            a conductive surface to enhance conductivity, reflectivity, and corrosion resistance.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SilverProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SilverProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Non-FerrousMetalProcessingCapability"/>
        <rdfs:label>Silver</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process silver,
            which is a precious metal with very high electrical and thermal conductivity and use in
            electronics, contacts, coatings, jewelry, and medical applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SingeingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SingeingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/TextileProcessCapability"/>
        <rdfs:label>Singeing</rdfs:label>
        <skos:definition>A process where fabric surfaces are exposed to a flame or heated plates to
            remove protruding fibers, enhancing smoothness and preventing pilling.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SinglePointCuttingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SinglePointCuttingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ConventionalMachiningCapability"/>
        <rdfs:label>Single-Point Cutting</rdfs:label>
        <skos:definition>A process where a single-point cutting tool removes material from a
            workpiece to create a smooth surface or specific feature.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SinkerEDMCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SinkerEDMCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/EDMCapability"/>
        <rdfs:label>Sinker EDM</rdfs:label>
        <skos:definition>A process where electrical discharges are used to machine complex cavities
            in hardened steel by utilizing a graphite or copper electrode.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SinteringCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SinteringCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/HeatTreatingCapability"/>
        <rdfs:label>Sintering</rdfs:label>
        <skos:definition>A process where powdered material is heated to a temperature below its
            melting point to form a solid mass through atomic diffusion.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SkivingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SkivingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PlaningCapability"/>
        <rdfs:label>Skiving</rdfs:label>
        <skos:definition>A process where thin layers are shaved from a material&apos;s surface using
            a precision blade, enhancing dimensional accuracy and surface finish.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SlabMillingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SlabMillingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/HorizontalMillingCapability"/>
        <rdfs:label>Slab Milling</rdfs:label>
        <skos:definition>A process where a rotating cutting tool removes material from a workpiece
            in a direction perpendicular to its axis, producing a flat surface.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SlittingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SlittingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SheetMetalProcessingProcessingCapability"/>
        <rdfs:label>Slitting</rdfs:label>
        <skos:definition>A process where a coil of material is cut longitudinally into narrower
            strips using sharp rotary blades.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SmallDisadvantagedBusiness -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SmallDisadvantagedBusiness">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/OwnershipStatusClassifier"/>
        <rdfs:label xml:lang="en">Small Disadvantaged Business</rdfs:label>
        <skos:altLabel>8(a)</skos:altLabel>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SmallHoleDrillingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SmallHoleDrillingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/DrillingCapability"/>
        <rdfs:label>Small Hole Drilling</rdfs:label>
        <skos:definition>A process where precise, miniature holes are created in a material using
            specialized drilling machines or laser technology.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SmartInfrastructureIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SmartInfrastructureIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ConstructionAndInfrastructureIndustry"/>
        <rdfs:label>Smart Infrastructure</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving sensors, controls, communication systems, data platforms, and
            intelligent devices used to monitor and operate infrastructure assets, and are intended
            to realize similar or related primary business functions according to their
            organizational objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SoftwareProductCategory -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SoftwareProductCategory">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ProductCategoryClassifier"/>
        <rdfs:label xml:lang="en">Software</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SolarEnergyIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SolarEnergyIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/EnergyIndustry"/>
        <rdfs:label>Solar Energy</rdfs:label>
        <skos:altLabel>Solar Power</skos:altLabel>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving photovoltaic modules, solar thermal systems, inverters, mounting
            systems, materials, and support products used in solar power applications, and are
            intended to realize similar or related primary business functions according to their
            organizational objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SolderingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SolderingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermaJoiningCapability"/>
        <rdfs:label>Soldering</rdfs:label>
        <skos:definition>A process where two or more metal items are joined together by melting and
            flowing a filler metal into the joint.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SolidDepositionCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SolidDepositionCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AdditiveManufacturingCapability"/>
        <rdfs:label>Solid Deposition</rdfs:label>
        <skos:definition>The process where a substance changes directly from a gas (or vapor) phase
            into a solid phase, bypassing the liquid state.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SpaceSystemsIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SpaceSystemsIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AerospaceIndustry"/>
        <rdfs:label>Space Systems</rdfs:label>
        <skos:altLabel>Space Industry</skos:altLabel>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving spacecraft, launch vehicles, ground systems, mission systems, and
            related components and services used in space operations, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SparkPlasmaSinteringCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SparkPlasmaSinteringCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PowderMetalFormingCapability"/>
        <rdfs:label>Spark Plasma Sintering</rdfs:label>
        <skos:definition>A process where rapid, pulsed direct current creates heat, facilitating the
            consolidation and synthesis of powders into solid materials via sintering.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SpecialBusinessStatusClassifier -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SpecialBusinessStatusClassifier">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Classifier"/>
        <rdfs:label xml:lang="en">special business status classifier</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SpecializedMachiningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SpecializedMachiningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MachiningCapability"/>
        <rdfs:label>Specialized Machining</rdfs:label>
        <skos:definition>A process where specific, advanced machinery is utilized to create
            intricate parts with high precision and accuracy.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SpinCastingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SpinCastingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CastingCapability"/>
        <rdfs:label>Spin Casting</rdfs:label>
        <skos:definition>A process where molten material is poured into a rotating mold, utilizing
            centrifugal force to evenly distribute and solidify the material into a casting.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SpinFormingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SpinFormingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FormingCapability"/>
        <rdfs:label>Spin Forming</rdfs:label>
        <skos:definition>A process where a metal blank is rotated and formed over a mandrel using
            localized pressure to create axially symmetric parts.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SpinningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SpinningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SheetMetalProcessingProcessingCapability"/>
        <rdfs:label>Spinning</rdfs:label>
        <skos:altLabel>Metal Spinning</skos:altLabel>
        <skos:definition>A process where fibers are drawn out and twisted together to create yarn or
            thread, typically using a spinning wheel or industrial machinery.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SpiralFormingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SpiralFormingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FormingCapability"/>
        <rdfs:label>Spiral Forming</rdfs:label>
        <skos:definition>A process where sheet metal or strip is wound into a spiral or helical
            shape to produce tubes, ducts, springs, or structural components.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SportingGoodsIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SportingGoodsIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ConsumerProductsIndustry"/>
        <rdfs:label>Sporting Goods</rdfs:label>
        <skos:altLabel>Sports and Leisure</skos:altLabel>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving equipment, products, components, materials, and accessories used in
            sports, fitness, outdoor, and recreational activities, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SpotWeldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SpotWeldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ElectricalResistanceWeldingCapability"/>
        <rdfs:label>Spot Welding</rdfs:label>
        <skos:definition>A process where two metal surfaces are joined by applying heat and
            pressure, generated from an electrical current, at specific points.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SquareTubingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SquareTubingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/TubingCapability"/>
        <rdfs:label>Square Tubing</rdfs:label>
        <skos:altLabel>Rectangular Tubing</skos:altLabel>
        <skos:definition>A process where flat, strip steel is formed, welded, and cut into specific
            lengths to produce hollow, square-shaped tubes.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SqueezeCastingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SqueezeCastingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CastingCapability"/>
        <rdfs:label>Squeeze Casting</rdfs:label>
        <skos:definition>A process where molten metal is forced into a preheated die under high
            pressure, solidifying under pressure to produce a dense, high-strength casting.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/StainlessSteelProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/StainlessSteelProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SteelProcessingCapability"/>
        <rdfs:label xml:lang="en">Stainless Steel</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process stainless
            steel, which is steel containing chromium and often other alloying elements to provide
            corrosion resistance, strength, and cleanability.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/StampingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/StampingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SheetMetalProcessingProcessingCapability"/>
        <rdfs:label xml:lang="en">Stamping</rdfs:label>
        <skos:altLabel>Metal Stamping</skos:altLabel>
        <skos:definition>A process where a flat sheet metal is shaped by a die through pressing,
            punching, or bending operations under high pressure.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/State -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/State">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/GeopoliticalSite"/>
        <rdfs:label xml:lang="en">State</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/StateOfAddress -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/StateOfAddress">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/PhysicalLocationIdentifier"/>
        <rdfs:label xml:lang="en">state of address</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SteelProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SteelProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FerrousAlloyProcessingCapability"/>
        <rdfs:label xml:lang="en">Steel</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process steel, which
            is an iron-carbon alloy that may contain additional alloying elements and is widely used
            for structural, mechanical, tooling, and industrial applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/StelliteProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/StelliteProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CobaltAlloyProcessingCapability"/>
        <rdfs:label>Stellite</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process Stellite,
            which is a family of cobalt-chromium alloys valued for wear resistance, corrosion
            resistance, and high-temperature performance.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/StereolithographyCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/StereolithographyCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/VatPhotopolymerizationCapability"/>
        <rdfs:label>Stereolithography</rdfs:label>
        <skos:altLabel>STL</skos:altLabel>
        <skos:definition>The process uses a liquid photopolymer resin, also known as resin, which is
            cured layer by layer using a UV laser or light source.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SterilizationCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SterilizationCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FabricatingCapability"/>
        <rdfs:label>Sterilization</rdfs:label>
        <skos:definition>A process where products, tools, or materials are treated to eliminate
            microorganisms using heat, chemicals, radiation, or other methods.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/StreetAddress -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/StreetAddress">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/PhysicalLocationIdentifier"/>
        <rdfs:label xml:lang="en">street of address</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/StressRelievingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/StressRelievingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RecoveryAnnealingCapability"/>
        <rdfs:label>Stress Relieving</rdfs:label>
        <skos:definition>A process where residual stresses in a material are reduced or eliminated
            through heating, holding, and cooling operations.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/StretchBlowMoldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/StretchBlowMoldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/BlowMoldingCapability"/>
        <rdfs:label>Stretch Blow Molding</rdfs:label>
        <skos:definition>A process where preheated plastic parisons are inflated to form a hollow
            product using high-pressure air in a mold.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/StretchFormingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/StretchFormingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SheetMetalProcessingProcessingCapability"/>
        <rdfs:label>Stretch Forming</rdfs:label>
        <skos:definition>A process where a metal piece is stretched and bent simultaneously over a
            die to create contoured parts.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/StretchingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/StretchingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/EtchingCapability"/>
        <rdfs:label>Stretching</rdfs:label>
        <skos:definition>A process where material is elongated under tension to enhance mechanical
            properties, improve uniformity, and achieve specific dimensional characteristics.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/StudWeldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/StudWeldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ElectricArcWeldingCapability"/>
        <rdfs:label>Stud Welding</rdfs:label>
        <skos:altLabel>Arc Stud Welding</skos:altLabel>
        <skos:definition>A process where a metal stud is joined to a workpiece through heat
            generated from electrical resistance, creating a high-quality, load-bearing weld.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SubmergedArcWeldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SubmergedArcWeldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ElectricArcWeldingCapability"/>
        <rdfs:label>Submerged Arc Welding</rdfs:label>
        <skos:definition>A process where coalescence is produced by heating with an arc between a
            bare metal electrode and the workpiece, under a blanket of granular flux.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SuperAlloyProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SuperAlloyProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MetalProcessingCapability"/>
        <rdfs:comment>A metal alloy that is specifically engineered to maintain high mechanical
            strength, resistance to creep deformation, and resistance to oxidation or corrosion at
            elevated temperatures.</rdfs:comment>
        <rdfs:label>Super Alloy</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process superalloys,
            which are high-performance alloys engineered to maintain strength, corrosion resistance,
            oxidation resistance, and creep resistance at elevated temperatures.</skos:definition>
        <iof-av:usageNote>Do not add sub-classes under this class. Specific types of supper alloy
            capabilities (such as waspaloy, inconel, haynes, and hastelloy) are classified under
            their prime category (Alloy)</iof-av:usageNote>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SuperplasticFormingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SuperplasticFormingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FormingCapability"/>
        <rdfs:label>Superplastic Forming</rdfs:label>
        <skos:altLabel>Super Plastic Forming</skos:altLabel>
        <skos:definition>A process where metals are heated to high temperatures and formed into
            complex shapes using low-pressure gas, exploiting their superplasticity properties.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SurfaceBlastingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SurfaceBlastingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AbrasiveCleaningCapability"/>
        <rdfs:label>Surface Blasting</rdfs:label>
        <skos:definition>A process where abrasive materials are propelled against a surface to
            remove contaminants, improve texture, or prepare for coating applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SurfaceCoatingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SurfaceCoatingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CoatingCapability"/>
        <rdfs:label>Surface Coating</rdfs:label>
        <skos:definition>A process where a substrate is covered with a layer of material to enhance
            properties such as corrosion resistance, wear resistance, or aesthetics.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SurfaceFinishingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SurfaceFinishingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ManufacturingProcessCapability"/>
        <rdfs:label>Surface Finishing</rdfs:label>
        <skos:altLabel>Finishing</skos:altLabel>
        <skos:altLabel>Surface Treatment</skos:altLabel>
        <skos:altLabel>surface engineering</skos:altLabel>
        <skos:definition>A process where material surfaces are altered to obtain specific
            properties, such as smoothness, glossiness, or roughness, through techniques like
            polishing, buffing, or sanding.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SurfaceGrindingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SurfaceGrindingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/GrindingCapability"/>
        <rdfs:label>Surface Grinding</rdfs:label>
        <skos:definition>A process where a rotating grinding wheel removes material from the surface
            of a workpiece to achieve flatness, fine finishes, and precise thickness.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SurfaceHardeningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SurfaceHardeningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/HardeningCapability"/>
        <rdfs:label>Surface Hardening</rdfs:label>
        <skos:altLabel>Case Hardening</skos:altLabel>
        <skos:altLabel>Face Hardening</skos:altLabel>
        <skos:definition>A process that involves altering the properties of the surface layer of a
            metal to enhance its hardness and resistance to wear and fatigue.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SurfaceMiningIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SurfaceMiningIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MiningIndustry"/>
        <rdfs:label>Surface Mining</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving equipment, components, systems, and services used to extract
            minerals or aggregates from open-pit, strip, or surface mining operations, and are
            intended to realize similar or related primary business functions according to their
            organizational objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SurfaceMountTechnologyCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SurfaceMountTechnologyCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PCBAssemblyCapability"/>
        <rdfs:label>Surface Mount Technology</rdfs:label>
        <skos:altLabel>SMT</skos:altLabel>
        <skos:definition>A process where electronic components are placed and soldered directly onto
            the surface of printed circuit boards using automated assembly methods.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SurfacePreparationCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SurfacePreparationCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SurfaceFinishingCapability"/>
        <rdfs:label>Surface Preparation</rdfs:label>
        <skos:altLabel>Surface Cleaning</skos:altLabel>
        <skos:definition>A process where the surface of a material is cleaned, treated, or modified
            to enhance adhesion, corrosion resistance, or paint application.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SurgicalInstrumentsIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SurgicalInstrumentsIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/HealthcareAndMedicalDevicesIndustry"/>
        <rdfs:label>Surgical Instruments</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving instruments, devices, components, materials, and support products
            used in surgical procedures and operating-room environments, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SustainabilityCertificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SustainabilityCertificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Certificate"/>
        <rdfs:label>Sustainability Certificate</rdfs:label>
        <skos:definition>A certificate confirming conformance to specified sustainability,
            environmental, social responsibility, or resource stewardship requirements.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SustainablePackagingIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SustainablePackagingIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PackagingIndustry"/>
        <rdfs:label>Sustainable Packaging</rdfs:label>
        <skos:altLabel>Eco-Friendly Packaging</skos:altLabel>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving packaging materials, containers, designs, and equipment intended to
            reduce environmental impact through reuse, recycling, compostability, or reduced
            material use, and are intended to realize similar or related primary business functions
            according to their organizational objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SwaggingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SwaggingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FormingCapability"/>
        <rdfs:label>Swagging</rdfs:label>
        <skos:definition>A process that involves reducing the diameter of an object by forcing it
            through a die or forming it around a mandrel.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SwedgingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SwedgingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ForgingCapability"/>
        <rdfs:label>Swedging</rdfs:label>
        <skos:definition>A process where metal is plastically deformed using a series of rapid,
            hammer-like blows to reduce diameter or alter cross-sectional shape.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SwissMachiningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SwissMachiningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ConventionalMachiningCapability"/>
        <rdfs:label>Swiss Machining</rdfs:label>
        <skos:altLabel>Screw Machining</skos:altLabel>
        <skos:altLabel>Swiss CNC Machining</skos:altLabel>
        <skos:altLabel>Swiss Style Machining</skos:altLabel>
        <skos:altLabel>Swiss Turning</skos:altLabel>
        <skos:altLabel>Swiss Type Turning</skos:altLabel>
        <skos:altLabel>Swiss-Style Machining</skos:altLabel>
        <skos:altLabel>Swiss-Type Turning</skos:altLabel>
        <skos:definition>A process where precision parts are produced by guiding a rotating
            workpiece through a fixed, programmatically controlled cutting tool, known as Swiss
            machining.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SwitchesProductCategory -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SwitchesProductCategory">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Networking%20EquipmentProductCategory"/>
        <rdfs:label xml:lang="en">Switches</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/SyntheticFiberProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/SyntheticFiberProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FiberProcessingCapability"/>
        <rdfs:label>Synthetic Fiber</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process synthetic
            fibers, which are manufactured fibers made from polymeric materials and used in
            textiles, ropes, composites, filtration, and technical fabrics.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/TIGWeldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/TIGWeldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/GasTungstenArcWeldingCapability"/>
        <rdfs:label>TIG Welding</rdfs:label>
        <skos:altLabel>TIG</skos:altLabel>
        <skos:altLabel>TIG Weld</skos:altLabel>
        <skos:definition>A process where an electric arc forms between a non-consumable tungsten
            electrode and the workpiece, creating high-quality, precise welds.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/TL9000Certificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/TL9000Certificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/TLQualityCertificate"/>
        <rdfs:label xml:lang="en">TL 9000</rdfs:label>
        <skos:definition>A quality certificate confirming conformance to TL 9000 quality management
            requirements for the telecommunications industry.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/TLQualityCertificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/TLQualityCertificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/QualityCertificate"/>
        <rdfs:label xml:lang="en">TL Quality</rdfs:label>
        <skos:definition>A quality certificate confirming conformance to telecommunications quality
            management requirements.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/TantalumProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/TantalumProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Non-FerrousMetalProcessingCapability"/>
        <rdfs:label>Tantalum</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process tantalum,
            which is a corrosion-resistant refractory metal used in capacitors, chemical processing
            equipment, medical implants, and high-temperature applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/TappingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/TappingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/HoleMakingCapability"/>
        <rdfs:label>Tapping</rdfs:label>
        <skos:definition>A process where internal threads are cut into a pre-drilled hole using a
            specific tool known as a tap.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/TechnicalTextilesIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/TechnicalTextilesIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/TextilesAndApparelIndustry"/>
        <rdfs:label>Technical Textiles</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving textile materials, fabrics, fibers, and products engineered for
            functional, industrial, medical, protective, or structural applications, and are
            intended to realize similar or related primary business functions according to their
            organizational objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/TechtronProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/TechtronProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermoplasticProcessingCapability"/>
        <rdfs:label>Techtron</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process Techtron,
            which is a polyphenylene sulfide engineering plastic used for machined components
            requiring chemical resistance and dimensional stability.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/TeflonProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/TeflonProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermoplasticProcessingCapability"/>
        <rdfs:label>Teflon</rdfs:label>
        <skos:altLabel>PTFE</skos:altLabel>
        <skos:definition>The capability of a manufacturing system or machine to process Teflon,
            which is a fluoropolymer material valued for low friction, chemical resistance, nonstick
            behavior, and high temperature resistance.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/TelecommunicationsIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/TelecommunicationsIndustry">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/supplychain/SupplyChain/Industry"/>
        <rdfs:label>Telecommunications</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving the design, manufacturing, integration, operation, maintenance,
            distribution, or support of products, systems, equipment, or services associated with
            communication networks, infrastructure, equipment, and services, and are intended to
            realize similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/TelevisionsProductCategory -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/TelevisionsProductCategory">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Computing%20DevicesProductCategory"/>
        <rdfs:label xml:lang="en">Televisions</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/TemperingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/TemperingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RecoveryAnnealingCapability"/>
        <rdfs:label>Tempering</rdfs:label>
        <skos:definition>A process where heat-treated steel or metal is reheated to a lower
            temperature to increase toughness and reduce brittleness.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/TextileProcessCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/TextileProcessCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ManufacturingProcessCapability"/>
        <rdfs:label xml:lang="en">Textile Process</rdfs:label>
        <skos:definition>A process where raw materials are transformed into finished textile
            products through spinning, weaving, knitting, dyeing, and printing.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/TextilesAndApparelIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/TextilesAndApparelIndustry">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/supplychain/SupplyChain/Industry"/>
        <rdfs:label>Textiles and Apparel</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving the design, manufacturing, integration, operation, maintenance,
            distribution, or support of products, systems, equipment, or services associated with
            textile materials, apparel products, footwear, and related soft goods, and are intended
            to realize similar or related primary business functions according to their
            organizational objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ThermaJoiningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ThermaJoiningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/JoiningCapability"/>
        <rdfs:label>Thermal Joining</rdfs:label>
        <skos:definition>A process where materials are joined through the application of heat,
            causing fusion or coalescence, without significant deformation of the components.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ThermalCoatingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ThermalCoatingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CoatingCapability"/>
        <rdfs:label>Thermal Coating</rdfs:label>
        <skos:definition>A process where materials are coated with a thermal spray to enhance
            surface properties such as resistance to wear, heat, or corrosion.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ThermalDeburringCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ThermalDeburringCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/DeburringCapability"/>
        <rdfs:label>Thermal Deburring</rdfs:label>
        <skos:definition>A process where excess material on workpieces is removed through controlled
            thermal energy, resulting in smooth, burr-free surfaces.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ThermalSprayCoatingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ThermalSprayCoatingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermalCoatingCapability"/>
        <rdfs:label>Thermal Spray Coating</rdfs:label>
        <skos:definition>A process where a coating material is heated and sprayed onto a surface to
            improve corrosion resistance, wear resistance, and thermal insulation.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ThermalSprayingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ThermalSprayingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FlameSprayingCapability"/>
        <rdfs:label>Thermal Spraying</rdfs:label>
        <skos:definition>A process where molten or semi-molten materials are sprayed onto a surface
            to form a protective or functional coating.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ThermalSubtractionCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ThermalSubtractionCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/UnconventionalMachiningCapability"/>
        <rdfs:label>Thermal Subtraction</rdfs:label>
        <skos:definition>A process where heat is applied to remove material layers, altering the
            physical properties and dimensions of the workpiece.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ThermalWeldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ThermalWeldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermaJoiningCapability"/>
        <rdfs:label>Thermal Welding</rdfs:label>
        <skos:definition>A process where heat is applied to join materials, typically metals or
            thermoplastics, by melting the parts and adding a filler material to form a weld pool.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ThermoformingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ThermoformingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FormingCapability"/>
        <rdfs:label>Thermoforming</rdfs:label>
        <skos:definition>A process where a plastic sheet is heated to a pliable forming temperature,
            formed to a specific shape in a mold, and trimmed to create a usable product.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ThermoplasticProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ThermoplasticProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PlasticProcessingCapability"/>
        <rdfs:label>Thermoplastic</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process
            thermoplastic materials, which are polymers that can be repeatedly softened by heating
            and hardened by cooling without significant chemical change.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ThermosettProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ThermosettProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PlasticProcessingCapability"/>
        <rdfs:label>Thermosett</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process
            thermosetting polymers, which are polymers that undergo irreversible curing to form a
            permanently cross-linked structure with heat, chemical, or dimensional stability.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ThinWallMachiningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ThinWallMachiningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SpecializedMachiningCapability"/>
        <rdfs:label>Thin Wall Machining</rdfs:label>
        <skos:definition>A process that involves the removal of material from a workpiece to create
            components with thin walls using precise CNC machining techniques.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ThreadMillingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ThreadMillingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MillingCapability"/>
        <rdfs:label>Thread Milling</rdfs:label>
        <skos:definition>A process where a rotating cutting tool, the thread mill, is used to
            produce threads in a workpiece, typically via CNC machining.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ThreadRollingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ThreadRollingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RollingCapability"/>
        <rdfs:label>Thread Rolling</rdfs:label>
        <skos:definition>A process where threads are formed on a workpiece by plastically deforming
            material using hardened dies, enhancing strength and surface finish.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ThreadingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ThreadingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SinglePointCuttingCapability"/>
        <rdfs:label>Threading</rdfs:label>
        <skos:altLabel>Thread Cutting</skos:altLabel>
        <skos:definition>A process that involves creating helical grooves in a cylindrical surface
            or hole, typically using a tap or die.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ThroughHardeningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ThroughHardeningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/HardeningCapability"/>
        <rdfs:label>Through Hardening</rdfs:label>
        <skos:definition>A process that involves heating a steel part above its critical
            temperature, then rapidly cooling it, to increase hardness throughout the entire piece.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/Ti-6Al-4V-ProcerssingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/Ti-6Al-4V-ProcerssingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/TitaniumAlloyProcessingCapability"/>
        <rdfs:label>Ti-6Al-4V</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process Ti-6Al-4V,
            which is a widely used titanium alloy containing aluminum and vanadium and valued for
            high strength-to-weight ratio, corrosion resistance, and biocompatibility.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/TinPlatingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/TinPlatingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ElectroPlatingCapability"/>
        <rdfs:label>Tin Plating</rdfs:label>
        <skos:definition>A process where a thin layer of tin is electrochemically deposited onto a
            metal substrate to enhance corrosion resistance, solderability, and aesthetic appeal.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/TitaniumAlloyProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/TitaniumAlloyProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Non-FerrousAlloyProcessingCapability"/>
        <rdfs:label>Titanium Alloy</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process titanium
            alloys, which are lightweight, high-strength, corrosion-resistant alloys used in
            aerospace, medical, marine, and high-performance industrial applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/TitaniumProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/TitaniumProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Non-FerrousMetalProcessingCapability"/>
        <rdfs:label xml:lang="en">Titanium</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process titanium,
            which is a lightweight, strong, corrosion-resistant metal used in aerospace, medical,
            marine, and chemical processing applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ToolAndDieIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ToolAndDieIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/IndustrialMachineryAndEquipmentIndustry"/>
        <rdfs:label>Tool and Die</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving tools, dies, molds, fixtures, jigs, gauges, and related products
            used to produce or support manufactured parts, and are intended to realize similar or
            related primary business functions according to their organizational objectives and
            plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ToolDesignCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ToolDesignCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/EngineeringCapability"/>
        <rdfs:label>tool design capability</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ToolMakingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ToolMakingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ManufacturedProductFamilyCapability"/>
        <rdfs:label xml:lang="en">Tool Making</rdfs:label>
        <skos:definition>A process that involves designing, creating, and maintaining specialized
            tools used in manufacturing and production operations.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ToolSteelProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ToolSteelProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SteelProcessingCapability"/>
        <rdfs:label>Tool Steel</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process tool steel,
            which is high-hardness steel formulated for cutting tools, dies, molds, gauges, and
            wear-resistant tooling applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/TorchBrazingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/TorchBrazingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/BrazingCapability"/>
        <rdfs:label>Torch Brazing</rdfs:label>
        <skos:definition>A process where a torch is used to melt filler metal, creating a joint
            between two base materials without melting them.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/TorchCuttingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/TorchCuttingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermalSubtractionCapability"/>
        <rdfs:label>Torch Cutting</rdfs:label>
        <skos:definition>A process where a high-temperature flame, typically from an oxy-fuel torch,
            is used to sever, trim, or pierce metal materials.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/TorchSolderingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/TorchSolderingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SolderingCapability"/>
        <rdfs:label>Torch Soldering</rdfs:label>
        <skos:definition>A process where a torch generates heat to melt solder, creating a joint
            between two metal surfaces, typically in electronics or plumbing.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/TorlonProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/TorlonProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermoplasticProcessingCapability"/>
        <rdfs:label>Torlon</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process Torlon,
            which is a polyamide-imide high-performance thermoplastic valued for strength, wear
            resistance, and dimensional stability at elevated temperatures.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ToysAndRecreationIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ToysAndRecreationIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ConsumerProductsIndustry"/>
        <rdfs:label>Toys and Recreation</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving toys, games, recreational products, components, materials, and
            accessories intended for play or leisure activities, and are intended to realize similar
            or related primary business functions according to their organizational objectives and
            plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/TransferMoldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/TransferMoldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MoldingCapability"/>
        <rdfs:label>Transfer Molding</rdfs:label>
        <skos:definition>A process where pre-measured material is heated and pressurized into a mold
            cavity, solidifying to form a part upon cooling.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/TransferPressStampingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/TransferPressStampingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/StampingCapability"/>
        <rdfs:label>Transfer Press Stamping</rdfs:label>
        <skos:definition>An efficient manufacturing process used to craft medium to high volumes of
            metal components</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/TrepanningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/TrepanningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/DeepHoleDrillingCapability"/>
        <rdfs:label>Trepanning</rdfs:label>
        <skos:definition>A process where a rotating hollow cutter removes a core from a workpiece,
            creating large-diameter holes with minimal material waste.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/TubeBendingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/TubeBendingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/BendingCapability"/>
        <rdfs:label>Tube Bending</rdfs:label>
        <skos:definition>A process that involves deforming metal tubes into specific angles and
            radii using dedicated machinery and tooling.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/TubeDrawingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/TubeDrawingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/DrawingCapability"/>
        <rdfs:label>Tube Drawing</rdfs:label>
        <skos:definition>A process where a tube is reduced in diameter and/or wall thickness by
            pulling it through a die, enhancing its mechanical properties.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/TubingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/TubingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FormingCapability"/>
        <rdfs:label>Tubing</rdfs:label>
        <skos:definition>Tubing is a manufacturing operation used to create hollow cylindrical
            structures (tubes) with controlled dimensions and mechanical properties, typically from
            metal, plastic, or composite materials.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/TuffakProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/TuffakProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermoplasticProcessingCapability"/>
        <rdfs:label>Tuffak</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process Tuffak,
            which is a polycarbonate sheet material valued for impact resistance, optical clarity,
            and durable transparent applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/TuftingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/TuftingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SpinningCapability"/>
        <rdfs:label>Tufting</rdfs:label>
        <skos:definition>A process where yarns are inserted into a backing material using needles to
            create pile surfaces, commonly employed in carpet and textile production.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/TumbleFinishingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/TumbleFinishingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SurfaceFinishingCapability"/>
        <rdfs:label>Tumble Finishing</rdfs:label>
        <skos:definition>A process where parts are placed in a rotating barrel with abrasive media
            to deburr, polish, or clean surfaces through friction and impact.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/TumblingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/TumblingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AbrasiveCleaningCapability"/>
        <rdfs:label>Tumbling</rdfs:label>
        <skos:definition>A process that involves smoothing and polishing a rough surface by
            continuously turning it in a machine filled with abrasive substances.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/TungstenCarbideProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/TungstenCarbideProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CarbideProcessingCapability"/>
        <rdfs:label>Tungsten Carbide</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process tungsten
            carbide, which is an extremely hard carbide material commonly used in cutting tools,
            dies, wear parts, and tooling inserts.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/TungstenProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/TungstenProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Non-FerrousMetalProcessingCapability"/>
        <rdfs:label>Tungsten</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process tungsten,
            which is a very dense refractory metal with an extremely high melting point and use in
            electrodes, tooling, weights, and high-temperature applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/TurningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/TurningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SinglePointCuttingCapability"/>
        <rdfs:label>Turning</rdfs:label>
        <skos:altLabel>Lathe Work</skos:altLabel>
        <skos:definition>A process that involves rotating a workpiece while a single-point cutting
            tool removes material, resulting in a cylindrical shape.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/TwoDimensionalCartesianSpatialCoordinateDatum -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/TwoDimensionalCartesianSpatialCoordinateDatum">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/PhysicalLocationIdentifier"/>
        <rdfs:label>two dimensional cartesian spatial coordinate datum</rdfs:label>
        <iof-av:directSource>Common Core Ontologiesv (CCO)</iof-av:directSource>
        <iof-av:explanatoryNote>A cartesian spatial coordinate datum is a representation of a point
            in a spatial region, in which equal changes in the magnitude of a coordinate value
            denote length qualities with the same magnitude</iof-av:explanatoryNote>
        <iof-av:naturalLanguageDefinition>A cartesian spatial coordinate datum that uses two values
            to specify a position within a two-dimensional spatial region</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/UHMWProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/UHMWProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermoplasticProcessingCapability"/>
        <rdfs:label>UHMW</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process
            ultra-high-molecular-weight polyethylene, which is a tough, low-friction thermoplastic
            valued for abrasion resistance, impact resistance, and wear applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ULProductCertification -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ULProductCertification">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ProductComplianceCertificate"/>
        <rdfs:label>UL Product Certification</rdfs:label>
        <skos:altLabel>UL Listed</skos:altLabel>
        <skos:definition>A product compliance certificate confirming that a product has been
            evaluated and found to satisfy applicable UL safety requirements.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/USDAEstablishmentApproval -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/USDAEstablishmentApproval">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/RegulatoryApproval"/>
        <rdfs:comment>Regulatory authority: United States Department of Agriculture, Food Safety and Inspection Service (USDA FSIS). Typical industry: Meat, poultry, and processed egg product manufacturing.</rdfs:comment>
        <rdfs:label>USDA Establishment Approval</rdfs:label>
        <skos:altLabel>Federal Grant of Inspection</skos:altLabel>
        <skos:altLabel>USDA Grant of Inspection</skos:altLabel>
        <skos:definition>A regulatory approval issued through a federal grant of inspection by the United States Department of Agriculture Food Safety and Inspection Service authorizing an establishment to conduct specified meat, poultry, or egg-product processing operations under federal inspection.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/USPostalCode -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/USPostalCode">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/PhysicalLocationIdentifier"/>
        <rdfs:label xml:lang="en">US postal code</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/UltrasonicAdditiveManufacturingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/UltrasonicAdditiveManufacturingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SheetLaminationCapability"/>
        <rdfs:label>Ultrasonic Additive Manufacturing</rdfs:label>
        <skos:altLabel>UAM</skos:altLabel>
        <skos:altLabel>Ultrasonic Consolidation</skos:altLabel>
        <skos:definition>A sheet lamination additive manufacturing process where thin layers of
            metal foil are joined through ultrasonic welding and subsequently shaped to produce a
            three-dimensional component.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/UltrasonicCleaningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/UltrasonicCleaningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SurfacePreparationCapability"/>
        <rdfs:label>Ultrasonic Cleaning</rdfs:label>
        <skos:definition>A process where high-frequency sound waves create cavitation bubbles in a
            liquid to remove contaminants from solid surfaces.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/UltrasonicMachiningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/UltrasonicMachiningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/UnconventionalMachiningCapability"/>
        <rdfs:label>Ultrasonic Machining</rdfs:label>
        <skos:definition>A process where high-frequency ultrasonic vibrations are applied to a tool,
            removing material from a workpiece through abrasive slurry, enabling precise machining.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/UltrasonicSolderingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/UltrasonicSolderingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SolderingCapability"/>
        <rdfs:label>Ultrasonic Soldering</rdfs:label>
        <skos:definition>A process that utilizes ultrasonic vibrations to create a reliable,
            flux-free metallurgical bond between dissimilar materials in soldering operations.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/UltrasonicWeldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/UltrasonicWeldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MechanicalWeldingCapability"/>
        <rdfs:label>Ultrasonic Welding</rdfs:label>
        <skos:definition>A process that utilizes high-frequency ultrasonic acoustic vibrations to
            create solid-state welds between materials, typically plastics or lightweight metals.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/UnconventionalMachiningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/UnconventionalMachiningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MachiningCapability"/>
        <rdfs:label>Nontraditional Machining</rdfs:label>
        <skos:altLabel>Non-conventional Machining</skos:altLabel>
        <skos:altLabel>Nonconventional Machining</skos:altLabel>
        <skos:definition>A process where material removal occurs through non-traditional methods
            such as electrical, chemical, or thermal energy, without direct mechanical contact.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/UndergroundMiningIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/UndergroundMiningIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MiningIndustry"/>
        <rdfs:label>Underground Mining</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving equipment, components, systems, and services used to extract
            minerals from underground mining operations, and are intended to realize similar or
            related primary business functions according to their organizational objectives and
            plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/UnmannedAerialSystemsIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/UnmannedAerialSystemsIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AerospaceIndustry"/>
        <rdfs:label>Unmanned Aerial Systems</rdfs:label>
        <skos:altLabel>Drone Systems</skos:altLabel>
        <skos:altLabel>UAS</skos:altLabel>
        <skos:altLabel>Uncrewed Aerial Systems</skos:altLabel>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving uncrewed aircraft, drones, autonomous aerial platforms, control
            systems, payloads, and related support products, and are intended to realize similar or
            related primary business functions according to their organizational objectives and
            plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/UpsetForgingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/UpsetForgingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ForgingCapability"/>
        <rdfs:label>Upset Forging</rdfs:label>
        <skos:definition>A process where metal is heated and compressed under high pressure at one
            end to increase its diameter, known as upset forging.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/UpsettingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/UpsettingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/UpsetForgingCapability"/>
        <rdfs:label>Upsetting</rdfs:label>
        <skos:definition>A process where metal is compressed axially to increase its diameter,
            enhancing mechanical properties and forming components like bolts and fasteners.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/UpstreamOilAndGasIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/UpstreamOilAndGasIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/OilAndGasIndustry"/>
        <rdfs:label>Upstream Oil and Gas</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving equipment, components, systems, and services used in exploration,
            drilling, extraction, and production of oil and natural gas, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/UrethaneCasting -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/UrethaneCasting">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MoldingCapability"/>
        <rdfs:label>Urethane Casting</rdfs:label>
        <skos:definition>A polymer molding process where liquid polyurethane resin is cast into a
            mold and cured to produce a part.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/UrethaneProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/UrethaneProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ElastomerProcessingCapability"/>
        <rdfs:label xml:lang="en">Urethane</rdfs:label>
        <skos:altLabel>Polyurethane</skos:altLabel>
        <skos:definition>The capability of a manufacturing system or machine to process urethane
            materials, which are polyurethane-based elastomers or polymers valued for abrasion
            resistance, toughness, flexibility, and cushioning properties.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/VDA6.3Certificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/VDA6.3Certificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/VDACertificate"/>
        <rdfs:label>VDA 6.3</rdfs:label>
        <skos:definition>A quality certificate confirming conformance to VDA 6.3 process audit
            requirements.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/VDACertificate -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/VDACertificate">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/QualityCertificate"/>
        <rdfs:label>VDA</rdfs:label>
        <skos:definition>A quality certificate confirming conformance to requirements established by
            the German Association of the Automotive Industry (VDA).</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/VacuumAssistedResinTransferMoldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/VacuumAssistedResinTransferMoldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/TransferMoldingCapability"/>
        <rdfs:label>Vacuum Assisted Resin Transfer Molding</rdfs:label>
        <skos:definition>A process where resin is drawn into a sealed mold containing a dry fiber
            preform using vacuum pressure, ensuring complete saturation and void-free laminates.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/VacuumBaggingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/VacuumBaggingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CompositeManufacturingCapability"/>
        <rdfs:label>Vacuum Bagging</rdfs:label>
        <skos:definition>A composite manufacturing process where a sealed flexible bag and vacuum
            pressure are used to compact a composite layup and remove trapped air or excess resin.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/VacuumBrazingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/VacuumBrazingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/BrazingCapability"/>
        <rdfs:label>Vacuum Brazing</rdfs:label>
        <skos:definition>A process where metals are joined at high temperatures in a vacuum
            environment to prevent oxidation and maintain material properties.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/VacuumCastingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/VacuumCastingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CastingCapability"/>
        <rdfs:label>Vacuum Casting</rdfs:label>
        <skos:definition>A process where a vacuum is used to draw liquid material into a mold,
            ensuring precise replication of the mold&apos;s shape and details.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/VacuumFormingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/VacuumFormingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FormingCapability"/>
        <rdfs:label>Vacuum Forming</rdfs:label>
        <skos:definition>A process where a heated thermoplastic sheet is shaped over a mold by
            applying vacuum pressure, creating detailed, uniform components.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/VacuumHardeningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/VacuumHardeningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SurfaceHardeningCapability"/>
        <rdfs:label>Vacuum Hardening</rdfs:label>
        <skos:definition>A process where materials are heated in a vacuum environment and rapidly
            cooled to increase hardness and mechanical strength.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/VacuumInfusionProcessCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/VacuumInfusionProcessCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CompositeManufacturingCapability"/>
        <rdfs:label>Vacuum Infusion Process</rdfs:label>
        <skos:altLabel>VIP</skos:altLabel>
        <skos:definition>A composite manufacturing process where vacuum pressure draws liquid resin
            through a dry fiber preform enclosed within a sealed bag or mold.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/VacuumMoldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/VacuumMoldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MoldingCapability"/>
        <rdfs:label>Vacuum Molding</rdfs:label>
        <skos:definition>A process where a sheet of plastic is heated to a forming temperature,
            stretched onto a single-surface mold, and forced against the mold by a vacuum.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/VacuumPackagingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/VacuumPackagingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PackingCapability"/>
        <rdfs:label>Vacuum Packaging</rdfs:label>
        <skos:altLabel>Vacuum Packing</skos:altLabel>
        <skos:definition>A process where products are enclosed in airtight packaging under vacuum
            conditions to prevent oxidation, spoilage, and extend shelf life.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/VacuumPressingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/VacuumPressingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FormingCapability"/>
        <rdfs:label>Vacuum Pressing</rdfs:label>
        <skos:definition>A process where materials are compressed and bonded under vacuum pressure,
            typically using heat and adhesive to form laminated or veneered products.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/VacuumThermoformingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/VacuumThermoformingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermoformingCapability"/>
        <rdfs:label>Vacuum Thermoforming</rdfs:label>
        <skos:definition>A process where a plastic sheet is heated to a pliable forming temperature,
            then shaped by a mold under vacuum pressure.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/VaporDepositionCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/VaporDepositionCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/VaporizedMetalCoatingCapability"/>
        <rdfs:label>Vapor Deposition</rdfs:label>
        <skos:definition>A process where material is deposited onto a substrate in vapor form,
            forming a thin film through chemical or physical reactions.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/VaporizedMetalCoatingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/VaporizedMetalCoatingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermalCoatingCapability"/>
        <rdfs:label>Vaporized Metal Coating</rdfs:label>
        <skos:altLabel>Vacuum Metalizing</skos:altLabel>
        <skos:altLabel>Vapor Metalizing</skos:altLabel>
        <skos:definition>A process where a metal is vaporized and condensed onto a substrate,
            forming a thin, uniform coating for enhanced surface properties.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/VatPhotopolymerizationCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/VatPhotopolymerizationCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AdditiveManufacturingCapability"/>
        <rdfs:label>Vat Photopolymerization</rdfs:label>
        <skos:definition>An additive manufacturing process where liquid photopolymer material
            contained in a vat is selectively cured by light energy to produce a three-dimensional
            object layer by layer</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/VehiclesProductCategory -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/VehiclesProductCategory">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ProductCategoryClassifier"/>
        <rdfs:label xml:lang="en">Vehicles</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/VerticalBoringCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/VerticalBoringCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/BoringCapability"/>
        <rdfs:label>Vertical Boring</rdfs:label>
        <skos:definition>A process where a rotating tool bores holes in a workpiece vertically,
            utilizing a vertical lathe or vertical boring mill.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/VerticalMillingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/VerticalMillingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/MillingCapability"/>
        <rdfs:label>Vertical Milling</rdfs:label>
        <skos:altLabel>Vertical Mill</skos:altLabel>
        <skos:definition>A process where a rotating cutting tool removes material from a workpiece
            in a vertically oriented spindle in a milling machine.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/VespelProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/VespelProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermosettProcessingCapability"/>
        <rdfs:label>Vespel</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process Vespel,
            which is a high-performance polyimide material valued for high temperature resistance,
            wear resistance, low outgassing, and dimensional stability.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/VeteranOwned -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/VeteranOwned">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/OwnershipStatusClassifier"/>
        <rdfs:label xml:lang="en">Veteran Owned</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/VibratoryDeburringCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/VibratoryDeburringCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/DeburringCapability"/>
        <rdfs:label>Vibratory Deburring</rdfs:label>
        <skos:definition>A process where high-frequency vibrations are used to remove burrs and
            imperfections from manufactured metal parts.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/VibratoryFinishingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/VibratoryFinishingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SurfaceFinishingCapability"/>
        <rdfs:label>Vibratory Finishing</rdfs:label>
        <skos:definition>A process where parts are deburred, polished, or cleaned by vibrating them
            with abrasive media in a specially designed container.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/VibratoryTumblingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/VibratoryTumblingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/TumblingCapability"/>
        <rdfs:label>Vibratory Tumbling</rdfs:label>
        <skos:definition>A process where parts are polished or deburred by placing them in a
            vibrating container with abrasive media, facilitating surface refinement.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/VirtualLocationIdentifier -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/VirtualLocationIdentifier">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/Identifier"/>
        <rdfs:label xml:lang="en">virtual location identifier</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/WaferFabricationIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/WaferFabricationIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SemiconductorIndustry"/>
        <rdfs:label>Wafer Fabrication</rdfs:label>
        <skos:altLabel>Fab</skos:altLabel>
        <skos:altLabel>Semiconductor Fabrication</skos:altLabel>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving equipment, materials, systems, facilities, and services used to
            fabricate semiconductor wafers and integrated circuits, and are intended to realize
            similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/WaspaloyProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/WaspaloyProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/NickelAlloyProcessingCapability"/>
        <rdfs:label>Waspaloy</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process Waspaloy,
            which is a nickel-based superalloy valued for high-temperature strength, oxidation
            resistance, and use in gas turbine and aerospace components.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/WaterAndWastewaterInfrastructureIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/WaterAndWastewaterInfrastructureIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ConstructionAndInfrastructureIndustry"/>
        <rdfs:label>Water and Wastewater Infrastructure</rdfs:label>
        <skos:altLabel>Water and Sewer Utilities</skos:altLabel>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving equipment, systems, materials, and services used in water supply,
            wastewater collection, treatment, and distribution infrastructure, and are intended to
            realize similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/WaterQuenchHardeningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/WaterQuenchHardeningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThroughHardeningCapability"/>
        <rdfs:label>Water Quench Hardening</rdfs:label>
        <skos:definition>A process where heated metal parts are rapidly cooled in water, increasing
            hardness and strength through the formation of martensite.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/WaterjetCuttingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/WaterjetCuttingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ErosionMachiningCapability"/>
        <rdfs:label>Waterjet Cutting</rdfs:label>
        <skos:altLabel>Abrassive Waterjet Machining</skos:altLabel>
        <skos:altLabel>Water Jet Cutting</skos:altLabel>
        <skos:altLabel>Water Jet Machining</skos:altLabel>
        <skos:definition>A process where high-pressure water, often mixed with abrasives, is used to
            cut through materials with precision and without heat-induced distortion.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/WaveSolderingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/WaveSolderingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SolderingCapability"/>
        <rdfs:label>Wave Soldering</rdfs:label>
        <skos:definition>A process where electronic components are soldered onto a PCB using a
            molten solder wave, ensuring efficient and uniform connections.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/WeaponsSystemsIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/WeaponsSystemsIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/DefenseIndustry"/>
        <rdfs:label>Weapons Systems</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving weapons, munitions, fire-control systems, launch systems,
            components, and support products used for defense applications, and are intended to
            realize similar or related primary business functions according to their organizational
            objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/WeavingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/WeavingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/TextileProcessCapability"/>
        <rdfs:label xml:lang="en">Weaving</rdfs:label>
        <skos:definition>A process that interlaces two sets of yarns at right angles to generate a
            fabric or textile, typically executed on a loom.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/WebAddress -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/WebAddress">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/VirtualLocationIdentifier"/>
        <rdfs:label xml:lang="en">web address</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/WetPaintingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/WetPaintingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PrintingCapability"/>
        <rdfs:label>Wet Painting</rdfs:label>
        <skos:definition>A process where a liquid paint is applied to a surface and cured, providing
            a protective or decorative layer on the manufactured product.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/WhiteCastIronProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/WhiteCastIronProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CastIronProcessingCapability"/>
        <rdfs:label>White Cast Iron</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process white cast
            iron, which is hard, wear-resistant cast iron with carbon present largely as iron
            carbide rather than graphite.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/WindEnergyIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/WindEnergyIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/EnergyIndustry"/>
        <rdfs:label>Wind Energy</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving turbines, blades, towers, drivetrains, controls, foundations, and
            support products used in wind power applications, and are intended to realize similar or
            related primary business functions according to their organizational objectives and
            plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/WireArcAdditiveManufacturingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/WireArcAdditiveManufacturingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/DirectedEnergyDepositionCapability"/>
        <rdfs:label>Wire Arc Additive Manufacturing</rdfs:label>
        <skos:definition>A directed energy deposition process where an electric arc melts metallic
            wire feedstock to build components layer by layer.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/WireBendingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/WireBendingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/BendingCapability"/>
        <rdfs:label>Wire Bending</rdfs:label>
        <skos:definition>A process where a machine or tool precisely deforms a wire into specific
            geometric configurations based on predefined specifications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/WireDrawingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/WireDrawingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/DrawingCapability"/>
        <rdfs:label>Wire Drawing</rdfs:label>
        <skos:definition>A process where a metal wire is reduced in diameter by pulling it through a
            series of dies under tension.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/WireEDMCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/WireEDMCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/EDMCapability"/>
        <rdfs:label>Wire EDM</rdfs:label>
        <skos:altLabel>Wire EDM Cutting</skos:altLabel>
        <skos:altLabel>Wire Electrical Discharge Machining</skos:altLabel>
        <skos:altLabel>Wire-EDM</skos:altLabel>
        <skos:definition>A process that utilizes electrical discharges to cut intricate shapes or
            profiles into hard conductive materials with high precision.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/WireFormingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/WireFormingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FormingCapability"/>
        <rdfs:label>Wire Forming</rdfs:label>
        <skos:definition>A process where metal wire or strip is bent, cut, and shaped using
            specialized machinery to produce components with precise geometries and dimensions.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/WireHarnessAssemblyCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/WireHarnessAssemblyCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ManufacturedProductFamilyCapability"/>
        <rdfs:label>Wire Harness Assembly</rdfs:label>
        <skos:definition>A process where individual wires, cables, and subassemblies are arranged,
            bound together, and fitted with connectors to form a wire harness.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/WirelessCommunicationsIndustry -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/WirelessCommunicationsIndustry">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/TelecommunicationsIndustry"/>
        <rdfs:label>Wireless Communications</rdfs:label>
        <skos:definition>A group of organizations that participate in similar or related business
            processes involving equipment, components, systems, antennas, devices, and
            infrastructure used for wireless communication networks and services, and are intended
            to realize similar or related primary business functions according to their
            organizational objectives and plans.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/WomanOwned -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/WomanOwned">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/OwnershipStatusClassifier"/>
        <rdfs:label xml:lang="en">Woman Owned</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/WomenOwned -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/WomenOwned">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/OwnershipStatusClassifier"/>
        <rdfs:label xml:lang="en">Women Owned</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/WoodProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/WoodProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CompositeProcessingCapability"/>
        <rdfs:label xml:lang="en">Wood</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process wood
            materials, which are natural lignocellulosic materials used in structural, furniture,
            tooling, packaging, and consumer product applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/WoodWorkingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/WoodWorkingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ManufacturingProcessCapability"/>
        <rdfs:label xml:lang="en">Wood Working</rdfs:label>
        <skos:altLabel>Wood Processing</skos:altLabel>
        <skos:definition>A process that involves cutting, shaping, and assembling wood to construct
            products such as furniture, cabinetry, and sculptures.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/WorkstationsProductCategory -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/WorkstationsProductCategory">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Computing%20DevicesProductCategory"/>
        <rdfs:label xml:lang="en">Workstations</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/WroughtAluminumAlloyProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/WroughtAluminumAlloyProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AluminumAlloyProcessingCapability"/>
        <rdfs:label>Wrought Aluminum Alloy</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process wrought
            aluminum alloys, which are aluminum alloys mechanically worked by rolling, extrusion,
            forging, or drawing to achieve useful shapes and properties.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ZAMAKAlloyProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ZAMAKAlloyProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ZincAlloyProcessingCapability"/>
        <rdfs:label>ZAMAK Alloy</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process ZAMAK alloy,
            which is a family of zinc-aluminum-magnesium-copper alloys commonly used in die casting
            for precise and durable components.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ZeluxProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ZeluxProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermoplasticProcessingCapability"/>
        <rdfs:label>Zelux</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process Zelux, which
            is a polycarbonate engineering plastic used for machined components requiring toughness,
            impact resistance, and dimensional stability.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ZeroStockMachiningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ZeroStockMachiningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SpecializedMachiningCapability"/>
        <rdfs:label>Zero Stock Machining</rdfs:label>
        <skos:altLabel>Negative Stock Machining</skos:altLabel>
        <skos:altLabel>Net Shape Machining</skos:altLabel>
        <skos:altLabel>ZSM</skos:altLabel>
        <skos:definition>A process where parts are produced on-demand, directly from raw materials,
            eliminating the need for inventory storage.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ZincAlloyProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ZincAlloyProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Non-FerrousAlloyProcessingCapability"/>
        <rdfs:label xml:lang="en">Zinc Alloy</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process zinc alloys,
            which are non-ferrous alloys valued for die castability, dimensional accuracy, corrosion
            resistance, and use in hardware, housings, and consumer products.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ZincPlatingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ZincPlatingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ElectroPlatingCapability"/>
        <rdfs:label>Zinc Plating</rdfs:label>
        <skos:definition>A process where a layer of zinc is electrochemically applied to a metal
            surface to provide corrosion resistance and enhance aesthetic appeal.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ZirconProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ZirconProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/SilicateProcessingCapability"/>
        <rdfs:label>Zircon</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process zircon,
            which is a zirconium silicate mineral used in ceramics, refractories, foundry sands, and
            high-temperature applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ZirconiumProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ZirconiumProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/Non-FerrousMetalProcessingCapability"/>
        <rdfs:label>Zirconium</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process zirconium,
            which is a corrosion-resistant metal used in nuclear, chemical processing, and
            high-performance industrial applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/ZytelProcessingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/ZytelProcessingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ThermoplasticProcessingCapability"/>
        <rdfs:label>Zytel</rdfs:label>
        <skos:definition>The capability of a manufacturing system or machine to process Zytel, which
            is a nylon-based engineering thermoplastic valued for toughness, strength, wear
            resistance, and molded component applications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/binderjettingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/binderjettingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/AdditiveManufacturingCapability"/>
        <rdfs:label>Binder Jetting</rdfs:label>
        <skos:definition>A process where a liquid binding agent selectively deposits onto a powder
            bed, layer by layer, to create solid parts from powdered materials.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN//OrganizationSize -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN//OrganizationSize">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:label xml:lang="en">organization size</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/5-AxisMachiningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/5-AxisMachiningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CNCMachiningCapability"/>
        <owl:disjointWith rdf:resource="http://asu.edu/semantics/SUDOKN/7-AxisMachiningCapability"/>
        <rdfs:label>Five Axis Machining</rdfs:label>
        <skos:altLabel>5 Axis Machining</skos:altLabel>
        <skos:altLabel>5-Axis Machining</skos:altLabel>
        <skos:definition>A process where a workpiece is operated on using three linear axes and two
            rotational axes simultaneously for precise and complex machining.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/7-AxisMachiningCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/7-AxisMachiningCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/CNCMachiningCapability"/>
        <rdfs:label>Seven Axis Machining</rdfs:label>
        <skos:altLabel>7 Axis Machining</skos:altLabel>
        <skos:altLabel>7-Axis Machining</skos:altLabel>
        <skos:definition>A process that utilizes a machine tool with seven independent axes of
            movement to precisely cut material into specific dimensions and finishes.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/Accelerator%20CardsProductCategory -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/Accelerator%20CardsProductCategory">
