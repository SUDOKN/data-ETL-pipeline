    </owl:ObjectProperty>
    


    <!-- http://asu.edu/semantics/SUDOKN/hasMaterialCapability -->

    <owl:ObjectProperty rdf:about="http://asu.edu/semantics/SUDOKN/hasMaterialCapability">
