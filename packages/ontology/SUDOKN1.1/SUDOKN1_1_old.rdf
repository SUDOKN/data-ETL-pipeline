     -->

    


    <!-- http://asu.edu/semantics/SUDOKN/CityOf -->

    <owl:ObjectProperty rdf:about="http://asu.edu/semantics/SUDOKN/CityOf">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000124"/>
        <owl:inverseOf rdf:resource="http://asu.edu/semantics/SUDOKN/locatedInCity"/>
        <rdfs:label>city of</rdfs:label>
        <iof-av:naturalLanguageDefinition>relationship between a city and a geospatial site when the city is the location of the site</iof-av:naturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- http://asu.edu/semantics/SUDOKN/attestsTo -->

    <owl:ObjectProperty rdf:about="http://asu.edu/semantics/SUDOKN/attestsTo">
        <rdfs:domain rdf:resource="http://asu.edu/semantics/SUDOKN/Certificate"/>
        <rdfs:range rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/Capability"/>
        <rdfs:label xml:lang="en">attests to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://asu.edu/semantics/SUDOKN/classifiedByProductCategory -->

    <owl:ObjectProperty rdf:about="http://asu.edu/semantics/SUDOKN/classifiedByProductCategory">
        <rdfs:domain rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/MaterialProduct"/>
        <rdfs:range rdf:resource="http://asu.edu/semantics/SUDOKN/ProductCategoryClassifier"/>
        <rdfs:label xml:lang="en">classified by product category</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://asu.edu/semantics/SUDOKN/countryOf -->

    <owl:ObjectProperty rdf:about="http://asu.edu/semantics/SUDOKN/countryOf">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000124"/>
        <owl:inverseOf rdf:resource="http://asu.edu/semantics/SUDOKN/locatedInCountry"/>
        <rdfs:label>country of</rdfs:label>
        <iof-av:naturalLanguageDefinition>relationship between a country and a geospatial site when the country is the location of the site</iof-av:naturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- http://asu.edu/semantics/SUDOKN/countyOf -->

    <owl:ObjectProperty rdf:about="http://asu.edu/semantics/SUDOKN/countyOf">
        <owl:inverseOf rdf:resource="http://asu.edu/semantics/SUDOKN/locatedInCounty"/>
    </owl:ObjectProperty>
    


    <!-- http://asu.edu/semantics/SUDOKN/hasBusinessDescription -->

    <owl:ObjectProperty rdf:about="http://asu.edu/semantics/SUDOKN/hasBusinessDescription">
        <rdfs:domain rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/Organization"/>
        <rdfs:range rdf:resource="http://asu.edu/semantics/SUDOKN/BusinessDescription"/>
        <rdfs:label xml:lang="en">has business description</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://asu.edu/semantics/SUDOKN/hasCertificate -->

    <owl:ObjectProperty rdf:about="http://asu.edu/semantics/SUDOKN/hasCertificate">
