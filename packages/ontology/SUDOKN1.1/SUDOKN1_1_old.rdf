        <rdfs:label xml:lang="en">has name</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://asu.edu/semantics/SUDOKN/hasOwnershipStatusClassifier -->

    <owl:ObjectProperty rdf:about="http://asu.edu/semantics/SUDOKN/hasOwnershipStatusClassifier">
        <rdfs:domain rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/Organization"/>
