        <rdfs:label xml:lang="en">Modems</rdfs:label>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MoldDesignCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MoldDesignCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ToolDesignCapability"/>
