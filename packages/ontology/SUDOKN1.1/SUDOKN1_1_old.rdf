        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/PrintingCapability"/>
        <rdfs:label>Wet Painting</rdfs:label>
        <skos:definition>A process where a liquid paint is applied to a surface and cured, providing a protective or decorative layer on the manufactured product.</skos:definition>
    </owl:Class>
    


