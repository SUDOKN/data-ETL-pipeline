    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MoldMakingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MoldMakingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ToolMakingCapability"/>
        <rdfs:label>Mold Making</rdfs:label>
        <skos:definition>A process where a hollow container is created to form materials into specific dimensions and designs through casting or injection molding techniques.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/MoldingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/MoldingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/ManufacturingProcessCapability"/>
        <rdfs:label xml:lang="en">Molding</rdfs:label>
        <skos:altLabel>Moulding</skos:altLabel>
        <skos:definition>A process that involves shaping a pliable raw material by using a rigid frame or model called a mold.</skos:definition>
    </owl:Class>
    


