    <!-- http://asu.edu/semantics/SUDOKN/WireBendingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/WireBendingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/BendingCapability"/>
        <rdfs:label>Wire Bending</rdfs:label>
        <skos:definition>A process where a machine or tool precisely deforms a wire into specific geometric configurations based on predefined specifications.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/WireDrawingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/WireDrawingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/DrawingCapability"/>
        <rdfs:label>Wire Drawing</rdfs:label>
        <skos:definition>A process where a metal wire is reduced in diameter by pulling it through a series of dies under tension.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/WireEDMCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/WireEDMCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/EDMCapability"/>
        <rdfs:label>Wire EDM</rdfs:label>
        <skos:altLabel>Wire EDM Cutting</skos:altLabel>
        <skos:altLabel>Wire Electrical Discharge Machining</skos:altLabel>
        <skos:altLabel>Wire-EDM</skos:altLabel>
        <skos:definition>A process that utilizes electrical discharges to cut intricate shapes or profiles into hard conductive materials with high precision.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/WireFormingCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/WireFormingCapability">
        <rdfs:subClassOf rdf:resource="http://asu.edu/semantics/SUDOKN/FormingCapability"/>
        <rdfs:label>Wire Forming</rdfs:label>
        <skos:definition>A process where metal wire or strip is bent, cut, and shaped using specialized machinery to produce components with precise geometries and dimensions.</skos:definition>
    </owl:Class>
    


    <!-- http://asu.edu/semantics/SUDOKN/WireHarnessAssemblyCapability -->

    <owl:Class rdf:about="http://asu.edu/semantics/SUDOKN/WireHarnessAssemblyCapability">
