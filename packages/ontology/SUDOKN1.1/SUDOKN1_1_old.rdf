        <rdfs:range rdf:resource="http://asu.edu/semantics/SUDOKN/Certificate"/>
        <rdfs:label xml:lang="en">has certificate</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://asu.edu/semantics/SUDOKN/hasEmailAddress -->

    <owl:ObjectProperty rdf:about="http://asu.edu/semantics/SUDOKN/hasEmailAddress">
        <rdfs:domain rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/Organization"/>
        <rdfs:range rdf:resource="http://asu.edu/semantics/SUDOKN/EmailAddress"/>
        <rdfs:label xml:lang="en">has email address</rdfs:label>
